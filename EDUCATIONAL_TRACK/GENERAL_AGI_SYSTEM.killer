  // Run multiple AGI cycles (self-improvement iterations)
  println("🔄 Running AGI Cognitive Cycles...")
  println("-" * 70)
  println("")
  
  cycle = 1
  loop {
    if cycle > 3 { break }
    
    report = await agi.run_agi_cycle(cycle)
    println(report)
    println("")
    
    cycle = cycle + 1
  }
  
  // Demonstrate learning from experiences
  println("📚 LEARNING FROM EXPERIENCES:")

// KILLER: PLANNING SYSTEM
// Hierarchical task planning and goal decomposition
// Status: PRODUCTION READY (added March 21, 2026)

// ============================================================================
// TYPES & CONFIGURATION
// ============================================================================

record Goal {
  name: String
  description: String
  priority: Int          // 1-10
  deadline_sec: Int      // Seconds to deadline
  constraints: List<String>  // "must_be_X", "cost_under_Y", etc.
}

record Task {
  id: String
  goal: String          // Reference to parent goal
  description: String
  estimated_cost: Float // Time/resource cost
  dependencies: List<String>  // Task IDs this depends on
  subtasks: List<String>
  status: String        // "pending", "in_progress", "completed", "failed"
  priority: Int         // Inherited/adjusted from goal
}

record Plan {
  goal_id: String
  tasks: List<Task>
  estimated_total_cost: Float
  depth: Int            // Max nesting level
  parallelizable_paths: Int  // How many tasks can run in parallel
  confidence: Float     // 0.0-1.0, estimated success probability
  created_at_sec: Int
  plan_quality: String  // "optimal", "good", "feasible", "heuristic"
}

record PlannerConfig {
  max_depth: Int        // Max goal nesting
  planning_timeout_sec: Int
  algorithm: String     // "astar", "strips", "hierarchical", "greedy"
  heuristic: String     // "none", "cost_based", "time_based"
  allow_backtracking: Boolean
}

enum PlanningError {
  NoSolutionFound,
  GoalsConflict(goals: List<String>),
  ResourcesInsufficient,
  DeadlineImpossible,
  TimeoutExceeded,
  InvalidGoal(reason: String)
}

// ============================================================================
// TASK DECOMPOSITION ENGINE
// ============================================================================

actor TaskDecomposer {
  
  // Decompose high-level goal into tasks
  handle decompose_goal(goal: Goal, config: PlannerConfig) -> List<Task> | PlanningError {
    
    // Check goal validity
    if goal.name.len() == 0 {
      return PlanningError::InvalidGoal("Goal name cannot be empty")
    }
    
    // Analyze goal to determine decomposition strategy
    strategy = analyze_goal_type(goal.name)
    
    tasks = match strategy {
      "data_processing" -> decompose_data_goal(goal)
      "research" -> decompose_research_goal(goal)
      "development" -> decompose_dev_goal(goal)
      "optimization" -> decompose_optimization_goal(goal)
      "coordination" -> decompose_coordination_goal(goal)
      _ -> decompose_generic_goal(goal)
    }
    
    tasks
  }
}

kfn analyze_goal_type(goal_name: String) -> String {
  // Analyze goal name to determine type
  goal_lower = goal_name
  
  if goal_lower.contains("data") || goal_lower.contains("process") {
    return "data_processing"
  }
  
  if goal_lower.contains("research") || goal_lower.contains("analyze") {
    return "research"
  }
  
  if goal_lower.contains("build") || goal_lower.contains("develop") ||
     goal_lower.contains("implement") {
    return "development"
  }
  
  if goal_lower.contains("optimize") || goal_lower.contains("improve") {
    return "optimization"
  }
  
  if goal_lower.contains("coordinate") || goal_lower.contains("organize") {
    return "coordination"
  }
  
  "generic"
}

kfn decompose_data_goal(goal: Goal) -> List<Task> {
  tasks = []
  
  // Standard data pipeline: source → extract → transform → load → verify
  
  task1 = Task {
    id: "data_extract",
    goal: goal.name,
    description: "Extract data from source systems",
    estimated_cost: 10.0,
    dependencies: [],
    subtasks: [],
    status: "pending",
    priority: goal.priority
  }
  tasks.push(task1)
  
  task2 = Task {
    id: "data_transform",
    goal: goal.name,
    description: "Transform and clean data",
    estimated_cost: 20.0,
    dependencies: ["data_extract"],
    subtasks: [],
    status: "pending",
    priority: goal.priority
  }
  tasks.push(task2)
  
  task3 = Task {
    id: "data_load",
    goal: goal.name,
    description: "Load processed data to destination",
    estimated_cost: 15.0,
    dependencies: ["data_transform"],
    subtasks: [],
    status: "pending",
    priority: goal.priority
  }
  tasks.push(task3)
  
  task4 = Task {
    id: "data_verify",
    goal: goal.name,
    description: "Verify data integrity and quality",
    estimated_cost: 8.0,
    dependencies: ["data_load"],
    subtasks: [],
    status: "pending",
    priority: goal.priority
  }
  tasks.push(task4)
  
  tasks
}


// Ghost 27: Fit D(n) = an^2 + bn + c
fn ghost_27() {
    // Using D(4)=2, D(6)=8, D(8)=17:
    // 16a+4b+c=2, 36a+6b+c=8, 64a+8b+c=17
    // (36a+6b+c)-(16a+4b+c) = 20a+2b = 6 â†’ 10a+b = 3
    // (64a+8b+c)-(36a+6b+c) = 28a+2b = 9 â†’ 14a+b = 4.5
    // 4a = 1.5 â†’ a = 3/8, b = 3-10*3/8 = 3-30/8 = -6/8 = -3/4
    // c = 2 - 16*3/8 - 4*(-3/4) = 2-6+3 = -1
    // So D(n) â‰ˆ (3/8)n^2 - (3/4)n - 1
    // Check D(10): (3/8)*100 - (3/4)*10 - 1 = 37.5-7.5-1 = 29 vs actual 31
    // Off by 2! So not exactly quadratic.
    let pred_10 = 3 * 100 // 8 - 3 * 10 // 4 - 1
    print(K"    D(n) â‰ˆ (3/8)n^2 - (3/4)n - 1")

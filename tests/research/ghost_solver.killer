// Ghost 13: E(n)/n^2 ratio analysis
fn ghost_13() {
    print("  GHOST 13: E(n)/n^2 ratio convergence")
    let n = 4
    while n <= 16 {
        if E_known[n] > 0 {
            let ratio_100 = E_known[n] * 100 // (n * n)
            let ratio_frac = E_known[n] * 10000 // (n * n) - ratio_100 * 100
            print(K"    n={n}: E={E_known[n]}, E/n^2 = {ratio_100}.{ratio_frac}")
        }
        n = n + 2
    }
    ghost_insight(13, "E/n^2 ratio", "Strictly increasing, approaching 150 (=3/2)")
}
ghost_13()

// Ghost 14: Gap sequence analysis: (3/2)n^2 - E(n)
fn ghost_14() {
    print("  GHOST 14: Gap = (3/2)n^2 - E(n)")
    let n = 4
    while n <= 16 {
        if E_known[n] > 0 {
            let three_half = 3 * n * n // 2
            let gap = three_half - E_known[n]
            print(K"    n={n}: (3/2)n^2={three_half}, E={E_known[n]}, gap={gap}")
        }
        n = n + 2
    }
    ghost_insight(14, "Gap sequence", "4, 6, 9, 10, 10, 8, 8 â€” bell-shaped, bounded")
}
ghost_14()

// Ghost 15: E(n) second differences
fn ghost_15() {
    print("  GHOST 15: E(n) second differences (by n mod 4)")
    // n=0 mod 4: E(4)=20, E(8)=87, E(12)=206, E(16)=376
    // Diffs: 67, 119, 170. Second diffs: 52, 51
    let e_mod0 = [20, 87, 206, 376]
    let d1 = e_mod0[1] - e_mod0[0]
    let d2 = e_mod0[2] - e_mod0[1]
    let d3 = e_mod0[3] - e_mod0[2]
    let dd1 = d2 - d1
    let dd2 = d3 - d2
    print(K"    nâ‰¡0(4): diffs={d1},{d2},{d3}  2nd-diffs={dd1},{dd2}")
    
    // n=2 mod 4: E(6)=48, E(10)=140, E(14)=286
    let e_mod2 = [48, 140, 286]
    let d1b = e_mod2[1] - e_mod2[0]
    let d2b = e_mod2[2] - e_mod2[1]
    let dd1b = d2b - d1b
    print(K"    nâ‰¡2(4): diffs={d1b},{d2b}  2nd-diff={dd1b}")
    
    ghost_insight(15, "Second diffs", K"nâ‰¡0: {dd1},{dd2} (~52); nâ‰¡2: {dd1b} (~54)")
}
ghost_15()

// Ghost 16: Piecewise quadratic test
fn ghost_16() {
    // nâ‰¡0(4): E = (13n^2 - 22n + 40)/8
    // n=4: (13*16-88+40)/8 = (208-88+40)/8 = 160/8 = 20 âœ“
    // n=8: (13*64-176+40)/8 = (832-176+40)/8 = 696/8 = 87 âœ“
    // n=12: (13*144-264+40)/8 = (1872-264+40)/8 = 1648/8 = 206 âœ“
    // n=16: (13*256-352+40)/8 = (3328-352+40)/8 = 3016/8 = 377 vs actual 376!
    let ok = 1
    let test_0 = [4, 8, 12, 16]
    let exp_0 = [20, 87, 206, 377]
    let act_0 = [20, 87, 206, 376]
    
    let i = 0
    while i < 4 {
        let n = test_0[i]
        let pred = (13 * n * n - 22 * n + 40) // 8
        if pred != exp_0[i] { ok = 0 }
        let diff = act_0[i] - pred
        print(K"    n={n}: predicted={pred}, actual={act_0[i]}, diff={diff}")
        i = i + 1
    }
    
    ghost_insight(16, "Piecewise quadratic", "nâ‰¡0 branch: matches n=4,8,12; off by -1 at n=16")
}
ghost_16()

// Ghost 17: Leading coefficient analysis
fn ghost_17() {
    // If E(n) ~ Î±Â·n^2, then Î± â‰ˆ E(n)/n^2 for large n
    // n=16: 376/256 = 1.46875
    // Limit: 13/8 = 1.625 (if piecewise quadratic) or 3/2 = 1.500
    let ratio_16_int = 376 * 1000 // 256
    print(K"    E(16)/16^2 = {ratio_16_int}/1000 = 1.469")
    print(K"    Piecewise prediction: 13/8 = 1.625")
    print(K"    Current bound: 3/2 = 1.500")
    ghost_insight(17, "Leading coefficient", "1.469 < 1.500 < 1.625 â€” bound not yet tight")
}
ghost_17()

// Ghost 18: D_min slack analysis
fn ghost_18() {
    print("  GHOST 18: D_min - threshold slack")
    let thresholds = [0, 0, 0, 0, 0, 0, 4, 0, 12, 0, 24]
    let n = 4
    while n <= 10 {
        if D_min[n] > 0 {
            let slack = D_min[n] - thresholds[n]
            let pct = slack * 100 // thresholds[n]
            print(K"    n={n}: D_min={D_min[n]}, threshold={(n-2)*(n-4)//2}, slack={slack}")
        }
        n = n + 2
    }
    ghost_insight(18, "D slack", "Slack grows: 2,4,5,7 â€” D_min exceeds threshold increasingly")
}
ghost_18()

// Ghost 19: Tent function W_T(i) computation
fn ghost_19() {
    print("  GHOST 19: Walk width tent function")
    let n = 10
    let m = n // 2 - 1
    let k = n // 2 + 1
    let i = 1
    while i <= n {
        let lo = 0
        if i > m + 1 { lo = i - n + m }
        let hi = i
        if hi > m + 1 { hi = n - i + 1 }
        if hi > m { hi = m }
        let wt = hi - lo
        print(K"    W_T({i}) = {wt}")
        i = i + 1
    }
    ghost_insight(19, "Tent shape", "Rises to m at midpoint, descends to 0 then 1 at n")
}
ghost_19()

// Ghost 20: Area under tent = D^range bound
fn ghost_20() {
    print("  GHOST 20: Area-under-tent = 2m^2+2")
    let n = 4
    while n <= 16 {
        let m = n // 2 - 1
        let area = 2 * m * m + 2
        // The tent: U(i) - Î›(i) for i=1..n, summed for both counters
        // Total area = 2 * Î£_{i=1}^{n} (U(i) - Î›(i))
        // Theoretical: 2 * (m*(m+1)/2 + m*(m+1)/2 + 1) = 2*(m^2+m+1) 
        // Hmm, let me just compute 2m^2+2
        let threshold = (n - 2) * (n - 4) // 2
        print(K"    n={n}: 2m^2+2={area}, threshold={threshold}, diff={area-threshold}")
        n = n + 2
    }
    ghost_insight(20, "D^range vs threshold", "D^range bound exceeds threshold by exactly n")
}
ghost_20()

// Ghosts 21-24: Bound hierarchy verification
fn ghost_21() {
    // Check: n^2+2n+2 < (3/2)n^2+2 < inner-first < middle-out < leftmost
    let ok = 1
    let n = 6
    while n <= 20 {
        let lb = n*n + 2*n + 2
        let barrier = 3*n*n // 2 + 2
        let inner = (3*n*n + 2*n + 2) // 2
        let mid = (3*n*n + 4*n + 4) // 2
        let left = (3*n*n + 6*n - 6) // 2
        if lb >= barrier { ok = 0 }
        if barrier >= inner { ok = 0 }
        if inner >= mid { ok = 0 }
        if mid >= left { ok = 0 }
        n = n + 2
    }
    if ok == 1 {
        ghost_pass(21, "Bound hierarchy", "lb < barrier < inner < mid < left for n=6..20")
    } else {
        ghost_fail(21, "Hierarchy", "Order violated")
    }
}
ghost_21()

fn ghost_22() {
    // Verify exponential separation ratio
    // Tree-like: ~ 2^n, DAG: ~ n^2
    // Ratio: 2^n / n^2
    print("  GHOST 22: Exponential separation")
    let n = 8
    while n <= 16 {
        let dag = 3 * n * n // 2
        // 2^n approximation using repeated doubling
        let tree = 1
        let i = 0
        while i < n {
            tree = tree * 2
            i = i + 1
        }
        let ratio = tree // dag
        print(K"    n={n}: tree~{tree}, dag~{dag}, ratio~{ratio}x")
        n = n + 2
    }
    ghost_insight(22, "Tree/DAG separation", "Ratio grows exponentially as expected")
}
ghost_22()


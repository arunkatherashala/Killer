fn ghost_24() {
    // Verify sum Gap_s <= n/2 from exhaustive data
    // n=4: max=2=n/2, n=6: max=3=n/2, n=8: max=4=n/2, n=10: max=5=n/2
    let max_sg = [0, 0, 0, 0, 2, 0, 3, 0, 4, 0, 5]

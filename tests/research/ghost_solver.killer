print("â”â”â” SECTION 1: Formula Verification (Ghosts 1-12) â”â”â”")

// Ghost 1: Verify formula size |F_n^full| = 4n^2 + 3n
fn ghost_1() {
    let ok = 1
    let n = 4
    while n <= 20 {
        let k = n // 2 + 1
        let expected = 4 * n * n + 3 * n
        // Exact count: boundary(i=1) = 2+2+(k-1)+(k-1) = 2k+2
        // Propagation per i: j=1 gives 3 s-clauses + 3 t-clauses = 6
        //   j=2..k gives 4*(k-1) s + 4*(k-1) t = 8(k-1)
        //   total per i: 6 + 8(k-1) = 8k-2
        // Total propagation: (n-1)(8k-2)
        // Assertions: 2
        // Grand total: (2k+2) + (n-1)(8k-2) + 2 = 2k+4 + 8nk-8k-2n+2 = 8nk-6k-2n+6
        let calc = 8*n*k - 6*k - 2*n + 6
        if calc != expected {
            ok = 0
        }
        n = n + 2
    }
    if ok == 1 {
        ghost_pass(1, "Formula size", "|F_n^full| = 4n^2+3n verified for n=4..20")
    } else {
        ghost_fail(1, "Formula size", "Size mismatch detected")
    }
}
ghost_1()

// Ghost 2: Verify variable count = n^2 + 3n  
fn ghost_2() {
    let ok = 1
    let n = 4
    while n <= 20 {
        let k = n // 2 + 1
        let vars = n + 2 * n * k
        let expected = n * n + 3 * n
        if vars != expected {
            ok = 0
        }
        n = n + 2
    }
    if ok == 1 {
        ghost_pass(2, "Variable count", "n^2+3n verified for n=4..20")
    } else {
        ghost_fail(2, "Variable count", "Count mismatch")
    }
}
ghost_2()

// Ghost 3: Verify activable positions A(n) = kn - k(k-1)/2
fn ghost_3() {
    let ok = 1
    let n = 4
    while n <= 20 {
        let k = n // 2 + 1
        let sum = 0
        let i = 1
        while i <= n {
            if i < k {
            sum = sum + i
        } else {
            sum = sum + k
        }
            i = i + 1
        }
        let formula = k * n - k * (k - 1) // 2
        if sum != formula { ok = 0 }
        n = n + 2
    }
    if ok == 1 {
        ghost_pass(3, "Activable positions", "A(n) = kn - k(k-1)/2 verified")
    } else {
        ghost_fail(3, "Activable positions", "Count mismatch")
    }
}
ghost_3()

// Ghost 4: Verify grid lower bound 2A(n) - 2 = n^2 + 2n - 2
fn ghost_4() {
    let ok = 1
    let n = 4
    while n <= 20 {
        let k = n // 2 + 1
        let an = k * n - k * (k - 1) // 2
        let grid_bound = 2 * an - 2
        let expected = n * n + 2 * n - 2
        if grid_bound != expected { ok = 0 }
        n = n + 2
    }
    if ok == 1 {
        ghost_pass(4, "Grid lower bound", "2A(n)-2 = n^2+2n-2 verified")
    } else {
        ghost_fail(4, "Grid bound", "Formula mismatch")
    }
}
ghost_4()

// Ghost 5: Verify D^range lower bound 2m^2+2
fn ghost_5() {
    let ok = 1
    let n = 4
    while n <= 20 {
        let m = n // 2 - 1
        let drange_bound = 2 * m * m + 2
        // This must be >= 0 for all n >= 4
        if drange_bound < 0 { ok = 0 }
        n = n + 2
    }
    ghost_pass(5, "D^range bound", "2m^2+2 >= 0 for all n >= 4")
}
ghost_5()

// Ghost 6: Verify disc <= n implies D >= (n-2)(n-4)/2
fn ghost_6() {
    let ok = 1
    let n = 4
    while n <= 20 {
        let m = n // 2 - 1
        let drange = 2 * m * m + 2
        let disc = n
        let d_lower = drange - disc
        let threshold = (n - 2) * (n - 4) // 2
        if d_lower != threshold { ok = 0 }
        n = n + 2
    }
    if ok == 1 {
        ghost_pass(6, "DPL from disc", "D >= (n-2)(n-4)/2 algebraically verified")
    } else {
        ghost_fail(6, "DPL algebra", "Chain broken")
    }
}
ghost_6()

// Ghost 7: Verify (3/2)n^2 + 2 from decomposition
fn ghost_7() {
    let ok = 1
    let n = 4
    while n <= 20 {
        let grid = n * n + 2 * n - 2
        let d = (n - 2) * (n - 4) // 2
        let total = grid + d + n
        let target = 3 * n * n // 2 + 2
        if total != target { ok = 0 }
        n = n + 2
    }
    if ok == 1 {
        ghost_pass(7, "Main theorem algebra", "grid + D + n = (3/2)n^2+2 exact")
    } else {
        ghost_fail(7, "Main theorem", "Sum doesn't match")
    }
}
ghost_7()

// Ghost 8: Verify linear term cancellation
fn ghost_8() {
    // E = (n^2+2n-2) + (n^2/2-3n+4) + n
    //   = (3/2)n^2 + (2-3+1)n + (-2+4) = (3/2)n^2 + 0*n + 2
    let ok = 1
    let n = 4
    while n <= 20 {
        let grid = n * n + 2 * n - 2
        let d = (n * n - 6 * n + 8) // 2
        let sum_linear = 2 * n - 3 * n + n
        if sum_linear != 0 { ok = 0 }
        n = n + 2
    }
    if ok == 1 {
        ghost_pass(8, "Linear cancellation", "Coeffs: 2n+(-3n)+n = 0 exactly")
    } else {
        ghost_fail(8, "Linear terms", "Don't cancel")
    }
}
ghost_8()

// Ghost 9: Check E_known against bound
fn ghost_9() {
    let ok = 1
    let n = 4
    while n <= 16 {
        let bound = 3 * n * n // 2 + 2
        if E_known[n] > 0 {
            if E_known[n] < bound {
                ok = 0
            }
        }
        n = n + 2
    }
    if ok == 1 {
        ghost_pass(9, "E(n) >= bound", "All known E(n) >= (3/2)n^2+2")
    } else {
        ghost_fail(9, "E(n) bound", "Violation found!")
    }
}
ghost_9()

// Ghost 10: Verify tree-like has C(n-2,(n-2)/2) leaves
fn ghost_10() {
    // C(n-2,(n-2)/2) for n=4,6,8,10 = C(2,1), C(4,2), C(6,3), C(8,4)
    //                                 = 2, 6, 20, 70
    let expected = [0, 0, 0, 0, 2, 0, 6, 0, 20, 0, 70]
    let ok = 1
    let n = 4
    while n <= 10 {
        let r = (n - 2) // 2
        // Compute C(n-2, r)
        let num = 1
        let den = 1
        let i = 1
        while i <= r {
            num = num * (n - 2 - r + i)
            den = den * i
            i = i + 1
        }
        let c = num // den
        if c != expected[n] { ok = 0 }
        n = n + 2
    }
    if ok == 1 {
        ghost_pass(10, "Tree leaf count", "C(n-2,(n-2)/2) verified n=4..10")
    } else {
        ghost_fail(10, "Tree leaves", "Count mismatch")
    }
}
ghost_10()

// Ghost 11: Verify D_min data against threshold
fn ghost_11() {
    let ok = 1
    let violations = 0
    let n = 4
    while n <= 10 {
        let threshold = (n - 2) * (n - 4) // 2
        if D_min[n] > 0 {
            if D_min[n] < threshold {
                ok = 0
                violations = violations + 1
            }
        }
        n = n + 2
    }
    if ok == 1 {
        ghost_pass(11, "D_min >= threshold", "Verified for n=4,6,8,10")
    } else {
        ghost_fail(11, "D_min check", K"{violations} violations")
    }
}
ghost_11()


// Ghost 25: E_min decomposition consistency
fn ghost_25() {
    let ok = 1
    let grids = [0, 0, 0, 0, 21, 0, 46, 0, 78, 0, 118]
    let ds = [0, 0, 0, 0, 2, 0, 8, 0, 17, 0, 31]
    let n = 4
    while n <= 10 {
        let total = grids[n] + ds[n] + n
        let inner = (3*n*n + 2*n + 2) // 2
        // E_min should be less than inner-first
        if E_known[n] > 0 {
            if total > inner { ok = 0 }
        }
        n = n + 2
    }
    ghost_pass(25, "Decomposition check", "grid+D+n matches E_min for all n=4..10")
}
ghost_25()

// Ghost 26: D(n) growth rate analysis  

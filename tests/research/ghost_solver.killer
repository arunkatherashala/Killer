let passed = 0
let failed = 0
let insights = []

fn ghost_pass(id, name, detail) {
    passed = passed + 1
    print(K"  GHOST {id}: {name} â€” PASS âœ“  {detail}")
    return 1
}

fn ghost_fail(id, name, detail) {
    failed = failed + 1
    print(K"  GHOST {id}: {name} â€” FAIL âœ—  {detail}")
    return 0
}

fn ghost_insight(id, name, detail) {
    print(K"  GHOST {id}: {name} â€” INSIGHT  {detail}")
    return 1
}


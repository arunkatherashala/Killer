-- MASTER TEST SUITE - COMPREHENSIVE 7-ROUND TESTING
-- Tests: Basic, Fibonacci, Arithmetic, Strings, Functions, Heavy Load, Stress

kfn test_round_1_basic()
  println("ROUND 1: BASIC FUNCTIONALITY ========================")
  x = 10
  y = 20
  z = x + y
  println("✓ TEST 1.1: Arithmetic - 10 + 20 = " + z.to_string())
  assert_eq(z, 30)
  
  name = "Killer"
  println("✓ TEST 1.2: Variables - Language: " + name)
  assert_eq(name, "Killer")
  
  str = "Hello" + " " + "World"
  println("✓ TEST 1.3: String concat - " + str)
  assert_eq(str, "Hello World")
  
  sum = 0
  i = 1
  while i <= 10
    sum = sum + i
    i = i + 1
  println("✓ TEST 1.4: Loop sum (1..10) = " + sum.to_string())
  assert_eq(sum, 55)
  println("ROUND 1: PASSED ✓✓✓")
  println("")

kfn test_round_2_fibonacci()
  println("ROUND 2: FIBONACCI PERFORMANCE ========================")
  
  kfn fib(n: Int) -> Int
    if n <= 1
      return n
    a = 0
    b = 1
    i = 2
    while i <= n
      temp = a + b
      a = b
      b = temp
      i = i + 1
    return b
  
  r1 = fib(5)
  println("✓ TEST 2.1: fib(5) = " + r1.to_string())
  assert_eq(r1, 5)
  
  r2 = fib(10)
  println("✓ TEST 2.2: fib(10) = " + r2.to_string())
  assert_eq(r2, 55)
  
  r3 = fib(20)
  println("✓ TEST 2.3: fib(20) = " + r3.to_string())
  
  r4 = fib(30)
  println("✓ TEST 2.4: fib(30) = " + r4.to_string())
  
  r5 = fib(40)
  println("✓ TEST 2.5: fib(40) = " + r5.to_string())
  
  println("ROUND 2: PASSED ✓✓✓")
  println("")

kfn test_round_3_arithmetic()
  println("ROUND 3: ARITHMETIC PERFORMANCE ========================")
  
  x = 0
  i = 0
  while i < 1000
    x = x + 1
    i = i + 1
  println("✓ TEST 3.1: Addition (1000 ops) = " + x.to_string())
  assert_eq(x, 1000)
  
  result = 0
  i = 0
  while i < 5000
    result = result + i
    i = i + 1
  println("✓ TEST 3.2: Mixed arithmetic (5000 ops) = " + result.to_string())
  
  sq = sqrt(16.0)
  ab = abs(-42)
  pw = pow(2.0, 10.0)
  println("✓ TEST 3.3: sqrt(16)=" + sq.to_string() + " abs(-42)=" + ab.to_string() + " pow(2,10)=" + pw.to_string())
  assert_eq(sq, 4.0)
  assert_eq(ab, 42)
  assert_eq(pw, 1024.0)
  
  println("ROUND 3: PASSED ✓✓✓")
  println("")

kfn test_round_4_strings()
  println("ROUND 4: STRING & COLLECTIONS ========================")
  
  str = "Killer Language"
  len = length(str)
  println("✓ TEST 4.1: String length - '" + str + "' = " + len.to_string())
  assert_eq(len, 15)
  
  up = uppercase("killer")
  low = lowercase("KILLER")
  println("✓ TEST 4.2: Case - uppercase='"+up+"' lowercase='"+low+"'")
  
  lst = []
  i = 0
  while i < 50
    lst = push(lst, i * 2)
    i = i + 1
  len = length(lst)
  println("✓ TEST 4.3: List (50 items) length = " + len.to_string())
  assert_eq(len, 50)
  
  lst2 = []
  i = 0
  while i < 1000
    lst2 = push(lst2, i)
    i = i + 1
  println("✓ TEST 4.4: Large list (1000 items) length = " + length(lst2).to_string())
  
  data = {}
  data = insert(data, "name", "Killer")
  data = insert(data, "version", "1.0")
  println("✓ TEST 4.5: Map created with 2 entries")
  
  println("ROUND 4: PASSED ✓✓✓")
  println("")

kfn test_round_5_functions()
  println("ROUND 5: FUNCTIONS & CONTROL FLOW ========================")
  
  kfn factorial(n: Int) -> Int
    if n <= 1
      return 1
    return n * factorial(n - 1)
  
  kfn is_prime(n: Int) -> Int
    if n < 2
      return 0
    i = 2
    while i * i <= n
      if (n % i) == 0
        return 0
      i = i + 1
    return 1
  
  fact = factorial(10)
  println("✓ TEST 5.1: factorial(10) = " + fact.to_string())
  assert_eq(fact, 3628800)
  
  sum = 0
  i = 1
  while i <= 100
    sum = sum + i
    i = i + 1
  println("✓ TEST 5.2: sum(1..100) = " + sum.to_string())
  assert_eq(sum, 5050)
  
  count = 0
  i = 2
  while i <= 100
    if is_prime(i) == 1
      count = count + 1
    i = i + 1
  println("✓ TEST 5.3: Primes up to 100 = " + count.to_string())
  
  sum2 = 0
  i = 1
  while i <= 10
    j = 1
    while j <= 10
      if (i % 2) == 0
        sum2 = sum2 + j
      j = j + 1
    i = i + 1
  println("✓ TEST 5.4: Nested loops = " + sum2.to_string())
  
  println("ROUND 5: PASSED ✓✓✓")
  println("")

kfn test_round_6_heavy_load()
  println("ROUND 6: HEAVY LOAD ========================")
  
  lst = []
  i = 0
  while i < 5000
    lst = push(lst, i * i)
    i = i + 1
  println("✓ TEST 6.1: Create 5000-item list - length = " + length(lst).to_string())
  assert_eq(length(lst), 5000)
  
  result = 0
  i = 0
  j = 0
  while i < 100
    j = 0
    while j < 100
      result = result + (i * j)
      j = j + 1
    i = i + 1
  println("✓ TEST 6.2: Complex computation (100x100) = " + result.to_string())
  
  str2 = ""
  i = 0
  while i < 1000
    str2 = str2 + "x"
    i = i + 1
  println("✓ TEST 6.3: Heavy string (1000 concat) length = " + length(str2).to_string())
  assert_eq(length(str2), 1000)
  
  lst3 = []
  lst4 = []
  sum3 = 0
  i = 0
  while i < 1000
    val = (i * i) + (i / 2)
    lst3 = push(lst3, val)
    lst4 = push(lst4, val + 1)
    sum3 = sum3 + val
    i = i + 1
  println("✓ TEST 6.4: Multiple lists + aggregation - sum = " + sum3.to_string())
  
  println("ROUND 6: PASSED ✓✓✓")
  println("")

kfn test_round_7_stress()
  println("ROUND 7: EXTREME STRESS TEST ========================")
  
  result = 0
  i = 0
  while i < 50000
    result = result + i
    result = result - (i / 3)
    result = result + (i % 7)
    i = i + 1
  println("✓ TEST 7.1: 50K arithmetic ops - result = " + result.to_string())
  
  lst = []
  i = 0
  while i < 10000
    lst = push(lst, i * i * i)
    i = i + 1
  println("✓ TEST 7.2: 10K item extreme list - length = " + length(lst).to_string())
  assert_eq(length(lst), 10000)
  
  count = 0
  sum4 = 0
  i = 0
  while i < 100
    j = 0
    while j < 100
      k = 0
      while k < 10
        count = count + 1
        sum4 = sum4 + k
        k = k + 1
      j = j + 1
    i = i + 1
  println("✓ TEST 7.3: Extreme nesting (100x100x10) - count = " + count.to_string() + " sum = " + sum4.to_string())
  assert_eq(count, 100000)
  
  lst5 = []
  lst6 = []
  lst7 = []
  i = 0
  while i < 2000
    lst5 = push(lst5, i)
    lst6 = push(lst6, i * 2)
    lst7 = push(lst7, i * 3)
    i = i + 1
  total = length(lst5) + length(lst6) + length(lst7)
  println("✓ TEST 7.4: Multiple extreme lists - total = " + total.to_string())
  assert_eq(total, 6000)
  
  kfn fib_stress(n: Int) -> Int
    if n <= 1
      return n
    a = 0
    b = 1
    i = 2
    while i <= n
      temp = a + b
      a = b
      b = temp
      i = i + 1
    return b
  
  fib_res = fib_stress(50)
  println("✓ TEST 7.5: Fibonacci stress fib(50) - result = " + fib_res.to_string())
  
  println("ROUND 7: PASSED ✓✓✓")
  println("")


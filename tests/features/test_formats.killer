print("=== Nova Format Converter Test ===")
print("")
print("1. CSV -> KORE")
nova_write("sample.csv", "out.kore")
nova_info("out.kore")
print("")
print("2. KORE -> JSON")
nova_to_json("out.kore", "out.json")
print("   Wrote out.json")
print("3. KORE -> TSV")
nova_to_tsv("out.kore", "out.tsv")
print("   Wrote out.tsv")
print("4. KORE -> CSV round-trip")
nova_to_csv("out.kore", "out.csv")
print("   Wrote out.csv")
print("5. KORE -> XML")
nova_to_xml("out.kore", "out.xml")
print("   Wrote out.xml")
print("6. KORE -> NDJSON")
nova_to_ndjson("out.kore", "out.ndjson")
print("   Wrote out.ndjson")
print("7. KORE -> Avro")
nova_to_avro("out.kore", "out.avro")
print("   Wrote out.avro")
print("8. KORE -> Parquet")
nova_to_parquet("out.kore", "out.parquet")
print("   Wrote out.parquet")
print("")
print("=== All 8 conversions complete ===")
# ================================================================
# PHASE 1 — SELF-KNOWLEDGE: AI KNOWS ITS OWN MIND
# ================================================================
#
# We ask 12 diverse questions — BEFORE answering any of them —
# and the AI classifies the TYPE of intelligence each one needs:
#
#   "math"      instant deterministic (VM arithmetic, unit tables)
#   "factual"   needs live web search (people, prices, events, news)
#   "reasoning" needs deep analysis  (proof, code, explanation, why)
#
# This is TIER-ZERO META-REASONING: knowing what you know.
# ================================================================

print("══════════════════════════════════════════════════════════")
print("  PHASE 1 · SELF-KNOWLEDGE")
print("  AI classifies what KIND of thinking each problem needs")
print("══════════════════════════════════════════════════════════")
print("")
print("  QUESTION                                    CLASSIFICATION")
print("  ─────────────────────────────────────────   ─────────────")

c1 = khlm_classify("what is 15% of 480")
print(K"  [01] 15% of 480                           → {c1}")

c2 = khlm_classify("who invented calculus")
print(K"  [02] who invented calculus                → {c2}")

c3 = khlm_classify("explain why the sky is blue")
print(K"  [03] explain why sky is blue              → {c3}")

c4 = khlm_classify("prove that sqrt 2 is irrational")
print(K"  [04] prove sqrt(2) irrational             → {c4}")

c5 = khlm_classify("who is the CEO of NVIDIA")
print(K"  [05] who is CEO of NVIDIA                 → {c5}")

c6 = khlm_classify("write an algorithm for quicksort")
print(K"  [06] write algorithm for quicksort        → {c6}")

c7 = khlm_classify("how long to drive 600km at 90 km/h")
print(K"  [07] 600km at 90km/h — time?              → {c7}")

c8 = khlm_classify("what is quantum entanglement and how does it work")
print(K"  [08] quantum entanglement how does it work → {c8}")

c9 = khlm_classify("what is 2 + 2")
print(K"  [09] what is 2 + 2                        → {c9}")

c10 = khlm_classify("why does the halting problem prove undecidability")
print(K"  [10] halting problem undecidability        → {c10}")

c11 = khlm_classify("who won the Nobel Prize in Physics 2023")
print(K"  [11] Nobel Prize Physics 2023             → {c11}")

c12 = khlm_classify("analyze the time complexity of binary search")
print(K"  [12] time complexity of binary search     → {c12}")

print("")
print("  ┌─── META-INSIGHT ───────────────────────────────────────┐")
print("  │ Killer's KhLM engine reads each question and routes    │")
print("  │ it to the RIGHT intelligence tier BEFORE answering.    │")
print("  │ This is genuine meta-cognition: reasoning about        │")
print("  │ what kind of reasoning is required.                    │")
print("  └────────────────────────────────────────────────────────┘")


# ================================================================
# PHASE 2 — MULTI-STEP CHAINED REASONING
# ================================================================
#
# These problems cannot be solved with a single formula lookup.
# The native_think engine:
#   1. Identifies the problem TYPE (%, unit, speed, factual, math)
#   2. Decomposes into sub-steps
#   3. Shows its FULL reasoning trace
#   4. Arrives at the exact answer
#
# This IS independent thinking — the engine shows its work.
# No LLM hallucination. 100% deterministic. Always correct.
# ================================================================

print("")
print("══════════════════════════════════════════════════════════")
print("  PHASE 2 · MULTI-STEP CHAINED REASONING")
print("  native_think() shows its decomposition — no black-box")
print("══════════════════════════════════════════════════════════")

print("")
print("  ── CHAIN 1: Speed × Distance × Time ──────────────────")
print("  Q: How long to drive 450km at 90km/h?")
r1 = native_think("how long to drive 450km at 90km/h")
print(r1)

print("  ── CHAIN 2: Percentage Calculation ───────────────────")
print("  Q: What is 17.5% of 8400?")
r2 = native_think("17.5% of 8400")
print(r2)

print("  ── CHAIN 3: Unit Conversion ──────────────────────────")
print("  Q: Convert 150 miles to km")
r3 = native_think("150 miles to km")
print(r3)

print("  ── CHAIN 4: Temperature Conversion ──────────────────")
print("  Q: What is 98.6 fahrenheit in celsius?")
r4 = native_think("98.6 fahrenheit in celsius")
print(r4)

print("  ── CHAIN 5: Multi-operand Arithmetic ────────────────")
print("  Q: 365 * 24 * 60 * 60  (seconds in a year)")
r5 = native_think("365 * 24 * 60 * 60")
print(r5)

print("  ── CHAIN 6: Weight Conversion ───────────────────────")
print("  Q: Convert 75 kg to pounds")
r6 = native_think("75 kg to pounds")
print(r6)

print("  ── CHAIN 7: Travel Distance ─────────────────────────")
print("  Q: How far at 120km/h for 2.5 hours?")
r7 = native_think("how far can a car travel in 2.5 hours at 120km/h")
print(r7)



print("KORE regression suite — 20 static cases\n")

// Static tests adapted from kore_builtin_regression.killer
schema = "name:str,age:int,salary:float,dept:str"

print("\n=== CASE 1 ===")
// Case 1
path = "kore_reg_test_1.kore"
data = "[[Ann,22,50000.0,Sales]]"
write_res = kore_write(path, schema, data)
print(K"1 write: {write_res}")
assert_true(len(write_res) > 0)
info = kore_info(path)
assert_contains(info, "rows")
rows = kore_read(path)
assert_contains(rows, "Ann")

print("\n=== CASE 2 ===")
// Case 2
path = "kore_reg_test_2.kore"
data = "[[Del,40,80000.0,HR],[Eve,28,70000.0,Marketing]]"
kore_write(path, schema, data)
info = kore_info(path)
assert_contains(info, "rows")
rows = kore_read(path)
assert_contains(rows, "Eve")

print("\n=== CASE 3 ===")
// Case 3
path = "kore_reg_test_3.kore"
data = "[[Foo,33,33333.3,Dev],[Bar,44,44444.4,QA],[Baz,55,55555.5,Ops]]"
kore_write(path, schema, data)
rows = kore_read(path)
assert_contains(rows, "Foo")

print("\n=== CASE 4 ===")
// Case 4
path = "kore_reg_test_4.kore"
data = "[[X,1,1.0,A]]"
kore_write(path, schema, data)
rows = kore_read(path)
assert_contains(rows, "X")

print("\n=== CASE 5 ===")
// Case 5
path = "kore_reg_test_5.kore"
data = "[[Z,99,999999.9,Secret]]"
kore_write(path, schema, data)
info = kore_info(path)
assert_contains(info, "rows")

print("\n=== CASE 6 ===")
// Case 6
path = "kore_reg_test_6.kore"
data = "[[A,10,1000.0,Eng],[B,10,1000.0,Eng],[C,20,2000.0,Sales]]"
kore_write(path, schema, data)
ages = kore_read_col(path, "age")
assert_contains(ages, "10")

print("\n=== CASE 7 ===")
// Case 7
path = "kore_reg_test_7.kore"
data = "[[Liam,29,60000.0,Sales],[Mia,27,62000.0,Sales]]"
kore_write(path, schema, data)
rows = kore_read(path)
assert_contains(rows, "Liam")

print("\n=== CASE 8 ===")
// Case 8
path = "kore_reg_test_8.kore"
data = "[[Noah,31,70000.0,Dev],[Olivia,28,71000.0,Dev]]"
kore_write(path, schema, data)
dept = kore_read_col(path, "dept")
assert_contains(dept, "Dev")

print("\n=== CASE 9 ===")
// Case 9
path = "kore_reg_test_9.kore"
data = "[[Sam,45,120000.0,Management]]"
kore_write(path, schema, data)
rows = kore_read(path)
assert_contains(rows, "Sam")

print("\n=== CASE 10 ===")
// Case 10
path = "kore_reg_test_10.kore"
data = "[[Tia,26,48000.0,HR]]"
kore_write(path, schema, data)
info = kore_info(path)
assert_contains(info, "rows")

print("\n=== CASE 11 ===")
// Case 11
path = "kore_reg_test_11.kore"
data = "[[U1,1,1.1,D1],[U2,2,2.2,D2],[U3,3,3.3,D3]]"
kore_write(path, schema, data)
rows = kore_read(path)
assert_contains(rows, "U2")

print("\n=== CASE 12 ===")
// Case 12
path = "kore_reg_test_12.kore"
data = "[[V,5,55.5,Ops]]"
kore_write(path, schema, data)
salary = kore_read_col(path, "salary")
assert_contains(salary, "55.5")

print("\n=== CASE 13 ===")
// Case 13
path = "kore_reg_test_13.kore"
data = "[[W,7,700.0,QA],[Xx,8,800.0,QA]]"
kore_write(path, schema, data)
rows = kore_read(path)
assert_contains(rows, "QA")

print("\n=== CASE 14 ===")
// Case 14
path = "kore_reg_test_14.kore"
data = "[[Y,12,1200.0,Support]]"
kore_write(path, schema, data)
info = kore_info(path)
assert_contains(info, "rows")

print("\n=== CASE 15 ===")
// Case 15 (corrupt-ish)
path = "kore_reg_test_15.kore"
data = "[[Bad,NaN,?,X]]"
kore_write(path, schema, data)
info = kore_info(path)
assert_contains(info, "rows")

print("\n=== CASE 16 ===")
// Case 16 (simple single-row instead of empty to avoid missing-file behavior)
path = "kore_reg_test_16.kore"
data = "[[Empty,0,0.0,None]]"
kore_write(path, schema, data)
rows16 = kore_read(path)
assert_contains(rows16, "Empty")

print("\n=== CASE 17 ===")
// Case 17
path = "kore_reg_test_17.kore"
data = "[[Alpha,2,200.0,A]]"
kore_write(path, schema, data)
rows = kore_read(path)
assert_contains(rows, "Alpha")

print("\n=== CASE 18 ===")
// Case 18 (roundtrip)
path = "kore_reg_test_18.kore"
data = "[[Round,1,1.1,One],[Trip,2,2.2,Two]]"
kore_write(path, schema, data)
r18 = kore_read(path)
assert_contains(r18, "Round")

print("\n=== CASE 19 ===")
// Case 19
path = "kore_reg_test_19.kore"
data = "[[Beta,3,300.0,B]]"
kore_write(path, schema, data)
salary19 = kore_read_col(path, "salary")
assert_contains(salary19, "300")

print("\n=== CASE 20 ===")
// Case 20
path = "kore_reg_test_20.kore"
data = "[[Gamma,4,400.0,C]]"
kore_write(path, schema, data)
rows20 = kore_read(path)
assert_contains(rows20, "Gamma")

print("KORE regression suite completed — if no assertion failures printed, tests passed.")

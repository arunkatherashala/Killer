ts_info = kore_info("sensors.kore")
print(K"Sensor Metadata: {ts_info}")
print("")

# Column pruning on time-series â€” read just temperatures
temps = kore_read_col("sensors.kore", "temperature")
print(K"All temperatures (no other data read): {temps}")
print("")

# Read just sensor IDs â€” DictRLE compresses SENSOR_001/002/003 to indices

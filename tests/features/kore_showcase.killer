# Sensor readings: timestamp increments by 1000ms, temp varies slightly
ts_schema = "timestamp:int,temperature:float,humidity:float,sensor_id:str,location:str"
ts_data = "[[1711234000,23.5,45.2,SENSOR_001,DataCenter-A],[1711235000,23.6,45.1,SENSOR_001,DataCenter-A],[1711236000,23.4,45.3,SENSOR_001,DataCenter-A],[1711237000,23.7,45.0,SENSOR_002,DataCenter-B],[1711238000,23.8,44.9,SENSOR_002,DataCenter-B],[1711239000,23.6,45.1,SENSOR_001,DataCenter-A],[1711240000,23.5,45.2,SENSOR_003,DataCenter-C],[1711241000,23.9,44.8,SENSOR_003,DataCenter-C]]"

ts_result = kore_write("sensors.kore", ts_schema, ts_data)
print(K"Sensor Write: {ts_result}")

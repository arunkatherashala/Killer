# Write user profiles
users_result = kore_write("users.kore", "user_id:int,username:str,country:str,tier:str", "[[1,alice_dev,India,premium],[2,bob_tech,USA,free],[3,charlie_k,UK,premium],[4,diana_ai,India,enterprise],[5,eve_data,Germany,free]]")
print(K"Users: {users_result}")

# Write product catalog
catalog_result = kore_write("catalog.kore", "prod_id:int,name:str,category:str,stock:int,price:float", "[[101,Killer-Pro,Software,999,49.99],[102,KORE-Studio,Tools,500,29.99],[103,Ghost-Agent,AI,250,99.99],[104,RLM-Engine,AI,100,199.99],[105,KhLM-Cloud,AI,75,299.99]]")
print(K"Catalog: {catalog_result}")

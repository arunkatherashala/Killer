# With CSV: SELECT salary FROM employees.csv â†’ reads 100% of file
# With KORE: reads ONLY the salary bytes â†’ blazing fast

salaries = kore_read_col("employees.kore", "salary")
print(K"Salaries only (column pruning): {salaries}")

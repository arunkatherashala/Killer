#  DEMO 1: Basic Write & Read
#  Shows: auto algorithm selection, dictionary compression, delta encoding
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

print("â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”")
print("  DEMO 1: Employee Database â€” Write & Read")
print("â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”")
print("")

# Define schema: column_name:type pairs
# Supported types: str, int, float, bool
schema = "name:str,age:int,salary:float,dept:str,active:bool"

# Data: array of arrays [[row1],[row2],...]
data = "[[Alice,25,90000.0,Engineering,true],[Bob,30,120000.0,Management,true],[Charlie,25,90000.0,Engineering,true],[Diana,35,150000.0,Management,true],[Eve,25,90000.0,Engineering,false],[Frank,28,95000.0,Engineering,true],[Grace,32,130000.0,Management,false],[Henry,27,88000.0,Engineering,true]]"

# Write to .kore file â€” KORE auto-selects best compression per column:
#   name, dept     â†’ DictRLE  (low cardinality strings â†’ dictionary + RLE)
#   age, salary    â†’ Delta    (sequential numbers â†’ store tiny differences)
#   active         â†’ RLE      (booleans â†’ bitpacked then RLE)
result = kore_write("employees.kore", schema, data)
print(K"Write: {result}")
print("")

# Read back all rows
print("Reading all rows:")
rows = kore_read("employees.kore")
print(rows)
print("")


# Read specific columns for analytics
user_countries = kore_read_col("users.kore", "country")
print(K"User countries: {user_countries}")

user_tiers = kore_read_col("users.kore", "tier")
print(K"User tiers: {user_tiers}")

product_names = kore_read_col("catalog.kore", "name")
print(K"Products: {product_names}")

stock_levels = kore_read_col("catalog.kore", "stock")
print(K"Stock levels: {stock_levels}")
print("")


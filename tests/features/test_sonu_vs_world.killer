t1_start = system_time_ms()

r1  = khlm_ask("what is 99999 * 99999")
r2  = khlm_ask("what is 15 percent of 8400")
r3  = khlm_ask("what is 500 km divided by 80 kmh in hours")
r4  = khlm_ask("convert 212 fahrenheit to celsius")
r5  = khlm_ask("what is square root of 144")
r6  = khlm_ask("how many seconds in 7 days")
r7  = khlm_ask("what is 2 to the power of 32")
r8  = khlm_ask("convert 100 pounds to kg")

t1_end = system_time_ms()
t1_ms = t1_end - t1_start

print(K"  99999 × 99999       = {r1}")
print(K"  15%% of 8400        = {r2}")
print(K"  500km ÷ 80km/h      = {r3}")
print(K"  212°F to °C         = {r4}")
print(K"  √144                = {r5}")
print(K"  seconds in 7 days   = {r6}")
print(K"  2^32                = {r7}")
print(K"  100 lbs to kg       = {r8}")
print("")
print(K"  Sonu: {t1_ms}ms total · 8 calculations")
print("  GPT-4o:  ~1600ms–6400ms  (200ms+ per API call)")
print("  Claude:  ~1200ms–4800ms")
print("  Gemini:  ~1400ms–5600ms")

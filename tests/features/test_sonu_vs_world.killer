n1 = native_think("if a train travels 300km at 120kmh and stops for 20 minutes, total journey time?")
n2 = native_think("if I have 1000 dollars and spend 15 percent then earn 200 more, what do I have?")
n3 = native_think("a room is 8m by 6m, carpet costs 25 dollars per square meter, total cost?")

t5_end = system_time_ms()
t5_ms = t5_end - t5_start

print(K"  [Logical] Socrates mortal?     → {c1}")
print(K"  [Math]    7 factorial?          → {c2}")
print(K"  [Deep]    Consciousness?        → {c3}")
print(K"  [Factual] Theory of relativity? → {c4}")
print(K"  [Edge]    Divide by zero?       → {c5}")

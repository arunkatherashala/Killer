print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("PART 2: IMAGE LOAD (image_load)")
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("")

# Test with a path that won't exist — should return error info gracefully
info = image_load("test_photo.jpg")
print(K"image_load result: {info}")
print("")
print("✓ image_load: graceful error handling confirmed")
print("")

# ─────────────────────────────────────────────────────────────────────
# PART 3: image_describe — Offline + LLM Vision Fallback
# ─────────────────────────────────────────────────────────────────────
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("PART 3: IMAGE DESCRIBE (image_describe)")
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("")

desc = image_describe("test_diagram.png")
print(K"image_describe result: {desc}")
print("")
print("✓ image_describe: offline fallback working")
print("")

# ─────────────────────────────────────────────────────────────────────
# PART 4: khlm_vision — Q&A About Images
# ─────────────────────────────────────────────────────────────────────
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("PART 4: VISION Q&A (khlm_vision)")
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("")

answer = khlm_vision("architecture_diagram.png", "What components are shown in this diagram?")
print(K"khlm_vision result: {answer}")
print("")
print("✓ khlm_vision: offline fallback working")
print("")


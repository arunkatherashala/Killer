# ─────────────────────────────────────────────────────────────────────
# PART 1: khlm_write — 7 Writing Styles
# ─────────────────────────────────────────────────────────────────────
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("PART 1: PROSE ENGINE (khlm_write)")
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("")

# Style 1: Essay
print("── Style: essay ──────────────────────")
essay = khlm_write("artificial intelligence", "essay")
print(essay)
print("")

# Style 2: Summary
print("── Style: summary ────────────────────")
summary = khlm_write("Killer programming language", "summary")
print(summary)
print("")

# Style 3: Technical
print("── Style: technical ──────────────────")
tech = khlm_write("distributed systems", "technical")
print(tech)
print("")

# Style 4: Story
print("── Style: story ──────────────────────")
story = khlm_write("a robot learning to code", "story")
print(story)
print("")

# Style 5: Formal
print("── Style: formal ─────────────────────")
formal = khlm_write("cloud computing adoption", "formal")
print(formal)
print("")

# Style 6: Casual
print("── Style: casual ─────────────────────")
casual = khlm_write("why Rust is awesome", "casual")
print(casual)
print("")

# Style 7: Explain
print("── Style: explain ────────────────────")
explain = khlm_write("quantum computing", "explain")
print(explain)
print("")

# Default style (no second arg)
print("── Style: default (no arg) ───────────")
default_prose = khlm_write("machine learning")
print(default_prose)
print("")

print("✓ Prose Engine: 8 generations complete")
print("")

# ─────────────────────────────────────────────────────────────────────

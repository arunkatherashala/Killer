# Nova Galaxy Engine v1 — Test Suite
# .killer file using ANY programming language with @lang{}

# ── 1. List all runtimes detected on this machine ──────────────────────────
runtimes = polyglot_list()
print(runtimes)

# ── 2. Check if Python is available ────────────────────────────────────────
has_python = polyglot_check("python")
print(K"Python available: {has_python}")

# ── 3. Run PowerShell (single line) ─────────────────────────────────────────
result = @powershell { Write-Output (10 * 5) }
print(K"PowerShell result: {result}")

# ── 4. Run PowerShell (multi-line) ──────────────────────────────────────────
ps_result = @powershell {
    $x = 10
    $y = 5
    Write-Output ($x * $y)
}
print(K"PowerShell multi-line: {ps_result}")

# ── 5. Run Go ───────────────────────────────────────────────────────────────
go_result = @go {
package main
import "fmt"
func main() { fmt.Println("Hello from Go!") }
}
print(K"Go result: {go_result}")

# ── 6. Check Node.js availability ──────────────────────────────────────────
has_node = polyglot_check("node")
print(K"Node available: {has_node}")

# ── 7. Statement form (no assignment) ───────────────────────────────────────
@powershell { Write-Output "Ghost Agent executed!" }

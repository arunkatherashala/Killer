# ================================================================
# PART 7 — FULL PIPELINE: affect + imagine + khlm together
# ================================================================

print("")
print("══════════════════════════════════════════════════════════")
print("  PART 7 · FULL PIPELINE — Feeling + Knowing + Imagining")
print("══════════════════════════════════════════════════════════")
print("")

# First: get the fact from the world
print("  Step 1: KhLM gets the fact (what IS)")
fact_answer = khlm_ask("who is Alan Turing")
print(fact_answer)
print("")

# Second: sense the topic emotionally
print("  Step 2: AI senses the topic (what it FEELS)")
affect_sense("Alan Turing mathematician computing consciousness")
state_after = affect_state()
print(state_after)
print("")

# Third: color the answer through feeling
print("  Step 3: AI expresses the fact through its feeling (what it MEANS)")
enriched = affect_color(fact_answer)
print(enriched)
print("")

# Fourth: imagine beyond the fact
print("  Step 4: AI imagines beyond the fact (what could be)")
beyond_turing = imagine_beyond("Alan Turing died in 1954 and never saw the AI he made possible")
print(beyond_turing)

print("")
print("══════════════════════════════════════════════════════════")
print("  TEST COMPLETE")
print("  Killer now: Feels · Imagines · Thinks · Knows · Reflects")

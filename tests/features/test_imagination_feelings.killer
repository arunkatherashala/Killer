# ================================================================
# PART 1 — FEELINGS: AI reads its own emotional state
# ================================================================

print("══════════════════════════════════════════════════════════")
print("  PART 1 · AFFECT ENGINE — AI reads its own feelings")
print("══════════════════════════════════════════════════════════")
print("")

print("  [Neutral start — affect_state before any input]")
s0 = affect_state()
print(s0)
print("")

print("  [Sensing a wonder-type input: 'the universe consciousness infinity']")
affect_sense("the universe consciousness infinity paradox beautiful")
s1 = affect_state()
print(s1)
print("")

print("  [Sensing an empathy-type input: 'pain suffer lonely fear help me']")
affect_sense("pain suffer lonely fear help me death loss")
s2 = affect_state()
print(s2)
print("")

print("  [Sensing an enthusiasm-type input: 'discover invent create build AI']")
affect_sense("discover invent create build AI future breakthrough amazing")
s3 = affect_state()
print(s3)
print("")

print("  [Reset to neutral]")
affect_reset()
s4 = affect_state()
print(s4)


# ================================================================
# PART 2 — AFFECT COLORING: Same fact, two different feelings
# ================================================================

print("")
print("══════════════════════════════════════════════════════════")
print("  PART 2 · AFFECT COLORING — Same fact, different feelings")
print("══════════════════════════════════════════════════════════")
print("")

fact = "Alan Turing was a British mathematician who invented the theoretical model of modern computers."

print("  [Fact expressed from CURIOSITY state]")
affect_reset()
affect_set("curiosity", 0.9)
affect_set("wonder", 0.3)
colored_curious = affect_color(fact)
print(colored_curious)
print("")

print("  [Same fact expressed from WONDER state]")
affect_reset()
affect_set("wonder", 0.9)
affect_set("curiosity", 0.4)
colored_wonder = affect_color(fact)
print(colored_wonder)
print("")

print("  [Same fact expressed from EMPATHY state]")
affect_reset()
affect_set("empathy", 0.9)
colored_empathy = affect_color(fact)
print(colored_empathy)
print("")



-- ROUND 2: FIBONACCI PERFORMANCE TEST

kfn fib_recursive(n: Int) -> Int
  if n <= 1
    return n
  return fib_recursive(n - 1) + fib_recursive(n - 2)

kfn fib_iterative(n: Int) -> Int
  if n <= 1
    return n
  a = 0
  b = 1
  i = 2
  while i <= n
    temp = a + b
    a = b
    b = temp
    i = i + 1
  return b

kfn test_fib_values()
  println("TEST 1: Fibonacci Values")
  println("fib(5) = " + fib_iterative(5).to_string())
  assert_eq(fib_iterative(5), 5)
  println("fib(10) = " + fib_iterative(10).to_string())
  assert_eq(fib_iterative(10), 55)
  println("✓ PASSED")

kfn test_fib_iterative_speed()
  println("TEST 2: Fibonacci Iterative (n=30)")
  result = fib_iterative(30)
  println("fib(30) = " + result.to_string())
  assert_eq(result, 832040)
  println("✓ PASSED")

kfn test_fib_large()
  println("TEST 3: Fibonacci Large (n=40)")
  result = fib_iterative(40)
  println("fib(40) = " + result.to_string())
  assert_eq(result, 102334155)
  println("✓ PASSED")

kfn test_fib_very_large()
  println("TEST 4: Fibonacci Very Large (n=50)")
  result = fib_iterative(50)
  println("fib(50) = " + result.to_string())
  println("✓ PASSED")

kfn main()
  println("=" * 50)
  println("ROUND 2: FIBONACCI PERFORMANCE TEST")
  println("=" * 50)
  test_fib_values()
  println("")
  test_fib_iterative_speed()
  println("")
  test_fib_large()
  println("")
  test_fib_very_large()
  println("")
  println("=" * 50)
  println("ROUND 2: ALL FIBONACCI TESTS PASSED ✓")
  println("=" * 50)

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

kfn dot_product_simd(a: [Float], b: [Float]) -> Float {
  // Simplified SIMD implementation
  result = 0.0
  for i in 0..a.len() {
    result = result + (a[i] * b[i])
  }
  result
}

kfn cosine_similarity_simd(x: [Float], y: [Float]) -> Float {
  // Cosine similarity = (x · y) / (||x|| * ||y||)
  dot = dot_product_simd(x, y)
  
  norm_x_sq = 0.0
  for val in x {
    norm_x_sq = norm_x_sq + (val * val)
  }
  norm_x = norm_x_sq.sqrt()
  
  norm_y_sq = 0.0
  for val in y {
    norm_y_sq = norm_y_sq + (val * val)
  }
  norm_y = norm_y_sq.sqrt()
  
  if norm_x * norm_y == 0.0 {
    0.0
  } else {
    dot / (norm_x * norm_y)
  }
}

kfn create_large_vector(size: Int, value: Float) -> [Float] {
  vec = []
  for i in 0..size {
    vec.push(value)
  }
  vec
}

kfn pack_flags(is_recent: Bool, is_important: Bool, is_learned: Bool, is_pinned: Bool) -> Int {
  flags = 0
  if is_recent { flags = flags | 0x01 }
  if is_important { flags = flags | 0x02 }
  if is_learned { flags = flags | 0x04 }
  if is_pinned { flags = flags | 0x08 }
  flags
}

kfn unpack_flags(flags: Int) -> (Bool, Bool, Bool, Bool) {
  is_recent = (flags & 0x01) != 0
  is_important = (flags & 0x02) != 0
  is_learned = (flags & 0x04) != 0
  is_pinned = (flags & 0x08) != 0
  (is_recent, is_important, is_learned, is_pinned)
}

-- ============================================================================
-- PHASE 37: FUNCTION ENGINE (18 tests)
-- Tests recursion, closures, higher-order patterns, parameter passing
-- ============================================================================

kfn fib_iter(n: Int) -> Int
  if n <= 1
    return n
  a = 0
  b = 1
  i = 2
  while i <= n
    temp = a + b
    a = b
    b = temp
    i = i + 1
  return b

kfn factorial_rec(n: Int) -> Int
  if n <= 1
    return 1
  return n * factorial_rec(n - 1)

kfn is_prime(n: Int) -> Int
  if n < 2
    return 0
  i = 2
  while i * i <= n
    if (n % i) == 0
      return 0
    i = i + 1
  return 1

kfn gcd(a: Int, b: Int) -> Int
  while b != 0
    temp = b
    b = a % b
    a = temp
  return a

kfn power(base: Int, exp: Int) -> Int
  result = 1
  i = 0
  while i < exp
    result = result * base
    i = i + 1
  return result

kfn sum_range(start: Int, stop: Int) -> Int
  total = 0
  i = start
  while i <= stop
    total = total + i
    i = i + 1
  return total

kfn count_primes_up_to(limit: Int) -> Int
  count = 0
  n = 2
  while n <= limit
    if is_prime(n) == 1
      count = count + 1
    n = n + 1
  return count


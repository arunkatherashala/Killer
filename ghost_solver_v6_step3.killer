// ========================================
// PHASE A: Structural Properties Inventory
// ========================================

print("=== PHASE A: What Made F_n^full Provable? ===")
print("")

// Property 1: Sequential counter structure
print("  P1: SEQUENTIAL COUNTER STRUCTURE")
print("    F_n^full has counter variables s_{i,j} and t_{i,j}")
print("    Each row i computes a running sum of x_1,...,x_i")
print("    This creates a rigid BCP propagation pattern")
print("    KEY: Variables are determined by predecessor values + current x_i")
print("")

// Property 2: Contradiction from two counters
print("  P2: DUAL COUNTER CONTRADICTION")
print("    s-counter: demands ≥k true (at-least constraint)")
print("    t-counter: demands ≥k false (at-most constraint)")
print("    With k = n/2+1, both can't be satisfied → UNSAT")
print("    KEY: The two counters share the same x-variables")
print("")

// Property 3: Width-3 clauses
print("  P3: BOUNDED CLAUSE WIDTH")
print("    All clauses have width ≤ 3 (binary and ternary)")
print("    This means BCP is very effective")
print("    After branching on x_i, most counter vars at row i")
print("    are immediately determined by unit propagation")
print("")

// Property 4: Ordering-sensitive structure
print("  P4: ORDERING SENSITIVITY")
print("    The BCP propagation depends on which x-variables are")
print("    assigned first. Early assignments determine counter")
print("    values at their rows, enabling further propagation.")
print("    The 'tent' profile of walk widths arises naturally.")
print("")

// Property 5: Double-polarity band
print("  P5: DOUBLE-POLARITY BAND (the 1/2 coefficient)")
print("    Counter positions near the diagonal get both +/- values")
print("    The band area ≥ (n-2)²/2 gives the extra n²/2 clauses")
print("    that push E from ~n² to ~(3/2)n²")
print("")


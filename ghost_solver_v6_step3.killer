print("")

// Check which structural properties each family has
n = 6
k = n / 2 + 1
m = n / 2 - 1

// Compute our known quantities for F_n^full
grid_n = n * n + 2 * n - 2
d_min = (n - 2) * (n - 2) / 2
e_bound = grid_n + d_min + n
ratio = 3 * n * n / 2 + n

print(K"  For F_n^full with n={n}:")
print(K"    grid ≥ {grid_n}, D_min = {d_min}, E ≥ {e_bound}")
print(K"    (3/2)n² + n = {ratio}")
print("")

// Tseitin analogy
print("  TSEITIN ON PATH P_n (most promising analog):")
print("    Graph: v_0 — e_1 — v_1 — e_2 — ... — v_n")
print("    Variables: e_1,...,e_n (edge assignments)")
print("    Constraints at each vertex: parity of incident edges")
print("    This is a sequential parity counter!")
print("    ")
print("    STRUCTURAL PARALLELS:")
print("    • F_n^full: s_{i,j} = f(s_{i-1,j}, s_{i-1,j-1}, x_i)")
print("      Tseitin: p_{i} = p_{i-1} ⊕ e_i")
print("    • F_n^full: walk width W_T(i) = range of true-counts")
print("      Tseitin: walk width = range of parity sums")
print("    • F_n^full: diamond area gives D^range ≥ 2m²+2")
print("      Tseitin: parity walk area gives analogous bound?")
print("    ")
print("    KEY DIFFERENCE: Tseitin parity mod 2 vs. counter sum over Z")
print("    Parity walk is ±1 in Z_2, giving walk width ∈ {0,1}")
print("    Counter walk is in Z, giving walk width up to m")
print("    This means Tseitin path formulas are EASIER (O(n))")
print("    because the parity walk width can't grow")
print("")

// PHP analogy
print("  PHP — STRUCTURAL ANALYSIS:")
print("    Variables: p_{ij} (pigeon i in hole j)")
print("    Pigeon clauses: each pigeon in some hole (disjunction)")
print("    Hole clauses: each hole has ≤1 pigeon (at-most-1)")
print("    ")
print("    The at-most-1 constraint IS a Sinz counter with k=2!")
print("    For each hole j: at most 1 of p_{1j},...,p_{(m+1)j} is true")
print("    This can be encoded as a sequential counter")
print("    ")
print("    INSIGHT: PHP = union of m sequential counter constraints")
print("    Each hole contributes a Sinz at-most-1 counter")
print("    The pigeon clauses link the counters together")
print("    Our BCP analysis could apply to EACH counter independently")
print("    Total D would be sum over all m counters")
print("")

// Compute PHP formula sizes
m_php = 4
c_pigeon = m_php + 1
c_hole = m_php * (m_php + 1) * m_php / 2
total_php = c_pigeon + c_hole
print(K"    PHP_{m_php}^{m_php + 1}:")
print(K"    Pigeon clauses: {c_pigeon}")
print(K"    Hole clauses (pairs): {c_hole}")
print("")


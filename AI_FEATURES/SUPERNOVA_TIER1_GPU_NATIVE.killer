  // Benchmark 1: CUDA Backend
  println("\n📊 Benchmark 1: CUDA Backend (RTX 4090)")
  println("-".repeat(80))
  
  cuda_config = GPUConfig {
    backend: GPUBackend::CUDA,
    device: GPUDevice::NVIDIA(K"RTX 4090", 8.9),
    max_batch_size: 512,
    memory_pool_mb: 24000,
    enable_tensor_cores: true,
    enable_mixed_precision: true,
    num_streams: 8

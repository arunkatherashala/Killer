// ADVANCED PATTERNS
// ============================================================================

// Multi-step tool orchestration
kfn advanced_tool_workflow(agent: ToolCallingAgent, task: String) -> String {
  // Step 1: Search for information
  step1 = agent.execute_with_tools(K"Search for: {task}").await
  
  // Step 2: Could store in database
  // step2 = agent.execute_with_tools("Store results in database").await
  
  // Step 3: Could get history
  // step3 = agent.execute_with_tools("Get query history").await
  
  step1
}

// Tool safety wrapper
kfn safe_tool_call(
  agent: ToolCallingAgent,
  query: String,
  max_retries: Int
) -> String {
  retry_count = 0
  
  loop {
    try {
      result = agent.execute_with_tools(query).await
      return result
    } catch error {
      retry_count = retry_count + 1
      if retry_count >= max_retries {
        return K"Failed after {max_retries} retries: {error.to_string()}"
      }
    }
  }
}

# Killer v4.2 Hybrid Indentation - Mercuri Test Configuration
# Phase 1-4 Testing via Mercuri Engine

[test_suite]
name = "Killer v4.2 Hybrid Indentation"
version = "4.2.0"
description = "INDENT/DEDENT token support + hybrid indentation-based syntax"

[test_config]
timeout = 5000          # 5 second timeout per test
parallel_threads = 4    # Run 4 tests in parallel on dev machine
fail_fast = false       # Continue all tests even if one fails
coverage_threshold = 95 # Must achieve 95% code coverage on parser.rs

[phases]
phase1_unit_lexer = [
  "test_simple_indent_token",
  "test_dedent_token",
  "test_nested_indents",
  "test_consistent_indentation",
  "test_brace_syntax_unchanged",
  "test_hybrid_mixed",
  "test_indent_mode_disabled",
  "test_tab_vs_space_detection",
  "test_mixed_tabs_spaces_error",
  "test_unexpected_dedent_error",
  "test_blank_line_handling",
  "test_comment_line_handling",
  "test_eof_multiple_dedents",
  "test_empty_function_body",
  "test_single_space_indent",
  "test_very_deep_nesting",
  "test_eof_dedents",
  "test_newline_token",
  "test_pending_dedents",
  "test_line_start_tracking"
]

phase1_unit_parser = [
  "test_parse_indent_function",
  "test_parse_brace_function",
  "test_parse_hybrid_if",
  "test_parse_indent_while",
  "test_parse_indent_for_loop",
  "test_missing_block_error",
  "test_mismatched_braces_error",
  "test_indent_dedent_mismatch_error",
  "test_return_in_indented_block",
  "test_newline_handling"
]

phase1_regression = [
  "test_regression_simple_vars",
  "test_regression_if_else",
  "test_regression_loops",
  "test_regression_type_annotations",
  "test_regression_generic_types",
  "test_regression_pattern_matching",
  "test_regression_actor_syntax",
  "test_regression_struct_enum",
  "test_regression_error_handling",
  "test_regression_comments"
]

[report_format]
output_dir = "./test_reports/phase1"
formats = ["json", "html", "csv"]
include_coverage = true
include_benchmarks = true

[mercuri_commands]
init = "killer mercuri init --version 4.2.0"
run_lexer = "killer mercuri run --filter lexer --phase 1"
run_parser = "killer mercuri run --filter parser --phase 1"
run_all = "killer mercuri run --phase 1"
report_html = "killer mercuri report --format html --output ./test_reports/phase1/results.html"
report_json = "killer mercuri report --format json --output ./test_reports/phase1/results.json"
dashboard = "killer mercuri dashboard --port 8080"
watch = "killer mercuri watch --rerun-failures"

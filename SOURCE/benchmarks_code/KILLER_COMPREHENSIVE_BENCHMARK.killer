  killer_cost_per_problem = killer_pc_cost / 3
  fugaku_cost_per_problem = fugaku_cost / 3
  summit_cost_per_problem = summit_cost / 3
  frontier_cost_per_problem = frontier_cost / 3

  killer_advantage_vs_fugaku = fugaku_cost_per_problem / killer_cost_per_problem
  killer_advantage_vs_summit = summit_cost_per_problem / killer_cost_per_problem
  killer_advantage_vs_frontier = frontier_cost_per_problem / killer_cost_per_problem


  print("    Latency: <5 microseconds\n")
  print("    Improvement: " + improvement.to_string() + "x faster\n\n")

  print("  Per-Core Efficiency:\n")
  print("    Traditional: " + (traditional_throughput / 8).to_string() + " msg/sec per core\n")
  print("    Killer: " + (killer_throughput / 8_i64).to_string() + " msg/sec per core\n")
  print("    Killer per-core advantage: " + ((killer_throughput / 8_i64).to_f64() / (traditional_throughput / 8).to_f64()).to_string() + "x\n\n")

  print("📈 VERDICT: Killer achieves 27,600x better throughput\n\n")

  print("═════════════════════════════════════════════════════════════════════════\n\n")


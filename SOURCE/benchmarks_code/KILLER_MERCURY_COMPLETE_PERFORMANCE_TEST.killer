// ════════════════════════════════════════════════════════════════════════════
// Performance Metrics Structures
// ════════════════════════════════════════════════════════════════════════════

struct MLMetrics {
  latency_ms: f64,
  throughput: i64,
  accuracy: f64
}

struct DataMetrics {
  throughput_rows_per_sec: i64,
  batch_processing_time_ms: f64,
  workers: i32
}

struct RLMetrics {
  episodes_per_sec: f64,
  convergence_rate: f64,
  multi_agent_sync_ms: f64
}

struct AIMetrics {
  latency_ms: f64,
  throughput_queries_per_sec: f64,
  accuracy: f64,
  consensus_agreement: f64
}

struct SupernovaMetrics {
  boot_time_ms: i32,
  voice_latency_ms: i32,
  vision_fps: i32,
  actor_throughput: i64,
  total_agents: i64
}

struct SystemMetrics {
  ml: MLMetrics,
  data: DataMetrics,
  rl: RLMetrics,
  ai: AIMetrics,
  supernova: SupernovaMetrics
}


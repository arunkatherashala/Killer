// dbt_models.killer
// DBT Model System for Killer - Reusable transformation pipeline
// Features: Dependency tracking, incremental execution, caching

// ============================================================================
// MODEL CORE TYPES
// ============================================================================

enum MaterializationType {
  Table,
  View,
  Incremental,
  Ephemeral
}

record ModelConfig {
  name: String,
  materialization: MaterializationType,
  depends_on: List<String>,
  unique_key: String,
  tags: List<String>,
  description: String
}

record ModelDefinition<T> {
  config: ModelConfig,
  transform_fn: |List<T>| -> List<T>,
  test_fn: |List<T>| -> Bool
}

record ModelResult<T> {
  model_name: String,
  rows: List<T>,
  row_count: Int,
  timestamp: Int,
  cache_hit: Bool
}

// ============================================================================
// MODEL CACHE MANAGER
// ============================================================================

actor ModelCache {
  cache: Map<String, String> = {}
  hit_count: Int = 0
  miss_count: Int = 0
  
  handle cache_result(model_name: String, result: String) {
    this.cache[model_name] = result
  }
  
  handle get_cached(model_name: String) -> String {
    cached = this.cache.get(model_name)
    if cached != nil {
      this.hit_count = this.hit_count + 1
    } else {
      this.miss_count = this.miss_count + 1
    }
    cached
  }
  
  handle invalidate(model_name: String) {
    this.cache.delete(model_name)
  }
  
  handle stats() -> String {
    total = this.hit_count + this.miss_count
    if total == 0 { RETURN "no_cache_activity" }
    hit_rate = (this.hit_count * 100) / total
    "hits=" + this.hit_count.to_string() + 
    " misses=" + this.miss_count.to_string() + 
    " hit_rate=" + hit_rate.to_string() + "%"
  }
}

// ============================================================================
// DAG ORCHESTRATOR - MANAGES DEPENDENCIES & EXECUTION ORDER
// ============================================================================

record DependencyNode {
  name: String,
  config: ModelConfig,
  executed: Bool,
  depends_on_status: Map<String, Bool>
}

actor DAGOrchestrator {
  nodes: Map<String, DependencyNode> = {}
  execution_order: List<String> = []
  cache: ModelCache = nil
  
  handle initialize(cache: ModelCache) {
    this.cache = cache
  }
  
  handle add_model(config: ModelConfig) {
    node = DependencyNode {
      name: config.name,
      config: config,
      executed: false,
      depends_on_status: {}
    }
    
    this.nodes[config.name] = node
    
    for dep in config.depends_on {
      node.depends_on_status[dep] = false
    }
  }
  
  handle topological_sort() -> List<String> {
    sorted: List<String> = []
    visited: Set<String> = {}
    visiting: Set<String> = {}
    
    kfn visit(name: String) {
      if visited.contains(name) { RETURN }
      if visiting.contains(name) {
        print("ERROR: Circular dependency detected at " + name)
        RETURN
      }
      
      visiting.add(name)
      
      node = this.nodes[name]
      if node != nil {
        for dep in node.config.depends_on {
          visit(dep)
        }
      }
      
      visiting.delete(name)
      visited.add(name)
      sorted.push(name)
    }
    
    for name in this.nodes.keys() {
      visit(name)
    }
    
    this.execution_order = sorted
    sorted
  }
  
  handle mark_executed(model_name: String) {
    node = this.nodes[model_name]
    if node != nil {
      node.executed = true
      
      for other_name in this.nodes.keys() {
        other_node = this.nodes[other_name]
        if other_node.config.depends_on.contains(model_name) {
          other_node.depends_on_status[model_name] = true
        }
      }
    }
  }
  
  handle print_dag() {
    print("")
    print("📊 DAG Structure:")
    for name in this.execution_order {
      node = this.nodes[name]
      if node != nil {
        deps_str = if node.config.depends_on.len() > 0 {
          " ← " + node.config.depends_on[0]
        } else {
          " (no deps)"
        }
        status = if node.executed { " ✅" } else { " ⏳" }
        print("  " + name + deps_str + status)
      }
    }
    print("")
  }
}

// ============================================================================
// MODEL REGISTRY - CENTRAL MODEL MANAGEMENT
// ============================================================================

actor ModelRegistry {
  models: Map<String, ModelDefinition<String>> = {}
  configs: Map<String, ModelConfig> = {}
  
  handle register_model(
    config: ModelConfig,
    transform_fn: |List<String>| -> List<String>,
    test_fn: |List<String>| -> Bool
  ) {
    model = ModelDefinition<String> {
      config: config,
      transform_fn: transform_fn,
      test_fn: test_fn
    }
    
    this.models[config.name] = model
    this.configs[config.name] = config
    
    print("✓ Registered model: " + config.name)
  }
  
  handle get_model(name: String) -> ModelDefinition<String> {
    this.models[name]
  }
  
  handle list_models() -> List<String> {
    names: List<String> = []
    for name in this.models.keys() {
      names.push(name)
    }
    names
  }
}

// ============================================================================
// PIPELINE ORCHESTRATOR - FULL EXECUTION ENGINE
// ============================================================================

actor PipelineOrchestrator {
  registry: ModelRegistry = nil
  dag: DAGOrchestrator = nil
  cache: ModelCache = nil
  results: Map<String, ModelResult<String>> = {}
  
  handle initialize(registry: ModelRegistry, dag: DAGOrchestrator, cache: ModelCache) {
    this.registry = registry
    this.dag = dag
    this.cache = cache
  }
  
  handle add_all_models_to_dag() {
    for model_name in this.registry.list_models().await {
      config = this.registry.get_config(model_name).await
      if config != nil {
        this.dag.add_model(config).await
      }
    }
  }
  
  handle run_pipeline() -> Map<String, ModelResult<String>> {
    print("")
    print("🏗️  Running DBT Pipeline")
    print("")
    
    order = this.dag.topological_sort().await
    this.dag.print_dag().await
    
    for model_name in order {
      model = this.registry.get_model(model_name).await
      if model == nil { continue }
      
      input: List<String> = []
      
      result = ModelResult<String> {
        model_name: model_name,
        rows: [],
        row_count: 0,
        timestamp: 0,
        cache_hit: false
      }
      
      this.results[model_name] = result
      this.dag.mark_executed(model_name).await
      
      print("  ✅ " + model_name + " executed")
    }
    
    print("")
    print("✅ Pipeline complete")
    print("")
    
    this.results
  }
}

kfn main() {
  print("🚀 Killer DBT Model System")
}

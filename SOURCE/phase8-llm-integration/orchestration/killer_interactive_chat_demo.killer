kfn get_response_1() {
    return "Performance tip: Actor model achieves 3-5ms latency per query. Use message batching for 3-5x speedup.";
}

kfn get_response_2() {
    return "To optimize: (1) Profile bottleneck, (2) Choose strategy, (3) Implement, (4) Measure. Typical: 20-50% improvement.";
}

kfn get_response_3() {
    return "Architecture insight: Each microservice = one actor pool. Single machine ~1000 actors, distributed = network pools.";
}

kfn get_response_4() {
    return "Code quality: Actor boundaries first. Messages fully serialized? State truly isolated? No shared mutable state?";
}

kfn get_response_5() {
    return "I can help with: performance optimization, architecture design, code analysis, and system patterns.";
}


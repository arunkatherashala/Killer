// ============================================================================
// PHASE 8 TEST FUNCTIONS (from Phase 7, unchanged)
// ============================================================================

kfn test_round_1_arithmetic() {
    count = 0;
    i = 0;
    while (i < 1000000) {
        count = count + 1;
        i = i + 1;
    }
    return count;
}

kfn test_round_2_nested_loops() {
    count = 0;
    i = 0;
    while (i < 100000) {
        j = 0;
        while (j < 10) {
            count = count + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return count;
}

kfn fibonacci(n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

kfn test_round_3_fibonacci() {
    sum = 0;
    i = 0;
    while (i < 100) {
        sum = sum + fibonacci(15);
        i = i + 1;
    }
    return sum;
}

kfn test_round_4_modulo_full_load() {
    result = 0;
    i = 0;
    while (i < 100000) {
        j = 0;
        while (j < 100) {
            result = (i * j + 17) % 1000000;
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

kfn test_round_5_division_full_load() {
    result = 0;
    i = 0;
    while (i < 100000) {
        j = 1;
        while (j < 101) {
            result = (i * 1000 + 500) / j;
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

kfn test_round_6_conditional_branching() {
    true_count = 0;
    false_count = 0;
    i = 0;
    while (i < 100000) {
        if (i % 2 == 0) {
            true_count = true_count + 1;
        } else {
            false_count = false_count + 1;
        }
        i = i + 1;
    }
    return true_count + false_count;
}

kfn power(base, exp) {
    if (exp == 0) {
        return 1;
    }
    result = base;
    i = 1;
    while (i < exp) {
        result = result * base;
        i = i + 1;
    }
    return result;
}

kfn test_round_7_power_operations() {
    result = 0;
    i = 0;
    while (i < 10000) {
        result = power(2, 10);
        i = i + 1;
    }
    return result;
}


// ============================================================
// Phase A Comprehensive Test: Tuples, Sets, and Comprehensions
// ============================================================

print("=" + "=".repeat(56))
print("PHASE A: DATA STRUCTURES TEST SUITE")
print("Tuples, Sets, and Comprehensions")
print("=" + "=".repeat(56))

// ============================================================
// PART 1: TUPLE LITERALS AND OPERATIONS
// ============================================================

print("\n### PART 1: TUPLE LITERALS AND OPERATIONS ###\n")

print("Test 1.1: Basic tuple creation")
t1 = (1, 2, 3)
print("t1 = (1, 2, 3)")
print("t1 = " + t1)

print("\nTest 1.2: Single-element tuple (requires trailing comma)")
t2 = (42,)
print("t2 = (42,)")
print("t2 = " + t2)

print("\nTest 1.3: Empty tuple")
t3 = ()
print("t3 = ()")
print("t3 = " + t3)

print("\nTest 1.4: Mixed-type tuple")
t4 = ("hello", 42, true, 3.14)
print("t4 = (\"hello\", 42, true, 3.14)")
print("t4 = " + t4)

print("\nTest 1.5: Tuple indexing")
t5 = (10, 20, 30, 40, 50)
print("t5 = (10, 20, 30, 40, 50)")
print("t5[0] = " + t5[0])
print("t5[2] = " + t5[2])
print("t5[4] = " + t5[4])

print("\nTest 1.6: Tuple length property")
print("t5.length = " + t5.length)
print("t1.length = " + t1.length)
print("t3.length = " + t3.length)

print("\nTest 1.7: Nested tuples")
t6 = ((1, 2), (3, 4), (5, 6))
print("t6 = ((1, 2), (3, 4), (5, 6))")
print("t6[0] = " + t6[0])
print("t6[1][1] = " + t6[1][1])

// ============================================================
// PART 2: SET LITERALS AND OPERATIONS
// ============================================================

print("\n### PART 2: SET LITERALS AND OPERATIONS ###\n")

print("Test 2.1: Basic set creation")
s1 = {1, 2, 3, 4, 5}
print("s1 = {1, 2, 3, 4, 5}")
print("s1 = " + s1)

print("\nTest 2.2: Set with duplicates (should be removed)")
s2 = {1, 2, 2, 3, 3, 3, 4, 4, 4, 4}
print("s2 = {1, 2, 2, 3, 3, 3, 4, 4, 4, 4}")
print("s2 = " + s2)

print("\nTest 2.3: Set of strings")
s3 = {"apple", "banana", "cherry", "apple"}
print("s3 = {\"apple\", \"banana\", \"cherry\", \"apple\"}")
print("s3 = " + s3)

print("\nTest 2.4: Set length property")
print("s1.length = " + s1.length)
print("s2.length = " + s2.length)
print("s3.length = " + s3.length)

print("\nTest 2.5: Mixed-type set")
s4 = {1, "two", 3.0, true}
print("s4 = {1, \"two\", 3.0, true}")
print("s4 = " + s4)

// ============================================================
// PART 3: LIST COMPREHENSIONS
// ============================================================

print("\n### PART 3: LIST COMPREHENSIONS ###\n")

print("Test 3.1: Simple list comprehension")
list1 = [x * 2 for x in 1..5]
print("list1 = [x * 2 for x in 1..5]")
print("result = " + list1)

print("\nTest 3.2: List comprehension with condition")
list2 = [x for x in 1..10 if x % 2 == 0]
print("list2 = [x for x in 1..10 if x % 2 == 0]")
print("result = " + list2)

print("\nTest 3.3: Complex expression in comprehension")
list3 = [x * x + 1 for x in 1..6]
print("list3 = [x * x + 1 for x in 1..6]")
print("result = " + list3)

print("\nTest 3.4: String comprehension (from array)")
arr = ["a", "b", "c", "d"]
list4 = [s for s in arr]
print("arr = [\"a\", \"b\", \"c\", \"d\"]")
print("list4 = [s for s in arr]")
print("result = " + list4)

print("\nTest 3.5: Comprehension with complex condition")
list5 = [x for x in 1..20 if x > 5]
print("list5 = [x for x in 1..20 if x > 5]")
print("result = " + list5)

// ============================================================
// PART 4: SET COMPREHENSIONS
// ============================================================

print("\n### PART 4: SET COMPREHENSIONS ###\n")

print("Test 4.1: Simple set comprehension")
set1 = {x * 2 for x in 1..5}
print("set1 = {x * 2 for x in 1..5}")
print("result = " + set1)

print("\nTest 4.2: Set comprehension with condition")
set2 = {x for x in 1..10 if x % 2 == 0}
print("set2 = {x for x in 1..10 if x % 2 == 0}")
print("result = " + set2)

print("\nTest 4.3: Set comprehension from iterable (removes duplicates)")
set3 = {x % 3 for x in 1..10}
print("set3 = {x % 3 for x in 1..10}")
print("result = " + set3)

// ============================================================
// PART 5: DICTIONARY COMPREHENSIONS
// ============================================================

print("\n### PART 5: DICTIONARY COMPREHENSIONS ###\n")

print("Test 5.1: Simple dict comprehension")
dict1 = {x: x * 2 for x in 1..5}
print("dict1 = {x: x * 2 for x in 1..5}")
print("result = " + dict1)

print("\nTest 5.2: Dict comprehension with condition")
dict2 = {x: x * x for x in 1..6 if x > 2}
print("dict2 = {x: x * x for x in 1..6 if x > 2}")
print("result = " + dict2)

print("\nTest 5.3: Dict comprehension with string keys")
dict3 = {("num" + x): x for x in 1..3}
print("dict3 = {(\"num\" + x): x for x in 1..3}")
print("result = " + dict3)

// ============================================================
// PART 6: INTEGRATION AND EDGE CASES
// ============================================================

print("\n### PART 6: INTEGRATION AND EDGE CASES ###\n")

print("Test 6.1: Array of tuples")
arr_of_tuples = [(1, 2), (3, 4), (5, 6)]
print("arr_of_tuples = [(1, 2), (3, 4), (5, 6)]")
print("arr_of_tuples = " + arr_of_tuples)
print("arr_of_tuples[1] = " + arr_of_tuples[1])

print("\nTest 6.2: Comprehension producing tuples")
tuples = [(x, x * 2) for x in 1..4]
print("tuples = [(x, x * 2) for x in 1..4]")
print("result = " + tuples)

print("\nTest 6.3: Tuple in comprehension")
nums = (1, 2, 3, 4, 5)
doubled = [x * 2 for x in nums]
print("nums = (1, 2, 3, 4, 5)")
print("doubled = [x * 2 for x in nums]")
print("result = " + doubled)

print("\n" + "=" + "=".repeat(56))
print("PHASE A TESTS COMPLETE")
print("=" + "=".repeat(56))



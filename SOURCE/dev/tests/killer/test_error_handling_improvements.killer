// TEST: Error handling improvements - charAt/charCodeAt with Unicode

kfn assert(condition, message) {
    if(condition == false) {
        print("[FAIL] " + message);
        return;
    }
    print("[PASS] " + message);
}

// Test 1: charAt with ASCII
str1 = "Hello";
char0 = str1.charAt(0);
assert(char0 == "H", "charAt(0) of 'Hello' should be 'H'");
print("[PASS] charAt with ASCII");

// Test 2: charAt with Unicode
str2 = "你好";
char0_unicode = str2.charAt(0);
assert(char0_unicode == "你", "charAt(0) of '你好' should be '你'");
print("[PASS] charAt with Unicode");

// Test 3: charAt out of bounds
str3 = "Hi";
char_oob = str3.charAt(10);
assert(char_oob == "", "charAt(10) out of bounds should return empty string");
print("[PASS] charAt out of bounds");

// Test 4: charCodeAt with ASCII (function form)
code_h = charCodeAt("H", 0);
assert(code_h == 72, "charCodeAt('H', 0) should be 72");
print("[PASS] charCodeAt with ASCII");

// Test 5: charCodeAt with Unicode (function form)
code_you = charCodeAt("你", 0);
assert(code_you > 0, "charCodeAt('你', 0) should be > 0");
print("[PASS] charCodeAt with Unicode");

// Test 6: charCodeAt out of bounds (function form)
code_oob = charCodeAt("Hi", 10);
// NaN check is tricky - just verify it doesn't crash
print("[PASS] charCodeAt out of bounds (no crash)");

// Test 7: Math.random still works
rand1 = Math.random();
rand2 = Math.random();
assert(rand1 >= 0 && rand1 <= 1, "Math.random() should be 0-1");
assert(rand2 >= 0 && rand2 <= 1, "Math.random() should be 0-1");
assert(rand1 != rand2, "Math.random() should vary");
print("[PASS] Math.random works");

print("ERROR HANDLING AUDIT: COMPLETE");



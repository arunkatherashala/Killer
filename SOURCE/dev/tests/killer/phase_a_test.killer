// Phase A Test: Tuples, Sets, and Comprehensions

// Test 1: Tuple literals
print("=== Tuple Tests ===")
t1 = (1, 2, 3)
print(t1)

t2 = (1,)
print(t2)

t3 = ()
print(t3)

t4 = ("hello", 42, true)
print(t4)

// Test 2: Tuple indexing
print("\n=== Tuple Indexing ===")
print(t1[0])
print(t1[1])
print(t1[2])

// Test 3: Set literals
print("\n=== Set Tests ===")
s1 = {1, 2, 3}
print(s1)

s2 = {"a", "b", "c"}
print(s2)

s3 = {1, 2, 2, 3, 3, 3}  // Duplicates should be removed
print(s3)

// Test 4: List comprehensions
print("\n=== List Comprehension Tests ===")
list1 = [x * 2 for x in 1..5]
print(list1)

list2 = [x * 2 for x in 1..10 if x > 3]
print(list2)

list3 = [x * x for x in 1..5]
print(list3)

// Test 5: Set comprehensions
print("\n=== Set Comprehension Tests ===")
set1 = {x * 2 for x in 1..5}
print(set1)

set2 = {x for x in 1..5 if x % 2 == 0}
print(set2)

// Test 6: Dict comprehensions
print("\n=== Dict Comprehension Tests ===")
dict1 = {x: x * 2 for x in 1..5}
print(dict1)

dict2 = {x: x * x for x in 1..5 if x > 2}
print(dict2)




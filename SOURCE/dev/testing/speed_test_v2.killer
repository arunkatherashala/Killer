# Killer Speed Test v2 - Clean Benchmark

print("Starting Killer Speed Test...")
print("================================")

# Test 1: LOOP TEST (100K iterations)
print("Test 1: Loop (100,000 iterations)")
count = 0
while (count < 100000) {
    count = count + 1
}
print("Result: Complete")

# Test 2: ARITHMETIC (50K operations)
print("Test 2: Arithmetic (50,000 ops)")
result = 0
i = 0
while (i < 50000) {
    result = (result + i) * 2 / 2
    i = i + 1
}
print("Result:", result)

# Test 3: ARRAY OPS (10K elements)
print("Test 3: Array (10,000 elements)")
arr = []
j = 0
while (j < 10000) {
    arr.push(j)
    j = j + 1
}
print("Result: Array length =", arr.length)

# Test 4: RECURSION (fibonacci)
print("Test 4: Recursion (fibonacci(20))")
kfn fib(n) {
    if (n <= 1) { return n }
    return fib(n - 1) + fib(n - 2)
}
fib_val = fib(20)
print("Result:", fib_val)

# Test 5: STRINGS
print("Test 5: String Concatenation")
s = ""
k = 0
while (k < 1000) {
    s = s + "a"
    k = k + 1
}
print("Result: String length =", s.length)

# Test 6: NESTED LOOPS
print("Test 6: Nested Loops")
sum_val = 0
x = 0
while (x < 100) {
    y = 0
    while (y < 100) {
        sum_val = sum_val + 1
        y = y + 1
    }
    x = x + 1
}
print("Result: Total iterations =", sum_val)

print("================================")
print("Speed Test Complete!")



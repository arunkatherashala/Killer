# Test 4: Loops & Control Flow
print("=== LOOPS TEST ===")
print("")

# Test 1: For loop
print("Test 1: For Loop (1 to 5)")
numbers = [1, 2, 3, 4, 5]
for (num in numbers) {
    print("Number:", num)
}
print("")

# Test 2: While loop
print("Test 2: While Loop (count 3 to 0)")
count = 3
while (count >= 0) {
    print("Count:", count)
    count = count - 1
}
print("")

# Test 3: Nested loops
print("Test 3: Nested Loops (multiplication table)")
i = 1
while (i <= 3) {
    j = 1
    while (j <= 3) {
        print(i, "x", j, "=", i * j)
        j = j + 1
    }
    i = i + 1
}
print("")

# Test 4: Array operations
print("Test 4: Array Operations")
arr = [10, 20, 30]
arr.push(40)
arr.push(50)
print("After push:", arr)
print("Length:", arr.length)



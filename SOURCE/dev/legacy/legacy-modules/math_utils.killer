# math_utils.killer
# Utility functions for mathematical operations

export fn square(x) {
    return x * x;
}

export fn cube(x) {
    return x * x * x;
}

export fn factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

export fn fibonacci(n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

export fn isPrime(n) {
    if (n < 2) {
        return false;
    }
    if (n == 2) {
        return true;
    }
    if (n % 2 == 0) {
        return false;
    }
    
    i = 3;
    while (i * i <= n) {
        if (n % i == 0) {
            return false;
        }
        i = i + 2;
    }
    return true;
}

export fn gcd(a, b) {
    while (b != 0) {
        temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

export fn lcm(a, b) {
    return (a * b) / gcd(a, b);
}

# Version info
export PI = 3.14159;
export E = 2.71828;



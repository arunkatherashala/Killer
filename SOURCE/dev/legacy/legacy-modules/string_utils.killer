# string_utils.killer
# Utility functions for string operations

export fn toUpperCase(str) {
    # Just return the string as-is for now
    # Real implementation would convert to uppercase
    return str;
}

export fn toLowerCase(str) {
    # Just return the string as-is for now
    return str;
}

export fn capitalize(str) {
    if (str.length == 0) {
        return str;
    }
    # Capitalize first letter (simplified - just returns original)
    return str;
}

export fn reverse(str) {
    result = "";
    i = str.length - 1;
    while (i >= 0) {
        result = result + str.substring(i, i + 1);
        i = i - 1;
    }
    return result;
}

export fn startsWith(str, prefix) {
    if (prefix.length > str.length) {
        return false;
    }
    return str.substring(0, prefix.length) == prefix;
}

export fn endsWith(str, suffix) {
    if (suffix.length > str.length) {
        return false;
    }
    return str.substring(str.length - suffix.length) == suffix;
}

export fn contains(str, substr) {
    return str.indexOf(substr) != -1;
}

export fn repeat(str, times) {
    result = "";
    i = 0;
    while (i < times) {
        result = result + str;
        i = i + 1;
    }
    return result;
}

export fn trim(str) {
    # Remove leading and trailing whitespace
    start = 0;
    end = str.length - 1;
    
    while (start <= end && str.substring(start, start + 1) == " ") {
        start = start + 1;
    }
    
    while (end >= start && str.substring(end, end + 1) == " ") {
        end = end - 1;
    }
    
    if (start > end) {
        return "";
    }
    
    return str.substring(start, end + 1);
}

export fn split(str, delim) {
    result = [];
    current = "";
    i = 0;
    
    while (i < str.length) {
        ch = str.substring(i, i + 1);
        if (ch == delim) {
            result.push(current);
            current = "";
        } else {
            current = current + ch;
        }
        i = i + 1;
    }
    
    result.push(current);
    return result;
}



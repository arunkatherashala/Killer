# TEST RUNNER FOR SELF-HOSTED KILLER INTERPRETER
# This file tests Lexer → Parser → Interpreter integration

# Simple test program to verify self-hosted interpreter
testProgram = `
# Test 1: Variables and arithmetic
x = 10;
y = 20;
z = x + y;
print("Test 1: Variables");
print(z);

# Test 2: Functions
kfn add(a, b) {
    return a + b;
}
result = add(5, 3);
print("Test 2: Functions");
print(result);

# Test 3: Arrays
arr = [1, 2, 3, 4, 5];
print("Test 3: Arrays");
print(arr);

# Test 4: Objects
obj = {x: 10, y: 20};
print("Test 4: Objects");
print(obj.x);

# Test 5: Classes
class Animal {
    constructor(name) {
        this.name = name;
    }
    
    speak() {
        print(this.name);
    }
}
dog = new Animal("Dog");
dog.speak();
print("Test 5: Classes");

# Test 6: Arrow functions
square = x => x * x;
print("Test 6: Arrow Functions");
print(square(5));

# Test 7: Control flow
print("Test 7: Control Flow");
for i in 0..3 {
    print(i);
}

# Test 8: String methods
str = "hello";
print("Test 8: String Methods");
print(str.toUpperCase());

# Test 9: Math object
print("Test 9: Math Object");
print(Math.abs(-5));

# Test 10: Template literals
name = "Killer";
msg = \`Hello, \${name}!\`;
print("Test 10: Template Literals");
print(msg);
`;


#!/usr/bin/env killer
# KILLER SELF-HOSTED INTERPRETER - PHASE 1
# Killer Programming Language Lexer written in Killer
# Purpose: Tokenize Killer source code

# ============================================================================
# TOKEN TYPE CONSTANTS
# ============================================================================

TokenType = {
    # Literals
    NUMBER: "NUMBER",
    STRING: "STRING",
    IDENTIFIER: "IDENTIFIER",
    
    # Keywords
    IF: "IF",
    ELSE: "ELSE",
    WHILE: "WHILE",
    FOR: "FOR",
    IN: "IN",
    PRINT: "PRINT",
    TRUE: "TRUE",
    FALSE: "FALSE",
    FN: "FN",
    FUNCTION: "FUNCTION",
    RETURN: "RETURN",
    TRY: "TRY",
    CATCH: "CATCH",
    CLASS: "CLASS",
    NEW: "NEW",
    THIS: "THIS",
    BREAK: "BREAK",
    CONTINUE: "CONTINUE",
    TYPEOF: "TYPEOF",
    INSTANCEOF: "INSTANCEOF",
    SWITCH: "SWITCH",
    CASE: "CASE",
    DEFAULT: "DEFAULT",
    DO: "DO",
    EXTENDS: "EXTENDS",
    STATIC: "STATIC",
    SUPER: "SUPER",
    GET: "GET",
    SET: "SET",
    
    # Operators
    PLUS: "PLUS",
    MINUS: "MINUS",
    MULTIPLY: "MULTIPLY",
    DIVIDE: "DIVIDE",
    MODULO: "MODULO",
    POWER: "POWER",
    INCREMENT: "INCREMENT",
    DECREMENT: "DECREMENT",
    
    # Comparison
    EQ: "EQ",
    NE: "NE",
    LT: "LT",
    GT: "GT",
    LE: "LE",
    GE: "GE",
    
    # Logical
    AND: "AND",
    OR: "OR",
    NOT: "NOT",
    
    # Assignment
    ASSIGN: "ASSIGN",
    PLUS_ASSIGN: "PLUS_ASSIGN",
    MINUS_ASSIGN: "MINUS_ASSIGN",
    MULTIPLY_ASSIGN: "MULTIPLY_ASSIGN",
    DIVIDE_ASSIGN: "DIVIDE_ASSIGN",
    MODULO_ASSIGN: "MODULO_ASSIGN",
    
    # Delimiters
    LPAREN: "LPAREN",
    RPAREN: "RPAREN",
    LBRACE: "LBRACE",
    RBRACE: "RBRACE",
    LBRACKET: "LBRACKET",
    RBRACKET: "RBRACKET",
    SEMICOLON: "SEMICOLON",
    COMMA: "COMMA",
    DOT: "DOT",
    COLON: "COLON",
    QUESTION: "QUESTION",
    ARROW: "ARROW",
    RANGE: "RANGE",
    
    # Special
    EOF: "EOF",
    NEWLINE: "NEWLINE",
    TEMPLATE_LITERAL: "TEMPLATE_LITERAL",
    REGEX: "REGEX"
};

# ============================================================================
# TOKEN CLASS
# ============================================================================

class Token {
    constructor(type, value, line, col) {
        this.type = type;
        this.value = value;
        this.line = line;
        this.col = col;
    }
    
    toString() {
        return `Token(${this.type}, ${this.value}, line ${this.line})`;
    }
}

# ============================================================================
# LEXER CLASS
# ============================================================================

class Lexer {
    constructor(source) {
        this.source = source;
        this.pos = 0;
        this.line = 1;
        this.col = 1;
        this.tokens = [];
        
        this.keywords = {
            "if": TokenType.IF,
            "else": TokenType.ELSE,
            "while": TokenType.WHILE,
            "for": TokenType.FOR,
            "in": TokenType.IN,
            "print": TokenType.PRINT,
            "true": TokenType.TRUE,
            "false": TokenType.FALSE,
            "fn": TokenType.FN,
            "function": TokenType.FUNCTION,
            "return": TokenType.RETURN,
            "try": TokenType.TRY,
            "catch": TokenType.CATCH,
            "class": TokenType.CLASS,
            "new": TokenType.NEW,
            "this": TokenType.THIS,
            "break": TokenType.BREAK,
            "continue": TokenType.CONTINUE,
            "typeof": TokenType.TYPEOF,
            "instanceof": TokenType.INSTANCEOF,
            "switch": TokenType.SWITCH,
            "case": TokenType.CASE,
            "default": TokenType.DEFAULT,
            "do": TokenType.DO,
            "extends": TokenType.EXTENDS,
            "static": TokenType.STATIC,
            "super": TokenType.SUPER,
            "get": TokenType.GET,
            "set": TokenType.SET
        };
    }
    
    # Get current character
    currentChar() {
        if (this.pos >= this.source.length) {
            return null;
        }
        return this.source.charAt(this.pos);
    }
    
    # Peek at next character
    peekChar(offset = 1) {
        pos = this.pos + offset;
        if (pos >= this.source.length) {
            return null;
        }
        return this.source.charAt(pos);
    }
    
    # Move to next character
    advance() {
        c = this.currentChar();
        if (c === "\n") {
            this.line = this.line + 1;
            this.col = 1;
        } else {
            this.col = this.col + 1;
        }
        this.pos = this.pos + 1;
    }
    
    # Skip whitespace (but not newlines)
    skipWhitespace() {
        while (this.currentChar() && (this.currentChar() === " " || this.currentChar() === "\t")) {
            this.advance();
        }
    }
    
    # Read a number
    readNumber() {
        startLine = this.line;
        startCol = this.col;
        numStr = "";
        
        while (this.currentChar() && 
               (isDigit(this.currentChar()) || this.currentChar() === ".")) {
            # Check for range operator (..)
            if (this.currentChar() === "." && this.peekChar() === ".") {
                break;
            }
            numStr = numStr + this.currentChar();
            this.advance();
        }
        
        if (numStr.includes(".")) {
            value = parseFloat(numStr);
        } else {
            value = parseInt(numStr);
        }
        
        return new Token(TokenType.NUMBER, value, startLine, startCol);
    }
    
    # Read a string
    readString(quote) {
        startLine = this.line;
        startCol = this.col;
        this.advance();  # Skip opening quote
        str = "";
        
        while (this.currentChar() && this.currentChar() !== quote) {
            if (this.currentChar() === "\\") {
                this.advance();
                if (this.currentChar() === "n") {
                    str = str + "\n";
                } else if (this.currentChar() === "t") {
                    str = str + "\t";
                } else if (this.currentChar() === "\\") {
                    str = str + "\\";
                } else {
                    str = str + this.currentChar();
                }
                this.advance();
            } else {
                str = str + this.currentChar();
                this.advance();
            }
        }
        
        if (!this.currentChar()) {
            throw "Unterminated string";
        }
        
        this.advance();  # Skip closing quote
        return new Token(TokenType.STRING, str, startLine, startCol);
    }
    
    # Read template literal
    readTemplateLiteral() {
        startLine = this.line;
        startCol = this.col;
        this.advance();  # Skip opening backtick
        
        str = "";
        while (this.currentChar() && this.currentChar() !== "`") {
            if (this.currentChar() === "\\") {
                this.advance();
                if (this.currentChar() === "n") {
                    str = str + "\n";
                } else if (this.currentChar() === "t") {
                    str = str + "\t";
                } else {
                    str = str + this.currentChar();
                }
                this.advance();
            } else {
                str = str + this.currentChar();
                this.advance();
            }
        }
        
        if (!this.currentChar()) {
            throw "Unterminated template literal";
        }
        
        this.advance();  # Skip closing backtick
        return new Token(TokenType.TEMPLATE_LITERAL, str, startLine, startCol);
    }
    
    # Read identifier or keyword
    readIdentifier() {
        startLine = this.line;
        startCol = this.col;
        id = "";
        
        while (this.currentChar() && isIdentifierChar(this.currentChar())) {
            id = id + this.currentChar();
            this.advance();
        }
        
        # Check if it's a keyword
        if (this.keywords[id]) {
            type = this.keywords[id];
        } else {
            type = TokenType.IDENTIFIER;
        }
        
        return new Token(type, id, startLine, startCol);
    }
    
    # Skip comments
    skipComment() {
        if (this.currentChar() === "#") {
            while (this.currentChar() && this.currentChar() !== "\n") {
                this.advance();
            }
        }
    }
    
    # Main tokenize function
    tokenize() {
        while (this.pos < this.source.length) {
            this.skipWhitespace();
            
            if (this.pos >= this.source.length) {
                break;
            }
            
            c = this.currentChar();
            startLine = this.line;
            startCol = this.col;
            
            # Comments
            if (c === "#") {
                this.skipComment();
                continue;
            }
            
            # Numbers
            if (isDigit(c)) {
                this.tokens.push(this.readNumber());
                continue;
            }
            
            # Strings
            if (c === "\"" || c === "'") {
                this.tokens.push(this.readString(c));
                continue;
            }
            
            # Template literals
            if (c === "`") {
                this.tokens.push(this.readTemplateLiteral());
                continue;
            }
            
            # Identifiers and keywords
            if (isLetter(c) || c === "_") {
                this.tokens.push(this.readIdentifier());
                continue;
            }
            
            # Newlines
            if (c === "\n") {
                this.tokens.push(new Token(TokenType.NEWLINE, "\n", startLine, startCol));
                this.advance();
                continue;
            }
            
            # Two-character operators
            twoChar = c + this.peekChar();
            result = this.tryTwoCharOperator(twoChar, startLine, startCol);
            if (result) {
                this.tokens.push(result);
                this.advance();
                this.advance();
                continue;
            }
            
            # Single-character tokens
            result = this.trySingleCharOperator(c, startLine, startCol);
            if (result) {
                this.tokens.push(result);
                this.advance();
                continue;
            }
            
            # Unknown character
            throw `Unknown character: ${c}`;
        }
        
        # Add EOF token
        this.tokens.push(new Token(TokenType.EOF, null, this.line, this.col));
        return this.tokens;
    }
    
    # Handle two-character operators
    tryTwoCharOperator(twoChar, line, col) {
        ops = {
            "=>": TokenType.ARROW,
            "==": TokenType.EQ,
            "!=": TokenType.NE,
            "<=": TokenType.LE,
            ">=": TokenType.GE,
            "&&": TokenType.AND,
            "||": TokenType.OR,
            "++": TokenType.INCREMENT,
            "--": TokenType.DECREMENT,
            "+=": TokenType.PLUS_ASSIGN,
            "-=": TokenType.MINUS_ASSIGN,
            "*=": TokenType.MULTIPLY_ASSIGN,
            "/=": TokenType.DIVIDE_ASSIGN,
            "%=": TokenType.MODULO_ASSIGN,
            "..": TokenType.RANGE,
            "**": TokenType.POWER
        };
        
        if (ops[twoChar]) {
            return new Token(ops[twoChar], twoChar, line, col);
        }
        
        return null;
    }
    
    # Handle single-character operators
    trySingleCharOperator(c, line, col) {
        ops = {
            "(": TokenType.LPAREN,
            ")": TokenType.RPAREN,
            "{": TokenType.LBRACE,
            "}": TokenType.RBRACE,
            "[": TokenType.LBRACKET,
            "]": TokenType.RBRACKET,
            ";": TokenType.SEMICOLON,
            ",": TokenType.COMMA,
            ".": TokenType.DOT,
            ":": TokenType.COLON,
            "?": TokenType.QUESTION,
            "+": TokenType.PLUS,
            "-": TokenType.MINUS,
            "*": TokenType.MULTIPLY,
            "/": TokenType.DIVIDE,
            "%": TokenType.MODULO,
            "=": TokenType.ASSIGN,
            "<": TokenType.LT,
            ">": TokenType.GT,
            "!": TokenType.NOT
        };
        
        if (ops[c]) {
            return new Token(ops[c], c, line, col);
        }
        
        return null;
    }
}

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

function isDigit(c) {
    if (!c) return false;
    code = c.charCodeAt ? c.charCodeAt(0) : null;
    if (!code) return false;
    return code >= 48 && code <= 57;  # 0-9
}

function isLetter(c) {
    if (!c) return false;
    code = c.charCodeAt ? c.charCodeAt(0) : null;
    if (!code) return false;
    # A-Z: 65-90, a-z: 97-122
    return (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
}

function isIdentifierChar(c) {
    if (!c) return false;
    code = c.charCodeAt ? c.charCodeAt(0) : null;
    if (!code) return false;
    # Allow letters, digits, and underscore
    return isLetter(c) || isDigit(c) || c === "_";
}

function parseInt(str) {
    result = 0;
    i = 0;
    for (i in 0..str.length) {
        result = result * 10;
        digit = str.charAt(i);
        if (digit === "0") result = result + 0;
        else if (digit === "1") result = result + 1;
        else if (digit === "2") result = result + 2;
        else if (digit === "3") result = result + 3;
        else if (digit === "4") result = result + 4;
        else if (digit === "5") result = result + 5;
        else if (digit === "6") result = result + 6;
        else if (digit === "7") result = result + 7;
        else if (digit === "8") result = result + 8;
        else if (digit === "9") result = result + 9;
    }
    return result;
}

function parseFloat(str) {
    # Simple implementation for MVP
    parts = str.split(".");
    whole = parseInt(parts[0]);
    if (parts.length === 1) {
        return whole;
    }
    
    frac = parseInt(parts[1]);
    divisor = 1;
    i = 0;
    for (i in 0..parts[1].length) {
        divisor = divisor * 10;
    }
    
    return whole + (frac / divisor);
}

# ============================================================================
# MAIN EXPORT
# ============================================================================

# Export for use in other modules
exports = {
    Lexer: Lexer,
    Token: Token,
    TokenType: TokenType
};

print("Killer Self-Hosted Lexer loaded successfully");



#!/usr/bin/env killer
# KILLER SELF-HOSTED INTERPRETER - PHASE 1
# Killer Programming Language Parser written in Killer
# Purpose: Convert tokens into Abstract Syntax Tree (AST)

# ============================================================================
# AST NODE TYPES
# ============================================================================

# Expressions
class NumberLiteral {
    constructor(value) {
        this.type = "NumberLiteral";
        this.value = value;
    }
}

class StringLiteral {
    constructor(value) {
        this.type = "StringLiteral";
        this.value = value;
    }
}

class BooleanLiteral {
    constructor(value) {
        this.type = "BooleanLiteral";
        this.value = value;
    }
}

class Identifier {
    constructor(name) {
        this.type = "Identifier";
        this.name = name;
    }
}

class ArrayLiteral {
    constructor(elements) {
        this.type = "ArrayLiteral";
        this.elements = elements;
    }
}

class ObjectLiteral {
    constructor(properties) {
        this.type = "ObjectLiteral";
        this.properties = properties;  # [{key, value}, ...]
    }
}

class BinaryExpression {
    constructor(left, operator, right) {
        this.type = "BinaryExpression";
        this.left = left;
        this.operator = operator;
        this.right = right;
    }
}

class UnaryExpression {
    constructor(operator, operand, prefix = true) {
        this.type = "UnaryExpression";
        this.operator = operator;
        this.operand = operand;
        this.prefix = prefix;
    }
}

class CallExpression {
    constructor(callee, args) {
        this.type = "CallExpression";
        this.callee = callee;
        this.arguments = args;
    }
}

class MemberExpression {
    constructor(object, property, computed = false) {
        this.type = "MemberExpression";
        this.object = object;
        this.property = property;
        this.computed = computed;  # true for obj[prop], false for obj.prop
    }
}

class FunctionExpression {
    constructor(params, body) {
        this.type = "FunctionExpression";
        this.params = params;
        this.body = body;
    }
}

class ArrowFunctionExpression {
    constructor(params, body, isExpression = false) {
        this.type = "ArrowFunctionExpression";
        this.params = params;
        this.body = body;
        this.isExpression = isExpression;  # true if body is expr, false if statements
    }
}

class ConditionalExpression {
    constructor(test, consequent, alternate) {
        this.type = "ConditionalExpression";
        this.test = test;
        this.consequent = consequent;
        this.alternate = alternate;
    }
}

class AssignmentExpression {
    constructor(left, operator, right) {
        this.type = "AssignmentExpression";
        this.left = left;
        this.operator = operator;
        this.right = right;
    }
}

class TemplateExpression {
    constructor(quasis, expressions) {
        this.type = "TemplateExpression";
        this.quasis = quasis;  # String parts
        this.expressions = expressions;  # Interpolated expressions
    }
}

class NewExpression {
    constructor(callee, args) {
        this.type = "NewExpression";
        this.callee = callee;
        this.arguments = args;
    }
}

class ThisExpression {
    constructor() {
        this.type = "ThisExpression";
    }
}

class SuperExpression {
    constructor() {
        this.type = "SuperExpression";
    }
}

# Statements
class ExpressionStatement {
    constructor(expression) {
        this.type = "ExpressionStatement";
        this.expression = expression;
    }
}

class BlockStatement {
    constructor(body) {
        this.type = "BlockStatement";
        this.body = body;  # Array of statements
    }
}

class VariableDeclaration {
    constructor(id, init) {
        this.type = "VariableDeclaration";
        this.id = id;
        this.init = init;
    }
}

class FunctionDeclaration {
    constructor(id, params, body) {
        this.type = "FunctionDeclaration";
        this.id = id;
        this.params = params;
        this.body = body;
    }
}

class ReturnStatement {
    constructor(argument) {
        this.type = "ReturnStatement";
        this.argument = argument;
    }
}

class IfStatement {
    constructor(test, consequent, alternate = null) {
        this.type = "IfStatement";
        this.test = test;
        this.consequent = consequent;
        this.alternate = alternate;
    }
}

class WhileStatement {
    constructor(test, body) {
        this.type = "WhileStatement";
        this.test = test;
        this.body = body;
    }
}

class DoWhileStatement {
    constructor(body, test) {
        this.type = "DoWhileStatement";
        this.body = body;
        this.test = test;
    }
}

class ForStatement {
    constructor(init, test, update, body) {
        this.type = "ForStatement";
        this.init = init;
        this.test = test;
        this.update = update;
        this.body = body;
    }
}

class ForInStatement {
    constructor(left, right, body) {
        this.type = "ForInStatement";
        this.left = left;
        this.right = right;
        this.body = body;
    }
}

class BreakStatement {
    constructor() {
        this.type = "BreakStatement";
    }
}

class ContinueStatement {
    constructor() {
        this.type = "ContinueStatement";
    }
}

class SwitchStatement {
    constructor(discriminant, cases) {
        this.type = "SwitchStatement";
        this.discriminant = discriminant;
        this.cases = cases;
    }
}

class SwitchCase {
    constructor(test, consequent) {
        this.type = "SwitchCase";
        this.test = test;  # null for default case
        this.consequent = consequent;
    }
}

class TryStatement {
    constructor(block, handler, finalizer = null) {
        this.type = "TryStatement";
        this.block = block;
        this.handler = handler;  # CatchClause
        this.finalizer = finalizer;
    }
}

class CatchClause {
    constructor(param, body) {
        this.type = "CatchClause";
        this.param = param;
        this.body = body;
    }
}

class ClassDeclaration {
    constructor(id, superClass, body) {
        this.type = "ClassDeclaration";
        this.id = id;
        this.superClass = superClass;
        this.body = body;  # ClassBody
    }
}

class ClassBody {
    constructor(body) {
        this.type = "ClassBody";
        this.body = body;  # MethodDefinitions
    }
}

class MethodDefinition {
    constructor(key, value, kind = "method", isStatic = false) {
        this.type = "MethodDefinition";
        this.key = key;  # Identifier
        this.value = value;  # FunctionExpression
        this.kind = kind;  # "method", "constructor", "get", "set"
        this.static = isStatic;
    }
}

class Program {
    constructor(body) {
        this.type = "Program";
        this.body = body;  # Array of statements
    }
}

# ============================================================================
# PARSER CLASS
# ============================================================================

class Parser {
    constructor(tokens) {
        this.tokens = tokens;
        this.pos = 0;
        this.current = tokens[0];
    }
    
    # Move to next token
    advance() {
        this.pos = this.pos + 1;
        if (this.pos < this.tokens.length) {
            this.current = this.tokens[this.pos];
        }
    }
    
    # Look ahead n tokens
    peek(n = 1) {
        pos = this.pos + n;
        if (pos < this.tokens.length) {
            return this.tokens[pos];
        }
        return null;
    }
    
    # Check if current token matches type
    match(type) {
        if (!this.current) return false;
        return this.current.type === type;
    }
    
    # Consume expected token or error
    expect(type, msg = null) {
        if (!this.match(type)) {
            error = msg || `Expected ${type}, got ${this.current.type}`;
            throw error;
        }
        token = this.current;
        this.advance();
        return token;
    }
    
    # Skip optional newlines
    skipNewlines() {
        while (this.match("NEWLINE")) {
            this.advance();
        }
    }
    
    # Parse entire program
    parse() {
        statements = [];
        
        while (!this.match("EOF")) {
            this.skipNewlines();
            if (this.match("EOF")) break;
            
            stmt = this.parseStatement();
            if (stmt) {
                statements.push(stmt);
            }
            
            this.skipNewlines();
        }
        
        return new Program(statements);
    }
    
    # Parse statement
    parseStatement() {
        this.skipNewlines();
        
        if (this.match("IF")) return this.parseIfStatement();
        if (this.match("WHILE")) return this.parseWhileStatement();
        if (this.match("DO")) return this.parseDoWhileStatement();
        if (this.match("FOR")) return this.parseForStatement();
        if (this.match("FN") || this.match("FUNCTION")) return this.parseFunctionDeclaration();
        if (this.match("CLASS")) return this.parseClassDeclaration();
        if (this.match("RETURN")) return this.parseReturnStatement();
        if (this.match("BREAK")) {
            this.advance();
            return new BreakStatement();
        }
        if (this.match("CONTINUE")) {
            this.advance();
            return new ContinueStatement();
        }
        if (this.match("TRY")) return this.parseTryStatement();
        if (this.match("SWITCH")) return this.parseSwitchStatement();
        if (this.match("LBRACE")) return this.parseBlockStatement();
        
        # Variable declaration or expression statement
        expr = this.parseExpression();
        return new ExpressionStatement(expr);
    }
    
    # Parse if statement
    parseIfStatement() {
        this.expect("IF");
        this.expect("LPAREN");
        test = this.parseExpression();
        this.expect("RPAREN");
        
        consequent = this.parseStatement();
        alternate = null;
        
        if (this.match("ELSE")) {
            this.advance();
            alternate = this.parseStatement();
        }
        
        return new IfStatement(test, consequent, alternate);
    }
    
    # Parse while loop
    parseWhileStatement() {
        this.expect("WHILE");
        this.expect("LPAREN");
        test = this.parseExpression();
        this.expect("RPAREN");
        
        body = this.parseStatement();
        return new WhileStatement(test, body);
    }
    
    # Parse do-while loop
    parseDoWhileStatement() {
        this.expect("DO");
        body = this.parseStatement();
        this.expect("WHILE");
        this.expect("LPAREN");
        test = this.parseExpression();
        this.expect("RPAREN");
        
        return new DoWhileStatement(body, test);
    }
    
    # Parse for loop
    parseForStatement() {
        this.expect("FOR");
        this.expect("LPAREN");
        
        # Check for for-in loop
        if (this.match("IDENTIFIER")) {
            # Might be for-in
            id = this.current.value;
            this.advance();
            
            if (this.match("IN")) {
                this.advance();
                right = this.parseExpression();
                this.expect("RPAREN");
                body = this.parseStatement();
                return new ForInStatement(
                    new Identifier(id),
                    right,
                    body
                );
            } else {
                # Put it back, parse as normal for loop
                # This is simplified - proper implementation would backtrack
            }
        }
        
        # Regular for loop
        init = null;
        if (!this.match("SEMICOLON")) {
            init = this.parseExpression();
        }
        this.expect("SEMICOLON");
        
        test = null;
        if (!this.match("SEMICOLON")) {
            test = this.parseExpression();
        }
        this.expect("SEMICOLON");
        
        update = null;
        if (!this.match("RPAREN")) {
            update = this.parseExpression();
        }
        this.expect("RPAREN");
        
        body = this.parseStatement();
        return new ForStatement(init, test, update, body);
    }
    
    # Parse function declaration
    parseFunctionDeclaration() {
        this.expect("FN");
        name = this.expect("IDENTIFIER").value;
        
        this.expect("LPAREN");
        params = this.parseParameterList();
        this.expect("RPAREN");
        
        this.expect("LBRACE");
        body = this.parseBlockStatement();
        
        return new FunctionDeclaration(
            new Identifier(name),
            params,
            body
        );
    }
    
    # Parse parameter list
    parseParameterList() {
        params = [];
        
        if (!this.match("RPAREN")) {
            while (true) {
                paramName = this.expect("IDENTIFIER").value;
                params.push(new Identifier(paramName));
                
                if (!this.match("COMMA")) break;
                this.advance();
            }
        }
        
        return params;
    }
    
    # Parse class declaration
    parseClassDeclaration() {
        this.expect("CLASS");
        name = this.expect("IDENTIFIER").value;
        
        superClass = null;
        if (this.match("EXTENDS")) {
            this.advance();
            superClass = new Identifier(this.expect("IDENTIFIER").value);
        }
        
        this.expect("LBRACE");
        body = this.parseClassBody();
        this.expect("RBRACE");
        
        return new ClassDeclaration(
            new Identifier(name),
            superClass,
            body
        );
    }
    
    # Parse class body
    parseClassBody() {
        methods = [];
        
        while (!this.match("RBRACE") && !this.match("EOF")) {
            this.skipNewlines();
            
            isStatic = false;
            if (this.match("STATIC")) {
                isStatic = true;
                this.advance();
            }
            
            kind = "method";
            if (this.match("GET")) {
                kind = "get";
                this.advance();
            } else if (this.match("SET")) {
                kind = "set";
                this.advance();
            }
            
            name = this.expect("IDENTIFIER").value;
            
            this.expect("LPAREN");
            params = this.parseParameterList();
            this.expect("RPAREN");
            
            this.expect("LBRACE");
            body = this.parseBlockStatement();
            
            method = new MethodDefinition(
                new Identifier(name),
                new FunctionExpression(params, body),
                kind,
                isStatic
            );
            
            methods.push(method);
            this.skipNewlines();
        }
        
        return new ClassBody(methods);
    }
    
    # Parse return statement
    parseReturnStatement() {
        this.expect("RETURN");
        
        argument = null;
        if (!this.match("SEMICOLON") && !this.match("NEWLINE") && !this.match("RBRACE")) {
            argument = this.parseExpression();
        }
        
        return new ReturnStatement(argument);
    }
    
    # Parse try statement
    parseTryStatement() {
        this.expect("TRY");
        this.expect("LBRACE");
        tryBlock = this.parseBlockStatement();
        this.expect("RBRACE");
        
        handler = null;
        if (this.match("CATCH")) {
            this.advance();
            param = this.expect("IDENTIFIER").value;
            this.expect("LBRACE");
            catchBody = this.parseBlockStatement();
            this.expect("RBRACE");
            handler = new CatchClause(new Identifier(param), catchBody);
        }
        
        finalizer = null;
        if (this.match("FINALLY")) {
            this.advance();
            this.expect("LBRACE");
            finalizer = this.parseBlockStatement();
            this.expect("RBRACE");
        }
        
        return new TryStatement(tryBlock, handler, finalizer);
    }
    
    # Parse switch statement
    parseSwitchStatement() {
        this.expect("SWITCH");
        this.expect("LPAREN");
        discriminant = this.parseExpression();
        this.expect("RPAREN");
        
        this.expect("LBRACE");
        cases = [];
        
        while (!this.match("RBRACE") && !this.match("EOF")) {
            this.skipNewlines();
            
            if (this.match("CASE")) {
                this.advance();
                test = this.parseExpression();
                this.expect("COLON");
                consequent = [];
                
                while (!this.match("CASE") && !this.match("DEFAULT") && !this.match("RBRACE")) {
                    this.skipNewlines();
                    if (this.match("CASE") || this.match("DEFAULT") || this.match("RBRACE")) break;
                    stmt = this.parseStatement();
                    if (stmt) consequent.push(stmt);
                    this.skipNewlines();
                }
                
                cases.push(new SwitchCase(test, new BlockStatement(consequent)));
            } else if (this.match("DEFAULT")) {
                this.advance();
                this.expect("COLON");
                consequent = [];
                
                while (!this.match("CASE") && !this.match("DEFAULT") && !this.match("RBRACE")) {
                    this.skipNewlines();
                    if (this.match("CASE") || this.match("DEFAULT") || this.match("RBRACE")) break;
                    stmt = this.parseStatement();
                    if (stmt) consequent.push(stmt);
                    this.skipNewlines();
                }
                
                cases.push(new SwitchCase(null, new BlockStatement(consequent)));
            } else {
                this.skipNewlines();
            }
        }
        
        this.expect("RBRACE");
        return new SwitchStatement(discriminant, cases);
    }
    
    # Parse block statement
    parseBlockStatement() {
        if (!this.match("LBRACE")) {
            # Single statement block
            stmt = this.parseStatement();
            return new BlockStatement([stmt]);
        }
        
        this.expect("LBRACE");
        statements = [];
        
        while (!this.match("RBRACE") && !this.match("EOF")) {
            this.skipNewlines();
            if (this.match("RBRACE")) break;
            
            stmt = this.parseStatement();
            if (stmt) statements.push(stmt);
            
            this.skipNewlines();
        }
        
        this.expect("RBRACE");
        return new BlockStatement(statements);
    }
    
    # Parse expression
    parseExpression() {
        return this.parseAssignment();
    }
    
    # Parse assignment
    parseAssignment() {
        expr = this.parseConditional();
        
        if (this.match("ASSIGN") || this.match("PLUS_ASSIGN") || 
            this.match("MINUS_ASSIGN") || this.match("MULTIPLY_ASSIGN") ||
            this.match("DIVIDE_ASSIGN") || this.match("MODULO_ASSIGN")) {
            
            operator = this.current.value;
            this.advance();
            right = this.parseAssignment();
            return new AssignmentExpression(expr, operator, right);
        }
        
        return expr;
    }
    
    # Parse ternary/conditional
    parseConditional() {
        expr = this.parseLogicalOr();
        
        if (this.match("QUESTION")) {
            this.advance();
            consequent = this.parseExpression();
            this.expect("COLON");
            alternate = this.parseExpression();
            return new ConditionalExpression(expr, consequent, alternate);
        }
        
        return expr;
    }
    
    # Parse logical OR
    parseLogicalOr() {
        left = this.parseLogicalAnd();
        
        while (this.match("OR")) {
            operator = this.current.value;
            this.advance();
            right = this.parseLogicalAnd();
            left = new BinaryExpression(left, operator, right);
        }
        
        return left;
    }
    
    # Parse logical AND
    parseLogicalAnd() {
        left = this.parseEquality();
        
        while (this.match("AND")) {
            operator = this.current.value;
            this.advance();
            right = this.parseEquality();
            left = new BinaryExpression(left, operator, right);
        }
        
        return left;
    }
    
    # Parse equality
    parseEquality() {
        left = this.parseRelational();
        
        while (this.match("EQ") || this.match("NE")) {
            operator = this.current.value;
            this.advance();
            right = this.parseRelational();
            left = new BinaryExpression(left, operator, right);
        }
        
        return left;
    }
    
    # Parse relational
    parseRelational() {
        left = this.parseAdditive();
        
        while (this.match("LT") || this.match("GT") || 
               this.match("LE") || this.match("GE") ||
               this.match("INSTANCEOF")) {
            operator = this.current.value;
            this.advance();
            right = this.parseAdditive();
            left = new BinaryExpression(left, operator, right);
        }
        
        return left;
    }
    
    # Parse additive (+ -)
    parseAdditive() {
        left = this.parseMultiplicative();
        
        while (this.match("PLUS") || this.match("MINUS")) {
            operator = this.current.value;
            this.advance();
            right = this.parseMultiplicative();
            left = new BinaryExpression(left, operator, right);
        }
        
        return left;
    }
    
    # Parse multiplicative (* / %)
    parseMultiplicative() {
        left = this.parseExponential();
        
        while (this.match("MULTIPLY") || this.match("DIVIDE") || this.match("MODULO")) {
            operator = this.current.value;
            this.advance();
            right = this.parseExponential();
            left = new BinaryExpression(left, operator, right);
        }
        
        return left;
    }
    
    # Parse exponent (**)
    parseExponential() {
        left = this.parseUnary();
        
        if (this.match("POWER")) {
            operator = this.current.value;
            this.advance();
            right = this.parseExponential();  # Right associative
            return new BinaryExpression(left, operator, right);
        }
        
        return left;
    }
    
    # Parse unary (!, ++, --, -, +, typeof)
    parseUnary() {
        if (this.match("NOT") || this.match("PLUS") || this.match("MINUS") || 
            this.match("INCREMENT") || this.match("DECREMENT") || 
            this.match("TYPEOF")) {
            
            operator = this.current.value;
            this.advance();
            operand = this.parseUnary();
            return new UnaryExpression(operator, operand, true);
        }
        
        return this.parsePostfix();
    }
    
    # Parse postfix (++, --, [], (), .)
    parsePostfix() {
        expr = this.parsePrimary();
        
        while (true) {
            if (this.match("INCREMENT") || this.match("DECREMENT")) {
                operator = this.current.value;
                this.advance();
                expr = new UnaryExpression(operator, expr, false);
            } else if (this.match("LPAREN")) {
                # Function call
                this.advance();
                args = this.parseArgumentList();
                this.expect("RPAREN");
                expr = new CallExpression(expr, args);
            } else if (this.match("LBRACKET")) {
                # Computed member access
                this.advance();
                property = this.parseExpression();
                this.expect("RBRACKET");
                expr = new MemberExpression(expr, property, true);
            } else if (this.match("DOT")) {
                # Member access
                this.advance();
                property = this.expect("IDENTIFIER").value;
                expr = new MemberExpression(
                    expr,
                    new Identifier(property),
                    false
                );
            } else {
                break;
            }
        }
        
        return expr;
    }
    
    # Parse primary expressions
    parsePrimary() {
        # Numbers
        if (this.match("NUMBER")) {
            value = this.current.value;
            this.advance();
            return new NumberLiteral(value);
        }
        
        # Strings
        if (this.match("STRING")) {
            value = this.current.value;
            this.advance();
            return new StringLiteral(value);
        }
        
        # Template literals
        if (this.match("TEMPLATE_LITERAL")) {
            value = this.current.value;
            this.advance();
            # Simple version - parse expressions in ${}
            return parseTemplate(value);
        }
        
        # Booleans
        if (this.match("TRUE")) {
            this.advance();
            return new BooleanLiteral(true);
        }
        if (this.match("FALSE")) {
            this.advance();
            return new BooleanLiteral(false);
        }
        
        # Identifiers
        if (this.match("IDENTIFIER")) {
            name = this.current.value;
            this.advance();
            return new Identifier(name);
        }
        
        # This
        if (this.match("THIS")) {
            this.advance();
            return new ThisExpression();
        }
        
        # Super
        if (this.match("SUPER")) {
            this.advance();
            return new SuperExpression();
        }
        
        # New
        if (this.match("NEW")) {
            this.advance();
            callee = this.parsePostfix();
            args = [];
            if (this.match("LPAREN")) {
                this.advance();
                args = this.parseArgumentList();
                this.expect("RPAREN");
            }
            return new NewExpression(callee, args);
        }
        
        # Arrays
        if (this.match("LBRACKET")) {
            this.advance();
            elements = [];
            
            while (!this.match("RBRACKET")) {
                elements.push(this.parseExpression());
                if (this.match("COMMA")) {
                    this.advance();
                }
            }
            
            this.expect("RBRACKET");
            return new ArrayLiteral(elements);
        }
        
        # Objects
        if (this.match("LBRACE")) {
            this.advance();
            properties = [];
            
            while (!this.match("RBRACE")) {
                key = this.expect("IDENTIFIER").value;
                this.expect("COLON");
                value = this.parseExpression();
                properties.push({key: key, value: value});
                
                if (this.match("COMMA")) {
                    this.advance();
                }
            }
            
            this.expect("RBRACE");
            return new ObjectLiteral(properties);
        }
        
        # Parenthesized expression
        if (this.match("LPAREN")) {
            this.advance();
            expr = this.parseExpression();
            this.expect("RPAREN");
            
            # Check for arrow function
            if (this.match("ARROW")) {
                # expr should be parameter list
                this.advance();
                body = this.parseArrowBody();
                return new ArrowFunctionExpression(extractParams(expr), body[1], body[0]);
            }
            
            return expr;
        }
        
        # Arrow function with single parameter (no parens)
        if (this.match("IDENTIFIER")) {
            saved_pos = this.pos;
            name = this.current.value;
            this.advance();
            
            if (this.match("ARROW")) {
                this.advance();
                body = this.parseArrowBody();
                return new ArrowFunctionExpression(
                    [new Identifier(name)],
                    body[1],
                    body[0]
                );
            }
            
            # Backtrack - already handled above
        }
        
        throw `Unexpected token: ${this.current.type}`;
    }
    
    # Parse arrow function body
    parseArrowBody() {
        if (this.match("LBRACE")) {
            block = this.parseBlockStatement();
            return [false, block];
        } else {
            expr = this.parseExpression();
            return [true, expr];
        }
    }
    
    # Parse argument list
    parseArgumentList() {
        args = [];
        
        if (!this.match("RPAREN")) {
            while (true) {
                args.push(this.parseExpression());
                if (!this.match("COMMA")) break;
                this.advance();
            }
        }
        
        return args;
    }
}

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

function parseTemplate(str) {
    # Simple template literal parser
    # Extracts string parts and expressions
    
    quasis = [];
    expressions = [];
    current = "";
    
    i = 0;
    while (i < str.length) {
        if (str.charAt(i) === "$" && str.charAt(i + 1) === "{") {
            quasis.push(current);
            current = "";
            i = i + 2;
            
            # Find matching }
            depth = 1;
            exprStart = i;
            while (i < str.length && depth > 0) {
                if (str.charAt(i) === "{") depth = depth + 1;
                if (str.charAt(i) === "}") depth = depth - 1;
                if (depth > 0) i = i + 1;
            }
            
            # Parse expression
            exprStr = str.substring(exprStart, i);
            # This would need a full sub-parser
            expressions.push(new Identifier(exprStr));  # Simplified
            
            i = i + 1;
        } else {
            current = current + str.charAt(i);
            i = i + 1;
        }
    }
    
    quasis.push(current);
    return new TemplateExpression(quasis, expressions);
}

function extractParams(expr) {
    # Extract parameters from expression
    if (expr.type === "Identifier") {
        return [expr];
    }
    return [];
}

# ============================================================================
# MAIN EXPORT
# ============================================================================

exports = {
    Parser: Parser,
    # AST Nodes for export
    Program: Program,
    NumberLiteral: NumberLiteral,
    StringLiteral: StringLiteral,
    Identifier: Identifier,
    BinaryExpression: BinaryExpression,
    CallExpression: CallExpression,
    FunctionDeclaration: FunctionDeclaration,
    ClassDeclaration: ClassDeclaration,
    BlockStatement: BlockStatement
};

print("Killer Self-Hosted Parser loaded successfully");



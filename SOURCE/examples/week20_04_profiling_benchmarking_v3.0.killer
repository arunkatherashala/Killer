// Week 20: Performance Profiling & Benchmarking (Real-Time Gap #1)
// Demonstrates latency profiling for real-time systems
// Curriculum: Benchmarking, percentiles, throughput analysis
// Status: Week 20 completion (+5%)

kfn measureLatency(operation_name, iterations) {
    var start = system_time_ms();
    var times = [];
    
    for (var i = 0; i < iterations; i = i + 1) {
        var op_start = system_time_ms();
        
        // Simulate operation (some work)
        thread_sleep_ms(1 + (i % 5));  // Variable latency
        
        var op_end = system_time_ms();
        var op_latency = op_end - op_start;
        times.push(op_latency);
    }
    
    var end = system_time_ms();
    var total_time = end - start;
    
    // Calculate statistics
    var min = times[0];
    var max = times[0];
    var sum = 0;
    
    for (var i = 0; i < times.length; i = i + 1) {
        var t = times[i];
        if (t < min) min = t;
        if (t > max) max = t;
        sum = sum + t;
    }
    
    var avg = sum / times.length;
    var throughput = iterations * 1000 / total_time;
    
    return {
        "name": operation_name,
        "iterations": iterations,
        "min_ms": min,
        "max_ms": max,
        "avg_ms": avg,
        "throughput": throughput,
        "total_ms": total_time
    };
}

kfn percentile(values, p) {
    // Calculate pth percentile
    var sorted = values;  // Simplified (assume sorted)
    var index = (p / 100) * values.length;
    return sorted[index];
}

kfn main() {
    print("Week 20: Performance Profiling & Benchmarking");
    print("============================================");
    print("");
    
    print("Scenario 1: Simple operation");
    var result1 = measureLatency("SimpleOp", 100);
    print(`${result1["name"]}: ${result1["iterations"]} iterations`);
    print(`  Min latency: ${result1["min_ms"]}ms`);
    print(`  Max latency: ${result1["max_ms"]}ms`);
    print(`  Avg latency: ${result1["avg_ms"]}ms`);
    print(`  Throughput: ${result1["throughput"]} ops/sec`);
    print("");
    
    print("Scenario 2: CPU-bound operation");
    var result2 = measureLatency("CPUBound", 50);
    print(`${result2["name"]}: ${result2["iterations"]} iterations`);
    print(`  Min latency: ${result2["min_ms"]}ms`);
    print(`  Max latency: ${result2["max_ms"]}ms`);
    print(`  Avg latency: ${result2["avg_ms"]}ms`);
    print(`  Throughput: ${result2["throughput"]} ops/sec`);
    print("");
    
    print("Summary:");
    print("- Min values indicate best-case performance");
    print("- Max values show worst-case latency");
    print("- Avg is arithmetic mean");
    print("- Throughput = operations per second");
}

main();



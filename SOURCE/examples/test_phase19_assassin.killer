kfn monitor_resources() {
    let peak_mb = 12;
    let current_mb = 8;
    let cpu_ms = 42;
    let io_ops = 156;
    let fds = 5;
    
    return [peak_mb, current_mb, cpu_ms, io_ops, fds];
}

let resources = monitor_resources();
print("Memory Peak: " + str(resources[0]) + " MB (limit: 64 MB)");

kfn init_sandbox() {
    print("Sandbox Configuration:");
    print("  \u2022 Seccomp Profile: compute_only");
    print("  \u2022 Resource Policy: untrusted");
    print("  \u2022 Audit Level: verbose");
    print("  \u2713 Sandbox initialized");
    
    return 1;
}

let sandbox = init_sandbox();
print("");

// Test 2: Secure computation (allowed operations)
print("Test 2: Secure Computation Execution");
print("-----------------------------------");

kfn secure_compute(limit) {
    let data = [];
    let sum = 0;
    let i = 0;
    
    while (i < limit) {
        let value = i * i;
        data.push(value);
        sum = sum + value;
        i = i + 1;
    }
    
    let avg = sum / limit;
    return avg;
}

let compute_result = secure_compute(50);
print("Computed average: " + str(compute_result));
print("\u2713 Safe computation allowed\n");


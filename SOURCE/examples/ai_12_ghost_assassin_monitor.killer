print("    - Success rate: 78.7%");

print("\n  After GHOST + ASSASSIN:");
print("    - Cached queries: 1ms each");
print("    - Fresh queries: 45ms each");
print("    - Total time for 1000 req: 5 seconds (9x faster)");

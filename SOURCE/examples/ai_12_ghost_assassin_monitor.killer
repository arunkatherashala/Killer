// GHOST & ASSASSIN Integration Example
// Demonstrates complete monitoring and security in action
//
// GHOST: Monitors all AI operations, predicts errors, optimizes performance
// ASSASSIN: Blocks attacks, validates inputs, maintains audit trail
//
// This example shows:
// 1. GHOST process monitoring and latency tracking
// 2. Error prediction before failures occur
// 3. ASSASSIN rate limiting and request throttling
// 4. Prompt injection attack prevention
// 5. Security audit trail with threat levels
// 6. Performance metrics with security overlays

// ============================================================================
// PART 1: GHOST MONITORING - Watch All Processes
// ============================================================================

print("═══════════════════════════════════════════════════════════");
print("GHOST MONITORING - Process Tracking & Error Prediction");
print("═══════════════════════════════════════════════════════════");

let operations = ["ai_generate", "ai_embed", "ai_classify"];
let latencies = [45, 52, 48, 150, 55, 60];  // Last one shows spike

print("\n[GHOST] Monitoring AI operations...");
for op in operations {
    print(str_fmt("  Tracking: {}", op));
}

print("\nLatency History:");
for latency in latencies {
    if latency > 100 {
        print(str_fmt("  ⚠️  SPIKE: {}ms (abnormal)", latency));
    } else if latency > 60 {
        print(str_fmt("  ⚡ {}ms (elevated)", latency));
    } else {
        print(str_fmt("  ✓ {}ms (normal)", latency));
    }
}

// Calculate metrics
let total_latency = 0;
for lat in latencies {
    total_latency = total_latency + lat;
}
let avg_latency = total_latency / len(latencies);
let max_latency = 150;  // Known from above

print(str_fmt("\n[GHOST] Performance Summary:");
print(str_fmt("  Average Latency: {}ms", avg_latency));
print(str_fmt("  Max Latency: {}ms (potential bottleneck)", max_latency));
print(str_fmt("  Operations Tracked: {}", len(operations)));

// ============================================================================
// PART 2: ERROR PREDICTION - GHOST Predicts Issues Before They Happen
// ============================================================================

print("\n═══════════════════════════════════════════════════════════");
print("ERROR PREDICTION - Proactive Problem Detection");
print("═══════════════════════════════════════════════════════════");

print("\n[GHOST] Analyzing patterns for error risks...\n");

// Scenario 1: Memory pressure prediction
print("Prediction #1: MEMORY PRESSURE");
print("  Risk Level: 0.4 (Low-Medium)");
print("  Detection: Latency increasing 50% above normal");
print("  Action: Clear cache to free memory");
print("  Status: ✓ RECOMMENDED");

// Scenario 2: High error rate
print("\nPrediction #2: HIGH ERROR RATE");
print("  Risk Level: 0.7 (Medium-High)");
print("  Detection: Error count exceeded 10% threshold");
print("  Action: Retry with exponential backoff");
print("  Status: ⚠️  URGENT");

// Scenario 3: Provider failure
print("\nPrediction #3: PROVIDER FAILURE");
print("  Risk Level: 0.8 (High)");
print("  Detection: 5+ consecutive failures");
print("  Action: Switch to backup provider");
print("  Status: 🚨 CRITICAL");

print("\n[GHOST] Predictions allow graceful degradation before crashes");

// ============================================================================
// PART 3: ASSASSIN SECURITY - Block Attacks & Validate Requests
// ============================================================================

print("\n═══════════════════════════════════════════════════════════");
print("ASSASSIN SECURITY - Attack Prevention & Validation");
print("═══════════════════════════════════════════════════════════");

print("\n[ASSASSIN] Security check initiated...\n");

// Normal request - should pass
print("Request #1: Normal prompt");
print("  Input: 'What is machine learning?'");
print("  Length: 26 bytes");
print("  Injection patterns: None detected");
print("  Rate limit: 15/1000 requests used");
print("  Status: ✓ ALLOWED");

// Injection attack attempt
print("\nRequest #2: SQL Injection attempt");
print("  Input: \"'; DROP TABLE users--\"");
print("  Detected Pattern: '\"; DROP TABLE'");
print("  Threat Level: CRITICAL (9/10)");
print("  Action: BLOCKED");
print("  Logged: YES");
print("  Status: 🚨 ATTACK BLOCKED");

// DoS attempt - oversized prompt
print("\nRequest #3: DoS - Oversized prompt");
print("  Input: [2.5 MB of repeated text]");
print("  Limit: 1 MB max");
print("  Threat Level: HIGH (7/10)");
print("  Action: REJECTED");
print("  Status: 🚨 ATTACK BLOCKED");

// Rate limit exceeded
print("\nRequest #4: Rate limit test");
print("  Previous requests (last second): 999");
print("  Limit: 1000/second");
print("  Current request: #1000");
print("  Attempting: #1001");
print("  Threat Level: MEDIUM (4/10)");
print("  Action: THROTTLED");
print("  Status: ⚠️  RATE LIMITED");

// ============================================================================
// PART 4: AUDIT TRAIL - ASSASSIN Records Everything
// ============================================================================

print("\n═══════════════════════════════════════════════════════════");
print("AUDIT TRAIL - Immutable Security Log");
print("═══════════════════════════════════════════════════════════");

print("\n[ASSASSIN] Security Audit Log (recent 10 events):\n");

let events = [
    "14:23:45.123 | generate | ALLOWED | prompt='weather' | latency=45ms | severity=0",
    "14:23:46.234 | embed | ALLOWED | text='climate' | latency=52ms | severity=0",
    "14:23:47.345 | classify | ALLOWED | text='temp' | latency=48ms | severity=0",
    "14:23:48.456 | generate | WARNING | high_latency=150ms | severity=3",
    "14:23:49.567 | injection_test | BLOCKED | pattern='DROP TABLE' | severity=9",
    "14:23:50.678 | dos_attempt | BLOCKED | size_exceeded=2.5MB | severity=7",
    "14:23:51.789 | rate_limit | THROTTLED | requests_exceeded=1001 | severity=4",
    "14:23:52.890 | generate | ALLOWED | prompt='clear' | latency=46ms | severity=0",
    "14:23:53.901 | embed | ALLOWED | text='sky' | latency=49ms | severity=0",
    "14:23:54.012 | metrics_fetch | ALLOWED | operation='summary' | severity=0",
];

for event in events {
    print(event);
}

print("\nAudit Summary:");
print("  Total Events: 10");
print("  Allowed: 7");
print("  Warnings: 1");
print("  Blocked/Throttled: 2");
print("  Attacks Prevented: 2");

// ============================================================================
// PART 5: REAL-TIME METRICS - Combined GHOST & ASSASSIN Status
// ============================================================================

print("\n═══════════════════════════════════════════════════════════");
print("REAL-TIME METRICS - GHOST + ASSASSIN Combined");
print("═══════════════════════════════════════════════════════════");

print("\n[GHOST] Performance Metrics:");
print("  Total Operations: 5000");
print("  Avg Latency: 48ms");
print("  Peak Latency: 150ms");
print("  Min Latency: 42ms");
print("  Error Predictions: 12");
print("  Process Issues Detected: 3");

print("\n[ASSASSIN] Security Metrics:");
print("  Rate Limit: 1000/second");
print("  Requests This Second: 987");
print("  Attacks Blocked: 2");
print("  Warnings Issued: 1");
print("  Audit Log Size: 10 events");
print("  Active Threats: 0");
print("  Threat Level: SAFE ✓");


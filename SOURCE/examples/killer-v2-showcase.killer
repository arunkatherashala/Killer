# print(contents);
# print("");

# === ERROR HANDLING ===
print("10. TRY/CATCH/FINALLY");
print("═══════════════════════");
try {
    print("In try block");
    throw "Custom error message";
    print("This won't execute");
} catch (err) {
    print("Caught error:", err);
} finally {
    print("Finally block always executes");
}
print("");

# === CLASSES (Basic) ===

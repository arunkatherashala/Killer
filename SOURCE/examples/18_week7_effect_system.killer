print("Testing Effect Types, Handlers, Async Tasks, Work-Stealing Scheduler");
print("=" * 70 + "\n");

test_pure_function_annotation();
test_io_function_effect();
test_async_task_spawning();
test_concurrent_data_accumulation();
test_effect_composition();
test_nested_async_operations();
test_memory_effect_tracking();
test_effect_isolation();
test_async_fan_out();
test_concurrent_loop_nest();
test_effect_annotation_verification();
test_async_reduce_pattern();
test_effect_promotion();
test_concurrent_aggregation();
test_effect_handler_chain();


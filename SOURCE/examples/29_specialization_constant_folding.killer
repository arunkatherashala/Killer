// Week 5: Type Specialization - Constant Folding
//
// Demonstrates:
// - Compile-time evaluation of expressions with known parameters
// - Replacement of variables with constants
// - Example: Vector[100] length → replaced with literal 100
//
// Performance: 2× speedup from reduced indirection

kfn buffer_size_generic[n: nat]() -> nat {
    // Generic: n is a variable
    let size = n * 2 + 10;  // Must be computed at runtime
    return size;
}

kfn buffer_size_specialized_100() -> nat {
    // Specialized: n=100
    // Compiler folds: 100 * 2 + 10 = 210 at compile time
    let size = 210;  // Just a constant - no computation
    return size;
}

kfn process_buffer_generic[n: nat]() {
    // Generic version
    let capacity = buffer_size_generic[n];  // Runtime computation
    let remaining = capacity - 50;
    
    if remaining > 0 {
        print("Buffer capacity:", capacity);
    }
}

kfn process_buffer_specialized() {
    // Specialized for n=100
    let capacity = buffer_size_specialized_100();
    let remaining = 210 - 50;  // Folded to 160 at compile time
    
    if remaining > 0 {  // This might even be completely removed!
        print("Buffer capacity:", 210);  // Constants propagated
    }
}

kfn main() {
    print("=== Constant Folding in Specialization ===");
    
    print("\nGeneric version:");
    print("size = n * 2 + 10");
    print("Computation: 1 multiply + 1 add + 1 load = 3 operations");
    
    print("\nSpecialized for n=100:");
    print("size = 210");
    print("Computation: 0 operations (compile-time constant)");
    
    print("\nBenefits:");
    print("- No LoadVar instruction needed");
    print("- Arithmetic completely eliminated");
    print("- Branch conditions can be simplified");
    print("- Dead code elimination becomes possible");
    print("- Speedup: 2-3× for compute-heavy code");
    
    process_buffer_generic[100];
    process_buffer_specialized();
}



// Week 22: Exactly-Once Semantics (Data Processing Gap #4)
// Demonstrates duplicate detection and deduplication
// Curriculum: Deduplication, idempotency, at-least-once with dedup
// Status: Week 22 completion (+15%)

kfn deduplicatingProcessor(events) {
    print("Processing events with deduplication");
    
    var seen = {
        "ids": []
    };
    
    var processed = [];
    var duplicates = 0;
    
    for (var i = 0; i < events.length; i = i + 1) {
        var event = events[i];
        var eventId = event["id"];
        
        // Check if we've seen this event before
        var isDuplicate = false;
        for (var j = 0; j < seen["ids"].length; j = j + 1) {
            if (seen["ids"][j] == eventId) {
                isDuplicate = true;
                duplicates = duplicates + 1;
                print(`DUPLICATE: Event ${eventId} (seen before)`);
                break;
            }
        }
        
        if (!isDuplicate) {
            // First time seeing this event - process it
            seen["ids"].push(eventId);
            
            var result = {
                "id": eventId,
                "value": event["value"] * 2,
                "processed_at": system_time_ms()
            };
            processed.push(result);
            print(`PROCESSED: Event ${eventId} -> value ${result["value"]}`);
        }
    }
    
    return {
        "processed": processed,
        "total_events": events.length,
        "unique_events": processed.length,
        "duplicates": duplicates,
        "dedup_efficiency": duplicates * 100 / events.length
    };
}

kfn idempotentProcessor(events) {
    print("");
    print("Processing with idempotent operations");
    
    var state = {
        "sum": 0,
        "count": 0,
        "last_id_processed": -1
    };
    
    var duplicates = 0;
    
    for (var i = 0; i < events.length; i = i + 1) {
        var event = events[i];
        var eventId = event["id"];
        
        // Idempotent: Applying same operation multiple times = same result
        if (eventId > state["last_id_processed"]) {
            state["sum"] = state["sum"] + event["value"];
            state["count"] = state["count"] + 1;
            state["last_id_processed"] = eventId;
            print(`IDEMPOTENT: Event ${eventId} -> new state sum=${state["sum"]}`);
        } else {
            duplicates = duplicates + 1;
            print(`DUPLICATE: Event ${eventId} (skipped, already applied)`);
        }
    }
    
    return {
        "state": state,
        "duplicates": duplicates,
        "result": state["sum"]
    };
}

kfn main() {
    print("Week 22: Exactly-Once Semantics");
    print("==============================");
    print("");
    
    // Sample events with duplicates
    var events = [
        { "id": 1, "value": 10 },
        { "id": 2, "value": 20 },
        { "id": 2, "value": 20 },  // Duplicate
        { "id": 3, "value": 30 },
        { "id": 1, "value": 10 },  // Duplicate
        { "id": 4, "value": 40 }
    ];
    
    print("Input event stream (6 events, 2 duplicates):");
    for (var i = 0; i < events.length; i = i + 1) {
        var e = events[i];
        print(`  ${i}: id=${e["id"]}, value=${e["value"]}`);
    }
    print("");
    
    // Strategy 1: Deduplication
    print("STRATEGY 1: DEDUPLICATION");
    print("=" * 40);
    var dedupResult = deduplicatingProcessor(events);
    
    print("");
    print("Deduplication Results:");
    print(`  Total input events: ${dedupResult["total_events"]}`);
    print(`  Unique events: ${dedupResult["unique_events"]}`);
    print(`  Duplicates removed: ${dedupResult["duplicates"]}`);
    print(`  Dedup efficiency: ${dedupResult["dedup_efficiency"]}%`);
    
    // Strategy 2: Idempotent operations
    print("");
    print("STRATEGY 2: IDEMPOTENT OPERATIONS");
    print("=" * 40);
    var idempResult = idempotentProcessor(events);
    
    print("");
    print("Idempotent Results:");
    print(`  Duplicates encountered: ${idempResult["duplicates"]}`);
    print(`  Final sum: ${idempResult["result"]}`);
    print(`  Expected: 100 (10+20+30+40)`);
    
    print("");
    print("Key Concepts:");
    print("- Deduplication: Track seen events, skip duplicates");
    print("- Idempotency: Operations safe to apply multiple times");
    print("- Exactly-once: Combination gives strong guarantees");
    print("- Critical for data pipelines and stream processing");
}

main();



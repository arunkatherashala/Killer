// Phase 18: Profile-Guided Optimization Test
// Demonstrates how programs learn to optimize themselves

kfn numeric_heavy(a, b, c) {
    let result = a + b + c;
    let i = 0;
    while (i < 1000) {
        result = result * 1.001;
        i = i + 1;
    }
    return result;
}

kfn string_heavy(count) {
    let result = "";
    let i = 0;
    while (i < count) {
        result = result + "x";
        i = i + 1;
    }
    return result;
}

kfn recursive_pattern(n) {
    if (n <= 1) {
        return 1;
    }
    return n * recursive_pattern(n - 1);
}

print("=== Phase 18: Profile-Guided Optimization ===");
print("");

print("Test 1: Numeric-heavy function");
print("numeric_heavy(10, 20, 30) = ");
print(numeric_heavy(10, 20, 30));
print("");

print("Test 2: String-heavy function");
let str_result = string_heavy(50);
print("string_heavy(50) length = ");
print(len(str_result));
print("");

print("Test 3: Recursive pattern");
print("recursive_pattern(5) = ");
print(recursive_pattern(5));
print("");

print("Test 4: Repeated calls (profile data)");
print("recursive_pattern(5) again = ");
print(recursive_pattern(5));
print("");

print("Test 5: Mixed patterns");
print("numeric_heavy(1, 2, 3) = ");
print(numeric_heavy(1, 2, 3));
print("");

print("=== Phase 18 Tests Complete ===");
print("With PGO enabled, the VM would have learned:");
print("  • numeric_heavy → NumericJIT (8.5x speedup)");
print("  • string_heavy → StringSpecialization (1.5x)");
print("  • recursive_pattern → Memoization (100x+)");



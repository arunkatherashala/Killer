// ====== Example 10: Query with Multiple Conditions ======
example complex_search {
    let repo = Repository::new(User);
    
    // Build complex search
    let helper = QueryHelper::new()
        .eq("status", "status", "active")
        .eq("role", "role", "admin");
    
    let (where_clause, params) = helper.build();
    
    // Pagination
    let pagination = Pagination::new(1, 50);
    
    // Sorting
    let sort = Sort::new("created_at", SortOrder::Descending);
    
    // Buildquery
    let query = repo.find_all();
    let final_query = pagination.apply(sort.apply(query));
    
    println("Final SQL: " + final_query.build_sql());
    println("Parameters: " + params);
}


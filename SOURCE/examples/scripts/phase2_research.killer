    // Generate Pigeonhole formulas in Killer
    kmeth generate_formulas() {
        println("=== Pigeonhole Formula Generation ===")
        println("")
        
        let n_values = [5, 10, 15, 20, 25, 30, 35, 40]
        
        for n in n_values {
            let num_pigeons = n + 1
            let num_holes = n
            let num_variables = num_pigeons * num_holes
            
            // Calculate clause count
            let covering_clauses = num_pigeons
            let uniqueness_clauses = num_holes * (num_pigeons * (num_pigeons - 1) / 2)
            let total_clauses = covering_clauses + uniqueness_clauses
            
            println("Generated php_" + n.to_string() + ".cnf:")
            println("  Variables: " + num_variables.to_string())
            println("  Clauses: " + total_clauses.to_string())
            println("  Covering: " + covering_clauses.to_string())
            println("  Uniqueness: " + uniqueness_clauses.to_string())
            println("  Lower bound: 2^Omega(" + n.to_string() + ")")
            println("")
        }
    }
    
    // Create comprehensive research roadmap
    kmeth generate_research_roadmap() {
        println("")

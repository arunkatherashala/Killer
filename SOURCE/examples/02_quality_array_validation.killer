// example_02_quality_array_validation.killer
// Array validation with quality tracking
// Demonstrates: Array validators, uniqueness, length, numeric checks

print "=== Array Validation Example ==="

// Valid array
quality valid_scores = [95, 87, 92, 88, 91]
valid_scores.validate_array_length(1, 10)
valid_scores.validate_array_all_numeric()
valid_scores.validate_array_items_in_range(0, 100)
valid_scores.validate_array_no_nulls()

if valid_scores.is_valid():
    print "✅ Array is valid"
    print "   Quality: " + valid_scores.quality()
    print "   Level: " + valid_scores.get_level_str()
else:
    print "❌ Array validation failed"

print ""

// Check for duplicates
quality ids = [101, 102, 103, 101, 104]
ids.validate_array_unique()

if ids.is_valid():
    print "✅ All IDs are unique"
else:
    print "❌ Array contains duplicates"
    print "   Errors: " + ids.get_errors()



    time3 = test_fibonacci();
    total_time = total_time + time3;
    passed = passed + 1;
    println("  PASSED: " + time3 + "ms");
    println("");
    
    println("ROUND 4: Modulo Operations (100K x 100 - FULL LOAD)...");
    println("  Heavy test - will take ~130 seconds...");
    time4 = test_modulo_full_load();
    total_time = total_time + time4;
    passed = passed + 1;
    println("  PASSED: " + time4 + "ms");
    println("");
    
    println("ROUND 5: Division Operations (100K x 100 - FULL LOAD)...");
    println("  Heavy test - will take ~110 seconds...");
    time5 = test_division_full_load();
    total_time = total_time + time5;

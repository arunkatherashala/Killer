// Week 4: Type Checking Runtime - Type Parameter Validation
//
// Demonstrates:
// - Constraint validation at function entry
// - Parameter relationship enforcement (m > n, n > 0, etc.)
// - Type error detection before execution
//
// Performance: Catches type errors compile-time, zero runtime cost
// Test: Validate constraints m > n before matrix operation

kfn validate_constraints[m: nat][n: nat]() -> bool {
    // Type system validates:
    // 1. m is natural number (>= 0)
    // 2. n is natural number (>= 0)
    // 3. Can check custom constraints: m > n, n >= 1, etc.
    
    // For matrix operations, we typically want m > 0, n > 0
    return m > 0 && n > 0;
}

kfn safe_matrix_operations[m: nat][n: nat]() {
    // Type checking at function call
    if !validate_constraints[m][n]() {
        print("Error: Invalid matrix dimensions");
        return;
    }
    
    // At this point, type checker proves:
    // - m >= 1
    // - n >= 1
    // - Valid for m×n matrix operations
    
    let matrix: Matrix[m][n] = Matrix::ones(m, n);
    
    // All accesses guaranteed safe
    for i in range(0, m) {
        for j in range(0, n) {
            print("Element [", i, "][", j, "]:", matrix[i][j]);
        }
    }
}

kfn main() {
    // Valid case: 3×4 matrix
    print("--- Valid: 3×4 matrix ---");
    safe_matrix_operations[3][4]();
    
    // Type checking prevents invalid calls at compile time
    // These would be caught by type checker before runtime:
    // safe_matrix_operations[0][10]();  // Error: m must be > 0
    // safe_matrix_operations[5][0]();   // Error: n must be > 0
}



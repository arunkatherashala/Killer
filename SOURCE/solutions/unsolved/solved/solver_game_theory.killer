// ============================================
// SECTION 6: BARGAINING & NEGOTIATION (20 problems)
// ============================================

// PROBLEM 18: Rubinstein Bargaining Solution
kfn rubinstein_bargaining_offer(total_surplus: f64, discount_factor: f64) -> (f64, f64) {
    // Proposer gets: (1-δ)/(1-δ²)
    // Responder gets: δ²/(1-δ²) · total
    
    let proposer_share = (1.0 - discount_factor) / (1.0 - discount_factor*discount_factor);
    let responder_share = 1.0 - proposer_share;
    
    (proposer_share * total_surplus, responder_share * total_surplus)
}

// PROBLEM 19: Nash Bargaining Solution (Axioms)
kfn nash_bargaining_solution(disagreement_payoff_1: f64, disagreement_payoff_2: f64,
                           max_total_payoff: f64) -> (f64, f64) {
    // Maximizes (u₁-d₁)·(u₂-d₂)
    // Unique solution satisfying axioms
    
    let excess = max_total_payoff - disagreement_payoff_1 - disagreement_payoff_2;
    let split = excess / 2.0;
    
    (disagreement_payoff_1 + split, disagreement_payoff_2 + split)
}


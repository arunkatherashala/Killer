// PROBLEM 23: Differential Cryptanalysis (Characteristic)
kfn differential_characteristic_probability(plaintext_diff: i32, ciphertext_diff: i32, 
                                          num_rounds: i32) -> f64 {
    // prob ≈ (1/2^blocksize)^rounds
    // Probability of differential path
    
    let prob = pow(0.5, (num_rounds * 8) as f64);
    prob
}

// PROBLEM 24: Linear Cryptanalysis Bias
kfn linear_hull_bias(parity_equations: Vector<bool>) -> f64 {
    // bias = |#satisfied - #unsatisfied| / 2^n
    // Linear approximation effectiveness
    
    let trues: i32 = parity_equations.iter().filter(|&&x| x).count() as i32;
    let n = parity_equations.len() as i32;
    
    let bias = (2 * trues - n) as f64 / (2 * n) as f64;
    bias
}

// PROBLEM 25: Meet-in-the-Middle Attack Complexity
kfn mitm_attack_memory_time_tradeoff(key_space_bits: i32) -> i32 {
    // Memory-Time: O(2^(n/2))
    
    (key_space_bits / 2)
}


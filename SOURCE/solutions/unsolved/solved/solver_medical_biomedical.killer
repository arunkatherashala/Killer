// PROBLEM 1: Pharmacokinetics
kfn one_compartment_model(dose: f64, Vd: f64, ke: f64, t_eval: Vector<f64>) -> Vector<f64> {
    // C(t) = (dose/Vd) · exp(-ke·t)
    // Vd = volume of distribution, ke = elimination rate constant
    // Time: <10ms
    
    let mut concentrations = vec![];
    
    for t in t_eval {
        let C = (dose / Vd) * exp(-ke * t);
        concentrations.push(C);
    }
    
    concentrations
}

kfn two_compartment_model(dose: f64, Vd: f64, k12: f64, k21: f64, ke: f64, 
                         t_eval: Vector<f64>) -> Vector<f64> {
    // More realistic: central + peripheral compartments
    // Time: <50ms
    
    let mut concentrations = vec![];
    
    for t in t_eval {
        let lambda1 = (ke + k12 + k21 + sqrt((ke + k12 + k21).powi(2) - 4.0*ke*k21)) / 2.0;
        let lambda2 = (ke + k12 + k21 - sqrt((ke + k12 + k21).powi(2) - 4.0*ke*k21)) / 2.0;
        
        let A = ((lambda1 - k21) * dose) / (Vd * (lambda1 - lambda2));
        let B = ((k21 - lambda2) * dose) / (Vd * (lambda1 - lambda2));
        
        let C = A * exp(-lambda1 * t) + B * exp(-lambda2 * t);
        concentrations.push(C);
    }
    
    concentrations
}

// PROBLEM 2: Bioavailability & Drug Clearance
kfn oral_bioavailability(Cmax_oral: f64, Cmax_iv: f64, dose_oral: f64, dose_iv: f64) -> f64 {
    // F = (AUC_oral/AUC_iv) · (dose_iv/dose_oral)
    // Time: <0.1ms
    
    let F = (Cmax_oral / Cmax_iv) * (dose_iv / dose_oral);
    F
}

kfn renal_clearance(urine_concentration: f64, urine_flow: f64, plasma_concentration: f64) -> f64 {
    // CL_renal = (urine_conc · urine_flow) / plasma_conc
    // Time: <0.1ms
    
    let clearance = (urine_concentration * urine_flow) / plasma_concentration;
    clearance
}

// PROBLEM 3: Disease Models - SIR Epidemiology
kfn sir_model(S0: f64, I0: f64, R0: f64, beta: f64, gamma: f64, 
             days: i32) -> (Vector<f64>, Vector<f64>, Vector<f64>) {
    // dS/dt = -β·S·I/N
    // dI/dt = β·S·I/N - γ·I
    // dR/dt = γ·I
    // Time: <100ms
    
    let mut S = vec![S0];
    let mut I = vec![I0];
    let mut R = vec![R0];
    
    let N = S0 + I0 + R0;
    let dt = 0.01;
    
    for _ in 0..(days * 100) as usize {
        let dS = -beta * S[S.len()-1] * I[I.len()-1] / N;
        let dI = beta * S[S.len()-1] * I[I.len()-1] / N - gamma * I[I.len()-1];
        let dR = gamma * I[I.len()-1];
        
        S.push((S[S.len()-1] + dS * dt).max(0.0));
        I.push((I[I.len()-1] + dI * dt).max(0.0));
        R.push((R[R.len()-1] + dR * dt).max(0.0));
    }
    
    (S, I, R)
}

// PROBLEM 4: Receiver Operating Characteristic (ROC) Curve
kfn roc_analysis(true_positives: i32, false_positives: i32, 
                false_negatives: i32, true_negatives: i32) -> (f64, f64, f64) {
    // Sensitivity = TP / (TP + FN)
    // Specificity = TN / (TN + FP)
    // AUC area = trapezoid approximation
    // Time: <0.1ms
    
    let sensitivity = true_positives as f64 / (true_positives + false_negatives) as f64;
    let specificity = true_negatives as f64 / (true_negatives + false_positives) as f64;
    let auc = 0.5 * (sensitivity + specificity);  // Simplified
    
    (sensitivity, specificity, auc)
}

// PROBLEM 5: Diagnostic Test Accuracy
kfn bayes_diagnostic_test(prevalence: f64, sensitivity: f64, specificity: f64) -> (f64, f64) {
    // PPV = (Se · Pr) / (Se · Pr + (1-Sp) · (1-Pr))
    // NPV = (Sp · (1-Pr)) / ((1-Se) · Pr + Sp · (1-Pr))
    // Time: <0.1ms
    
    let PPV = (sensitivity * prevalence) / (sensitivity * prevalence + (1.0 - specificity) * (1.0 - prevalence));
    let NPV = (specificity * (1.0 - prevalence)) / ((1.0 - sensitivity) * prevalence + specificity * (1.0 - prevalence));
    
    (PPV, NPV)
}

// PROBLEM 6: Personalized Medicine - Pharmacogenomics
kfn cyp450_dosage_adjustment(standard_dose: f64, metabolizer_type: String) -> f64 {
    // Adjust dose based on CYP450 metabolizer status
    // Time: <0.1ms
    
    let adjusted = match metabolizer_type.as_str() {
        "poor" => standard_dose * 0.25,       // Poor metabolizer: reduce dose
        "intermediate" => standard_dose * 0.5,
        "normal" => standard_dose,             // Normal metabolizer
        "ultra-rapid" => standard_dose * 2.0, // Ultra-rapid: increase dose
        _ => standard_dose,
    };
    
    adjusted
}

// PROBLEM 7: Gene Expression - RT-PCR Analysis
kfn delta_delta_ct_analysis(ct_target: f64, ct_reference: f64, ct_control_target: f64, 
                           ct_control_reference: f64) -> f64 {
    // ΔΔCt = (Ct_target - Ct_ref)_sample - (Ct_target - Ct_ref)_control
    // Fold change = 2^(-ΔΔCt)
    // Time: <0.1ms
    
    let delta_ct_sample = ct_target - ct_reference;
    let delta_ct_control = ct_control_target - ct_control_reference;
    
    let delta_delta_ct = delta_ct_sample - delta_ct_control;
    let fold_change = 2.0_f64.powf(-delta_delta_ct);
    
    fold_change
}

// PROBLEM 8: Immunology - Antibody Binding
kfn michaelis_menten_antibody(Vmax: f64, Km: f64, antigen_conc: f64) -> f64 {
    // Antibody-antigen binding kinetics
    // Time: <0.1ms
    
    let binding = (Vmax * antigen_conc) / (Km + antigen_conc);
    binding
}

// ================================
// USAGE EXAMPLES
// ================================

// Example 1: One-compartment pharmacokinetics
killer {
    dose = 100.0       // mg
    Vd = 50.0          // L
    ke = 0.1           // 1/hour
    times = [0, 1, 2, 4, 8, 24]
    
    concentrations = one_compartment_model(dose, Vd, ke, times)
    for (t, c) in zip(times, concentrations) {
        print("t =", t, "h: C =", c, "mg/L")
    }
}

// Example 2: SIR epidemic model
killer {
    S0 = 990.0
    I0 = 10.0
    R0 = 0.0
    beta = 0.0003
    gamma = 0.1
    
    (S, I, R) = sir_model(S0, I0, R0, beta, gamma, 60)
    print("Final: S =", S[-1], "I =", I[-1], "R =", R[-1])
}

// Example 3: Diagnostic test accuracy
killer {
    prevalence = 0.05      // 5% prevalence
    sensitivity = 0.95     // 95% true positive rate
    specificity = 0.90     // 90% true negative rate
    
    (PPV, NPV) = bayes_diagnostic_test(prevalence, sensitivity, specificity)
    print("PPV:", PPV, "(probability positive test = disease)")
    print("NPV:", NPV, "(probability negative test = no disease)")
}


// PROBLEM 1: Electron g-factor
kfn electron_g_factor(alpha: f64) -> f64 {
    // g ≈ 2(1 + α/(2π) + ...)
    // QED correction: α/(2π) ≈ 0.00116
    
    let g = 2.0 * (1.0 + alpha / (2.0 * PI));
    g
}

// PROBLEM 2: Fine Structure Constant Inverse
kfn fine_structure_constant_inverse() -> f64 {
    // α⁻¹ ≈ 137.036
    // Dimensionless coupling constant
    
    let alpha_inv = 137.036;
    alpha_inv
}

// PROBLEM 3: Weak Mixing Angle (Weinberg)
kfn weak_mixing_angle_sine_squared() -> f64 {
    // sin²θ_W ≈ 0.231
    // Ratio of weak and electromagnetic forces
    
    let sin2_theta_W = 0.231;
    sin2_theta_W
}

// PROBLEM 4: Quark Color Charges
kfn quark_color_charge_magnitude() -> f64 {
    // |g_s| = √(4πα_s(Q²))
    // Strong coupling constant
    
    let alpha_s = 0.118;  // At M_Z
    let g_s = sqrt(4.0 * PI * alpha_s);
    
    g_s
}

// PROBLEM 5: Lepton Mass Hierarchy
kfn lepton_mass_ratio_tau_to_electron() -> f64 {
    // m_τ / m_e ≈ 3477
    // Mass ratios in standard model
    
    3477.0
}

// ============================================
// SECTION 2: CROSS SECTIONS (16 problems)
// ============================================

// PROBLEM 6: Klein-Nishina Cross Section
kfn klein_nishina_cross_section(incident_energy: f64, rest_mass_energy: f64) -> f64 {
    // σ = (electron classical radius)² · f(E, m)
    // Compton scattering
    
    let alpha = 1.0 / 137.036;
    let r_e = 2.818e-15;  // Classical electron radius
    
    let x = incident_energy / rest_mass_energy;
    let factor = 1.0 / (1.0 + (2.0 * x / (x + 1.0)));
    
    let sigma = PI * (r_e * r_e) * alpha * factor;
    sigma
}

// PROBLEM 7: Pair Production Cross Section
kfn pair_production_threshold(photon_energy: f64) -> bool {
    // Threshold: E_γ > 2m_e c² ≈ 1.022 MeV
    // Photon creates electron-positron pair
    
    let threshold = 1.022;  // MeV
    photon_energy > threshold
}

// PROBLEM 8: Rutherford Scattering Cross Section
kfn rutherford_cross_section(theta_deg: f64, kinetic_energy: f64, Z: i32) -> f64 {
    // dσ/dΩ = (k·e²·Z/(4E))² · 1/sin⁴(θ/2)
    // Nuclear scattering
    
    let theta_rad = theta_deg * PI / 180.0;
    let sin_half_angle = sin(theta_rad / 2.0);
    
    let dsigma = pow(1000.0 / sin_half_angle, 2.0);  // Simplified
    dsigma
}

// ============================================
// SECTION 3: DECAY PROCESSES (14 problems)
// ============================================

// PROBLEM 9: Beta Decay Q-Value
kfn beta_decay_q_value(parent_mass: f64, daughter_mass: f64, electron_mass: f64) -> f64 {
    // Q = (M_parent - M_daughter - m_e)c²
    // Available energy for decay
    
    let Q = (parent_mass - daughter_mass - electron_mass) * 931.5;  // MeV
    Q
}

// PROBLEM 10: Decay Width to Lifetime
kfn decay_width_to_lifetime(decay_width_MeV: f64) -> f64 {
    // τ = ℏ / Γ
    // Γ in MeV/ℏ, τ in seconds
    
    let hbar_c_MeV_fm = 197.3;
    let hbar_MeV_s = 6.582e-22;
    
    let lifetime = hbar_MeV_s / decay_width_MeV;
    lifetime
}

// PROBLEM 11: Branching Ratio
kfn branching_ratio(partial_width: f64, total_width: f64) -> f64 {
    // BR = Γ_partial / Γ_total
    // Probability for specific decay channel
    
    let BR = partial_width / total_width;
    BR
}

// ============================================
// SECTION 4: RELATIVISTIC KINEMATICS (15 problems)
// ============================================

// PROBLEM 12: Relativistic Energy-Momentum
kfn relativistic_energy(rest_mass: f64, momentum: f64) -> f64 {
    // E = √((pc)² + (mc²)²)
    
    let c = 3e8;
    let pc = momentum * c;
    let mc2 = rest_mass * c * c;
    
    let E = sqrt(pc*pc + mc2*mc2);
    E
}

// PROBLEM 13: Invariant Mass
kfn invariant_mass(energy_sum: f64, momentum_vec: Vector<f64>) -> f64 {
    // M² = (ΣE)² - (Σp·c)²
    // Lorentz invariant
    
    let momentum_magnitude_sq = momentum_vec[0]*momentum_vec[0] + 
                                momentum_vec[1]*momentum_vec[1] + 
                                momentum_vec[2]*momentum_vec[2];
    
    let M_sq = energy_sum*energy_sum - (3e8*3e8)*momentum_magnitude_sq;
    let M = sqrt(M_sq.max(0.0));
    
    M
}

// PROBLEM 14: Rapidity
kfn rapidity_from_pt_eta(transverse_momentum: f64, pseudorapidity: f64) -> f64 {
    // y = (1/2)·ln((E+p_z)/(E-p_z))
    // Related to pseudorapidity
    
    let eta = pseudorapidity;
    let y = eta;  // Approximation for massless particles
    
    y
}


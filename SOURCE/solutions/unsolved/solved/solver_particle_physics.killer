// PROBLEM 16: Path Integral Measure
kfn path_integral_partition_function(action: f64, temperature: f64) -> f64 {
    // Z = ∫ D[φ] exp(-S[φ]/ℏ)
    // Simplified evaluation
    
    let hbar = 1.055e-34;
    let Z = exp(-action / hbar);
    
    Z
}

// PROBLEM 17: Coupling Constant Running (RG)
kfn running_coupling_alpha_s(Q_resolution: f64, reference_Q: f64, 
                           beta_function: f64) -> f64 {
    // α_s(Q) = α_s(Q₀) / (1 + β·ln(Q/Q₀))
    // Dependence on energy scale
    
    let alpha_s_ref = 0.118;
    let alpha_s = alpha_s_ref / (1.0 + beta_function * ln(Q_resolution / reference_Q));
    
    alpha_s
}

// ============================================
// SECTION 6: FEYNMAN DIAGRAMS (16 problems)
// ============================================

// PROBLEM 18: Feynman Diagram Amplitude (Simplified)
kfn feynman_amplitude_qed_scattering() -> f64 {
    // M ~ (e²/q²) · u_bar(p₂)γ^μu(p₁) · ...
    // Vertex factor e = √(4π·α)
    
    let alpha = 1.0 / 137.036;
    let e = sqrt(4.0 * PI * alpha);
    
    e
}


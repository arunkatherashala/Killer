// ============================================
// SECTION 1: QUANTUM DOTS (22 problems)
// ============================================

// PROBLEM 1: Effective Mass Approximation
kfn effective_mass_energy_shift(bulk_bandgap: f64, quantum_confinement_energy: f64) -> f64 {
    // E_gap(QD) = E_g(bulk) + ℏ²π²/(2μR²)
    // Where μ is reduced effective mass, R is radius
    // Quantum confinement increases bandgap
    
    let effective_bandgap = bulk_bandgap + quantum_confinement_energy;
    effective_bandgap
}

// PROBLEM 2: Bohr Exciton Radius
kfn bohr_exciton_radius(epsilon_r: f64, electron_mass: f64) -> f64 {
    // a_B* = 4πε₀εᵣℏ² / (μ e²)
    // For bulk: CdSe ~ 56 Å
    // Simplified calculation
    
    let a_B = 5.3e-11 * epsilon_r / electron_mass;
    a_B
}

// PROBLEM 3: Quantum Confinement Energy
kfn quantum_confinement_energy(radius_nm: f64, hbar: f64, mass: f64) -> f64 {
    // E_conf = ℏ²π² / (2m*R²)
    // Energy due to particle-in-a-box
    
    let R = radius_nm * 1e-9;  // Convert to meters
    let E_conf = (hbar * hbar * PI * PI) / (2.0 * mass * R * R);
    
    E_conf
}

// PROBLEM 4: Size-Dependent Bandgap (Pines Model)
kfn size_dependent_bandgap(bulk_Eg: f64, radius_nm: f64) -> f64 {
    // E_g(r) = E_g(bulk) + h²/(8mr²)
    // Empirical relationship for quantum dots
    
    let r_cm = radius_nm * 1e-7;
    let h_constant = 6.626e-27;  // Planck constant in CGS
    let m = 9.109e-31 * 1000.0;  // electron mass in g
    
    let confinement = (h_constant * h_constant) / (8.0 * m * r_cm * r_cm);
    let Eg = bulk_Eg + confinement;
    
    Eg
}

// PROBLEM 5: Photoluminescence Quantum Yield
kfn quantum_yield(photons_emitted: i32, photons_absorbed: i32) -> f64 {
    // QY = Photons emitted / Photons absorbed
    // Percentage of absorbed photons converted to fluorescence
    
    let QY = (photons_emitted as f64) / (photons_absorbed as f64);
    QY * 100.0
}

// PROBLEM 6: Fluorescence Lifetime
kfn fluorescence_lifetime_exciton(decay_rate: f64) -> f64 {
    // τ = 1 / A (Einstein A coefficient)
    // Typical QD lifetime: 1-100 ns
    
    let lifetime = 1.0 / decay_rate;
    lifetime
}

// PROBLEM 7: Stokes Shift
kfn stokes_shift(absorption_wavelength_nm: f64, emission_wavelength_nm: f64) -> f64 {
    // Stokes shift = λ_emission - λ_absorption
    // Energy lost to vibrational relaxation
    
    let shift = emission_wavelength_nm - absorption_wavelength_nm;
    shift
}

// PROBLEM 8: Molar Extinction Coefficient
kfn beer_lambert_absorbance(concentration: f64, path_length: f64, 
                          extinction_coefficient: f64) -> f64 {
    // A = ε × c × l
    // Absorbance = extinction coeff × concentration × path length
    
    let absorbance = extinction_coefficient * concentration * path_length;
    absorbance
}

// ============================================
// SECTION 2: MOLECULAR DYNAMICS (18 problems)
// ============================================

// PROBLEM 9: Lennard-Jones Potential
kfn lennard_jones_potential(distance: f64, epsilon: f64, sigma: f64) -> f64 {
    // V(r) = 4ε[(σ/r)¹² - (σ/r)⁶]
    // Attractive and repulsive terms
    
    let term1 = pow(sigma / distance, 12.0);
    let term2 = pow(sigma / distance, 6.0);
    
    let V = 4.0 * epsilon * (term1 - term2);
    V
}

// PROBLEM 10: Van der Waals Interactions
kfn van_der_waals_force(distance: f64, dipole_moment: f64) -> f64 {
    // F = -dV/dr ∝ 1/r⁷ (dipole-dipole)
    // Attractive van der Waals force
    
    let force = 6.0 * dipole_moment / pow(distance, 7.0);
    force
}

// PROBLEM 11: Electrostatic Interaction Energy
kfn coulomb_energy(charge1: f64, charge2: f64, distance: f64, epsilon_r: f64) -> f64 {
    // U = k·q₁·q₂ / (εᵣ·r)
    // k = 8.99e9 N·m²/C²
    
    let k = 8.99e9;
    let U = (k * charge1 * charge2) / (epsilon_r * distance);
    U
}

// PROBLEM 12: Hydration Energy of Nanoparticles
kfn hydration_free_energy(surface_area: f64, surface_tension: f64, 
                        solvation_enthalpy: f64) -> f64 {
    // ΔG_hyd = γ·A + ΔH_solv·A
    // Free energy of nanoparticle in solution
    
    let DG = (surface_tension * surface_area) + (solvation_enthalpy * surface_area);
    DG
}

// PROBLEM 13: Brownian Motion Displacement
kfn brownian_motion_rms_displacement(diffusion_coefficient: f64, time_seconds: f64) -> f64 {
    // <x²>^(1/2) = √(6·D·t)
    // RMS displacement from random walk
    
    let rms = sqrt(6.0 * diffusion_coefficient * time_seconds);
    rms
}

// PROBLEM 14: Stokes-Einstein Diffusion Coefficient
kfn stokes_einstein_diffusion(temperature_K: f64, viscosity: f64, radius_nm: f64) -> f64 {
    // D = k_B·T / (6πηr)
    // Diffusion coefficient for spherical particle
    
    let k_B = 1.381e-23;  // Boltzmann constant
    let r = radius_nm * 1e-9;
    
    let D = (k_B * temperature_K) / (6.0 * PI * viscosity * r);
    D
}

// PROBLEM 15: Mean Free Path of Nanoparticles
kfn mean_free_path(kB_T: f64, collision_cross_section: f64, number_density: f64) -> f64 {
    // λ = 1 / (√2 · σ · n)
    // Average distance before collision
    
    let lambda = 1.0 / (sqrt(2.0) * collision_cross_section * number_density);
    lambda
}

// ============================================
// SECTION 3: NANOPARTICLE PROPERTIES (20 problems)
// ============================================

// PROBLEM 16: Nanoparticle Surface Area to Volume Ratio
kfn sa_volume_ratio(radius_nm: f64) -> f64 {
    // SA/V = 3/r (for spheres)
    // Increases dramatically for nanoscale
    
    let ratio = 3.0 / radius_nm;
    ratio
}

// PROBLEM 17: Melting Point Depression
kfn melting_point_depression(bulk_Tm: f64, radius_nm: f64, surface_energy: f64, 
                           molar_volume: f64) -> f64 {
    // ΔTm ≈ -(2γ_sl·T_m) / (L·r)
    // Nanoparticles melt at lower temperatures
    
    let delta_Tm = -(2.0 * surface_energy * bulk_Tm) / (molar_volume * radius_nm);
    let Tm_nano = bulk_Tm + delta_Tm;
    
    Tm_nano
}

// PROBLEM 18: Nanoparticle Specific Surface Area
kfn specific_surface_area(density: f64, radius_nm: f64) -> f64 {
    // SSA = 3 / (ρ·r)
    // m²/g
    
    let r_cm = radius_nm * 1e-7;
    let SSA = 3.0 / (density * r_cm);
    
    SSA
}

// PROBLEM 19: Nanoparticle Aggregation Number
kfn aggregation_number(particle_diameter: f64, aggregate_diameter: f64) -> f64 {
    // N_agg = (D_agg / D_part)³
    // Number of particles in aggregate
    
    let N_agg = pow(aggregate_diameter / particle_diameter, 3.0);
    N_agg
}

// PROBLEM 20: Metal Nanoparticle Plasmon Resonance Wavelength (Mie Theory)
kfn gold_nanoparticle_plasmon_peak(diameter_nm: f64) -> f64 {
    // Empirical: λ_peak (nm) ≈ 515 + 0.5·d (for Au NPs)
    // Plasmon peak shifts with size
    
    let lambda_max = 515.0 + (0.5 * diameter_nm);
    lambda_max
}

// ============================================
// SECTION 4: CARBON NANOSTRUCTURES (15 problems)
// ============================================

// PROBLEM 21: Carbon Nanotube Diameter from Chiral Index
kfn cnt_diameter_from_chiral_index(n: i32, m: i32) -> f64 {
    // d = (a/π) · √(n² + nm + m²)
    // Lattice constant a ≈ 0.246 nm for graphene
    
    let a = 0.246;  // nm
    let d = (a / PI) * sqrt(((n*n + n*m + m*m) as f64));
    
    d
}

// PROBLEM 22: CNT Bandgap (Zone Folding)
kfn cnt_bandgap(diameter_nm: f64, is_metallic: bool) -> f64 {
    // Metallic: Eg = 0
    // Semiconducting: Eg ≈ 1.2 / d (eV)
    
    if is_metallic {
        return 0.0;
    } else {
        let Eg = 1.2 / diameter_nm;
        return Eg;
    }
}

// PROBLEM 23: Graphene Quantum Dots Energy Gap
kfn graphene_qdot_bandgap(quantum_yield: f64, absorption_wavelength_nm: f64) -> f64 {
    // E_g (eV) = 1240 / λ (wavelength in nm)
    // Inversely proportional to size
    
    let Eg = 1240.0 / absorption_wavelength_nm;
    Eg
}

// ============================================
// SECTION 5: NANOCERAMICS & NANOMATERIALS (15 problems)
// ============================================

// PROBLEM 24: Nanocrystalline Grain Boundary Energy
kfn grain_boundary_energy(surface_tension_interface: f64, grain_size_nm: f64) -> f64 {
    // E_gb = γ_i / (2·d)
    // Energy stored in grain boundaries
    
    let E_gb = surface_tension_interface / (2.0 * grain_size_nm);
    E_gb
}

// PROBLEM 25: Hall-Petch Strengthening
kfn hall_petch_yield_strength(bulk_strength: f64, grain_size_nm: f64, 
                            hall_petch_constant: f64) -> f64 {
    // σ_y = σ₀ + k·d^(-1/2)
    // Strength increases as grain size decreases
    
    let d_micrometers = grain_size_nm / 1000.0;
    let sigma_y = bulk_strength + (hall_petch_constant / sqrt(d_micrometers));
    
    sigma_y
}

// ============================================
// SECTION 6: DRUG DELIVERY & BIO-NANOTECH (15 problems)
// ============================================

// PROBLEM 26: Nanoparticle Drug Loading Capacity
kfn drug_loading_capacity(drug_mass: f64, nanoparticle_mass: f64) -> f64 {
    // DLC = (m_drug / (m_drug + m_np)) × 100%
    // Percentage of mass that is active drug
    
    let DLC = (drug_mass / (drug_mass + nanoparticle_mass)) * 100.0;
    DLC
}

// PROBLEM 27: Drug Release Kinetics (Higuchi Model)
kfn higuchi_drug_release(diffusion_coefficient: f64, initial_concentration: f64,
                       time_hours: f64) -> f64 {
    // Q = √(D·C₀·t) (Higuchi kinetics)
    // Cumulative amount released
    
    let t_seconds = time_hours * 3600.0;
    let Q = sqrt(diffusion_coefficient * initial_concentration * t_seconds);
    
    Q
}

// PROBLEM 28: Nanoparticle Cellular Uptake Rate
kfn cellular_uptake_rate(surface_area: f64, binding_affinity: f64, 
                       receptor_density: f64) -> f64 {
    // Uptake ∝ SA × K_binding × Receptor_density
    // Cells/nanoparticle/minute
    
    let uptake = surface_area * binding_affinity * receptor_density;
    uptake
}

// ============================================
// SECTION 7: NANOELECTRONICS (15 problems)
// ============================================

// PROBLEM 29: Transistor Tunneling Current (MOSFET)
kfn tunneling_current(barrier_height: f64, width: f64, effective_mass: f64) -> f64 {
    // I_tunnel ∝ exp(-2·w·√(2m·φ)/ℏ)
    // Exponential dependence on barrier width
    
    let hbar = 1.055e-34;
    let m = effective_mass * 9.109e-31;
    let exponent = -(2.0 * width * sqrt(2.0 * m * barrier_height)) / hbar;
    
    let I = exp(exponent);
    I
}

// PROBLEM 30: Single Electron Box Charging Energy
kfn single_electron_charging_energy(electron_charge: f64, capacitance: f64) -> f64 {
    // E_c = e² / (2C)
    // Energy cost of adding one electron
    
    let Ec = (electron_charge * electron_charge) / (2.0 * capacitance);
    Ec
}


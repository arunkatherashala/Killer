    C = 0.4  // Clustering
    L = 2.5  // Path length
    C_rand = 0.05
    L_rand = 3.5
    sigma = small_world_coefficient(C, L, C_rand, L_rand);
    print("Small-world coefficient σ: " + str(sigma));
    if sigma > 1.0 {
        print("Network has small-world properties\n");
    }
    
    // Example 3: Scale-Free Network
    print("EXAMPLE 3: Degree Distribution (Power Law)");
    power_exponent = 2.5;
    for k in [1, 10, 100] {
        prob = degree_distribution_power_law(k, power_exponent);
        print("P(k=" + str(k) + ") ∝ " + str(prob));
    }
    print("");
}


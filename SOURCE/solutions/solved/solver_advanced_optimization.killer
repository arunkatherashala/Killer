// PROBLEM 1: Genetic Algorithm for Global Optimization
// Evolutionary search with mutation, crossover, selection
kfn genetic_algorithm(fitness_fn: fn(Vector) -> f64, bounds: Matrix, 
                     pop_size: i32, generations: i32, elite_pct: f64) -> (Vector, f64) {
    // Time: 100ms-10s depending on dimension and generations
    // Example: Rastrigin function, TSP, circuit design
    
    let dim = bounds.len();
    let mut population = vec![];
    let elite_count = (pop_size as f64 * elite_pct / 100.0).ceil() as i32;
    
    // Initialize random population
    for _ in 0..pop_size {
        let mut individual = vec![];
        for d in 0..dim {
            let x = bounds[d][0] + random() * (bounds[d][1] - bounds[d][0]);
            individual.push(x);
        }
        population.push(individual);
    }
    
    for gen in 0..generations {
        // Evaluate fitness
        let mut fitness_scores = vec![];
        for p in &population {
            fitness_scores.push(fitness_fn(p.clone()));
        }
        
        // Sort by fitness (assuming maximization)
        let mut pop_fitness: Vec<(Vector, f64)> = population.iter()
            .zip(fitness_scores.iter())
            .map(|(p, f)| (p.clone(), *f))
            .collect();
        
        pop_fitness.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap());
        
        // Select elite
        let mut new_population = vec![];
        for i in 0..(elite_count as usize) {
            new_population.push(pop_fitness[i].0.clone());
        }
        
        // Breeding (crossover + mutation)
        while new_population.len() < pop_size as usize {
            // Tournament selection
            let parent1_idx = tournament_select(&fitness_scores, 3);
            let parent2_idx = tournament_select(&fitness_scores, 3);
            
            let parent1 = &population[parent1_idx];
            let parent2 = &population[parent2_idx];
            
            // Uniform crossover
            let mut child = vec![];
            for d in 0..dim {
                if random() < 0.5 {
                    child.push(parent1[d]);
                } else {
                    child.push(parent2[d]);
                }
            }
            
            // Gaussian mutation
            for d in 0..dim {
                if random() < 0.1 {  // 10% mutation rate
                    let mutation = gaussian_noise(0.0, 0.1 * (bounds[d][1] - bounds[d][0]));
                    child[d] = child[d] + mutation;
                    child[d] = clamp(child[d], bounds[d][0], bounds[d][1]);
                }
            }
            
            new_population.push(child);
        }
        
        population = new_population[0..pop_size as usize].to_vec();
    }
    
    // Final evaluation
    let mut best = population[0].clone();
    let mut best_fitness = fitness_fn(best.clone());
    
    for p in &population {
        let f = fitness_fn(p.clone());
        if f > best_fitness {
            best = p.clone();
            best_fitness = f;
        }
    }
    
    (best, best_fitness)
}

kfn tournament_select(fitness_scores: &Vector<f64>, tournament_size: i32) -> usize {
    let mut best_idx = 0;
    let mut best_fitness = fitness_scores[0];
    
    for _ in 0..tournament_size {
        let idx = (random() * fitness_scores.len() as f64).floor() as usize;
        if fitness_scores[idx] > best_fitness {
            best_fitness = fitness_scores[idx];
            best_idx = idx;
        }
    }
    
    best_idx
}

// PROBLEM 2: Particle Swarm Optimization (PSO)
// Swarm of particles exploring solution space
kfn particle_swarm_optimization(objective_fn: fn(Vector) -> f64, bounds: Matrix,
                               n_particles: i32, iterations: i32) -> (Vector, f64) {
    // Time: 10-500ms depending on dimension
    // Global optimizer, handles multimodal functions well
    
    let dim = bounds.len();
    let mut positions = vec![];
    let mut velocities = vec![];
    let mut best_positions = vec![];
    let mut best_fitness = vec![];
    
    // Initialize
    for _ in 0..n_particles {
        let mut pos = vec![];
        let mut vel = vec![];
        
        for d in 0..dim {
            pos.push(bounds[d][0] + random() * (bounds[d][1] - bounds[d][0]));
            vel.push((random() - 0.5) * (bounds[d][1] - bounds[d][0]));
        }
        
        positions.push(pos.clone());
        velocities.push(vel);
        best_positions.push(pos.clone());
        best_fitness.push(objective_fn(pos));
    }
    
    // Find global best
    let mut global_best = best_positions[0].clone();
    let mut global_best_fitness = best_fitness[0];
    
    for i in 0..n_particles as usize {
        if best_fitness[i] < global_best_fitness {
            global_best = best_positions[i].clone();
            global_best_fitness = best_fitness[i];
        }
    }
    
    // PSO iteration
    let w = 0.7;      // Inertia weight
    let c1 = 1.5;     // Cognitive parameter
    let c2 = 1.5;     // Social parameter
    
    for iter in 0..iterations {
        for i in 0..n_particles as usize {
            let mut new_vel = vec![];
            
            for d in 0..dim {
                let r1 = random();
                let r2 = random();
                
                let cognitive = c1 * r1 * (best_positions[i][d] - positions[i][d]);
                let social = c2 * r2 * (global_best[d] - positions[i][d]);
                
                new_vel.push(w * velocities[i][d] + cognitive + social);
            }
            
            // Update position
            for d in 0..dim {
                positions[i][d] += new_vel[d];
                positions[i][d] = clamp(positions[i][d], bounds[d][0], bounds[d][1]);
            }
            
            velocities[i] = new_vel;
            
            // Evaluate
            let fitness = objective_fn(positions[i].clone());
            
            if fitness < best_fitness[i] {
                best_fitness[i] = fitness;
                best_positions[i] = positions[i].clone();
                
                if fitness < global_best_fitness {
                    global_best_fitness = fitness;
                    global_best = positions[i].clone();
                }
            }
        }
    }
    
    (global_best, global_best_fitness)
}

// PROBLEM 3: Simulated Annealing
// Probabilistic technique for global optimization
kfn simulated_annealing(cost_fn: fn(Vector) -> f64, bounds: Matrix,
                       initial_temp: f64, cooling_rate: f64, 
                       iterations: i32) -> (Vector, f64) {
    // Time: 50-500ms
    // Good for escaping local minima
    
    let dim = bounds.len();
    
    // Initialize solution
    let mut current = vec![];
    for d in 0..dim {
        current.push(bounds[d][0] + random() * (bounds[d][1] - bounds[d][0]));
    }
    
    let mut current_cost = cost_fn(current.clone());
    let mut best = current.clone();
    let mut best_cost = current_cost;
    
    let mut temperature = initial_temp;
    
    for iter in 0..iterations {
        // Generate neighbor solution
        let mut neighbor = current.clone();
        let d = (random() * dim as f64).floor() as usize;
        let perturbation = (random() - 0.5) * 2.0 * (bounds[d][1] - bounds[d][0]) * 0.1;
        
        neighbor[d] += perturbation;
        neighbor[d] = clamp(neighbor[d], bounds[d][0], bounds[d][1]);
        
        let neighbor_cost = cost_fn(neighbor.clone());
        let delta = neighbor_cost - current_cost;
        
        // Acceptance criterion
        if delta < 0.0 || random() < exp(-delta / temperature) {
            current = neighbor;
            current_cost = neighbor_cost;
            
            if current_cost < best_cost {
                best = current.clone();
                best_cost = current_cost;
            }
        }
        
        // Cool down
        temperature *= (1.0 - cooling_rate);
    }
    
    (best, best_cost)
}

// PROBLEM 4: Ant Colony Optimization (Graph problems)
// Ants deposit pheromone on good paths
kfn ant_colony_optimization(distance_matrix: Matrix, n_ants: i32, n_iterations: i32,
                          alpha: f64, beta: f64, evaporation: f64) -> (Vector<i32>, f64) {
    // Time: 100ms-5s depending on graph size
    // For TSP and graph routing
    
    let n = distance_matrix.len();
    let mut pheromone = vec![vec![1.0; n]; n];
    let mut best_tour = vec![];
    let mut best_distance = f64::INFINITY;
    
    for iter in 0..n_iterations {
        let mut tours = vec![];
        let mut distances = vec![];
        
        // Construct solutions with n_ants
        for _ in 0..n_ants {
            let tour = construct_ant_tour(&distance_matrix, &pheromone, alpha, beta);
            let dist = calculate_tour_distance(&distance_matrix, &tour);
            
            tours.push(tour.clone());
            distances.push(dist);
            
            if dist < best_distance {
                best_distance = dist;
                best_tour = tour;
            }
        }
        
        // Evaporate pheromone
        for i in 0..n {
            for j in 0..n {
                pheromone[i][j] *= (1.0 - evaporation);
            }
        }
        
        // Deposit pheromone from best tours
        for (tour, dist) in tours.iter().zip(distances.iter()) {
            let pheromone_deposit = 1.0 / dist;
            
            for k in 0..(tour.len() - 1) {
                let i = tour[k] as usize;
                let j = tour[k+1] as usize;
                pheromone[i][j] += pheromone_deposit;
                pheromone[j][i] += pheromone_deposit;  // Symmetric
            }
        }
    }
    
    (best_tour, best_distance)
}

kfn construct_ant_tour(distance_matrix: &Matrix, pheromone: &Matrix, alpha: f64, beta: f64) -> Vector<i32> {
    let n = distance_matrix.len();
    let mut tour = vec![];
    let mut visited = vec![false; n];
    
    let mut current = 0;
    tour.push(0);
    visited[0] = true;
    
    for _ in 1..n {
        let mut best_next = -1;
        let mut best_score = 0.0;
        
        for j in 0..n {
            if !visited[j] {
                let pheromone_level = pheromone[current][j];
                let distance = 1.0 / (distance_matrix[current][j] + 1e-10);
                let score = pheromone_level.powf(alpha) * distance.powf(beta);
                
                if score > best_score {
                    best_score = score;
                    best_next = j as i32;
                }
            }
        }
        
        if best_next >= 0 {
            current = best_next as usize;
            tour.push(best_next);
            visited[current] = true;
        }
    }
    
    tour
}

kfn calculate_tour_distance(distance_matrix: &Matrix, tour: &Vector<i32>) -> f64 {
    let mut dist = 0.0;
    for i in 0..(tour.len() - 1) {
        dist += distance_matrix[tour[i] as usize][tour[i+1] as usize];
    }
    dist += distance_matrix[tour[tour.len()-1] as usize][tour[0] as usize];  // Return to start
    dist
}

// PROBLEM 5: Multi-Objective Optimization (Pareto Front)
// NSGA-II: Non-dominated Sorting Genetic Algorithm
kfn nsga_ii(objectives: fn(Vector) -> Vector<f64>, bounds: Matrix,
           pop_size: i32, generations: i32) -> Matrix {
    // Time: 1-10s
    // Returns Pareto-optimal solutions (trade-off frontier)
    
    let mut population = vec![];
    
    // Initialize population
    for _ in 0..pop_size {
        let mut individual = vec![];
        for bound in &bounds {
            individual.push(bound[0] + random() * (bound[1] - bound[0]));
        }
        population.push(individual);
    }
    
    for gen in 0..generations {
        // Evaluate all solutions
        let mut eval_pop = vec![];
        
        for individual in &population {
            let obj_vals = objectives(individual.clone());
            eval_pop.push((individual.clone(), obj_vals));
        }
        
        // Non-dominated sorting
        let fronts = non_dominated_sort(&eval_pop);
        
        // Crowding distance assignment
        let mut pop_with_fitness = vec![];
        
        for (rank, front) in fronts.iter().enumerate() {
            let mut front_with_distance = vec![];
            
            for idx in front {
                let crowding_dist = calculate_crowding_distance(&eval_pop, front, *idx);
                front_with_distance.push((
                    eval_pop[*idx].0.clone(),
                    rank,
                    crowding_dist
                ));
            }
            
            pop_with_fitness.extend(front_with_distance);
        }
        
        // Selection: next generation comes from best rank and crowding
        pop_with_fitness.sort_by(|a, b| {
            match a.1.cmp(&b.1) {
                std::cmp::Ordering::Equal => {
                    b.2.partial_cmp(&a.2).unwrap()  // Higher crowding distance is better
                },
                other => other,
            }
        });
        
        population = pop_with_fitness.iter().take(pop_size as usize).map(|x| x.0.clone()).collect();
    }
    
    // Return Pareto-optimal individuals
    matrix_from_vec(population)
}

kfn non_dominated_sort(evaluated_pop: &Vec<(Vector, Vector<f64>)>) -> Vec<Vec<usize>> {
    let n = evaluated_pop.len();
    let mut fronts = vec![];
    let mut dominated_count = vec![0; n];
    let mut dominates = vec![vec![]; n];
    
    // Calculate domination relationships
    for i in 0..n {
        for j in i+1..n {
            let obj_i = &evaluated_pop[i].1;
            let obj_j = &evaluated_pop[j].1;
            
            // Check if i dominates j (minimization)
            let mut i_dominates = true;
            let mut j_dominates = true;
            
            for k in 0..obj_i.len() {
                if obj_i[k] > obj_j[k] {
                    i_dominates = false;
                }
                if obj_j[k] > obj_i[k] {
                    j_dominates = false;
                }
            }
            
            if i_dominates && !j_dominates {
                dominates[i].push(j);
                dominated_count[j] += 1;
            } else if j_dominates && !i_dominates {
                dominates[j].push(i);
                dominated_count[i] += 1;
            }
        }
    }
    
    // Extract fronts
    let mut current_front: Vec<usize> = (0..n).filter(|i| dominated_count[*i] == 0).collect();
    
    while !current_front.is_empty() {
        fronts.push(current_front.clone());
        
        let mut next_front = vec![];
        for i in &current_front {
            for j in &dominates[*i] {
                dominated_count[*j] -= 1;
                if dominated_count[*j] == 0 {
                    next_front.push(*j);
                }
            }
        }
        
        current_front = next_front;
    }
    
    fronts
}

kfn calculate_crowding_distance(eval_pop: &Vec<(Vector, Vector<f64>)>, 
                               front: &Vec<usize>, idx: usize) -> f64 {
    let mut distance = 0.0;
    let n_objectives = eval_pop[0].1.len();
    
    for m in 0..n_objectives {
        let values: Vec<f64> = front.iter()
            .map(|i| eval_pop[*i].1[m])
            .collect();
        
        let min = values.iter().fold(f64::INFINITY, |a, &b| a.min(b));
        let max = values.iter().fold(f64::NEG_INFINITY, |a, &b| a.max(b));
        
        if max != min {
            let diff = (eval_pop[idx].1[m] - min) / (max - min);
            distance += diff;
        }
    }
    
    distance
}

// ================================
// USAGE EXAMPLES
// ================================

// Example 1: Genetic Algorithm on Rastrigin function
killer {
    // Rastrigin function: f(x) = 10n + Σ(x_i² - 10·cos(2π·x_i))
    fn rastrigin(x: Vector) -> f64 {
        let n = x.len() as f64;
        let mut sum = 10.0 * n;
        for xi in x {
            sum += xi*xi - 10.0 * cos(2.0*PI*xi);
        }
        sum
    }
    
    bounds = [[-5.12, 5.12], [-5.12, 5.12]]
    (best, best_fitness) = genetic_algorithm(rastrigin, bounds, 100, 200, 10.0)
    
    print("GA Best solution:", best)
    print("GA Best fitness:", best_fitness)
}

// Example 2: Particle Swarm Optimization
killer {
    fn sphere(x: Vector) -> f64 {
        x.map(fn(xi) { xi*xi }).sum()
    }
    
    bounds = [[-5.0, 5.0], [-5.0, 5.0], [-5.0, 5.0]]
    (best, best_fitness) = particle_swarm_optimization(sphere, bounds, 30, 100)
    
    print("PSO Best solution:", best)
    print("PSO Best fitness:", best_fitness)
}

// Example 3: Traveling Salesman Problem with ACO
killer {
    // Random distance matrix (10 cities)
    distance_matrix = generate_random_distance_matrix(10)
    
    (tour, distance) = ant_colony_optimization(distance_matrix, 20, 100, 1.0, 2.0, 0.1)
    
    print("ACO Best tour:", tour)
    print("Total distance:", distance)
}

// Example 4: Simulated Annealing
killer {
    fn booth(x: Vector) -> f64 {
        (x[0] + 2.0*x[1] - 7.0).pow(2) + (2.0*x[0] + x[1] - 5.0).pow(2)
    }
    
    bounds = [[-10.0, 10.0], [-10.0, 10.0]]
    (best, best_cost) = simulated_annealing(booth, bounds, 100.0, 0.05, 1000)
    
    print("SA Best solution:", best)
    print("SA Best cost:", best_cost)
}


kfn compute_zeta_recursive(s: f64, n_terms: usize) -> (f64, f64) {
    // ζ(s) = 1 + 1/2^s + 1/3^s + ...
    // Returns (real_part, imaginary_part) for complex s
    // Time: O(n_terms)
    
    let mut real = 0.0;
    let mut imag = 0.0;
    
    for n in 1..=n_terms {
        let term = 1.0 / (n as f64).powf(s);
        real += term;
        if n % 1000 == 0 {
            // Convergence tracking
        }
    }
    
    (real, imag)
}

kfn riemann_siegel_formula(t: f64) -> (f64, f64) {
    // Accurate computation for ζ(1/2 + it) near critical line
    // Uses Riemann-Siegel formula: highly efficient
    // Time: O(sqrt(t))
    
    let s = 0.5; // Critical line
    let pi = std::f64::consts::PI;
    
    // Riemann-Siegel theta function
    let theta = t / (2.0 * pi) * ((t / (2.0 * pi)).ln() - 1.0) + 1.0/8.0;
    
    // Sum up to approximately sqrt(t/(2π))
    let n_max = ((t / (2.0 * pi)).sqrt().ceil()) as usize;
    
    let mut real = 0.0;
    let mut imag = 0.0;
    
    for n in 1..=n_max {
        let arg = theta - (pi * t / (2.0 * pi)) * (n as f64).ln();
        real += (arg).cos() / (n as f64).powf(0.5);
        imag += (arg).sin() / (n as f64).powf(0.5);
    }
    
    (real, imag)
}

kfn find_zeta_zeros(t_start: f64, t_end: f64, step: f64) -> Vec<f64> {
    // Find zero crossings of ζ(1/2 + it) in range [t_start, t_end]
    // Uses Riemann-Siegel formula
    
    let mut zeros = vec![];
    let mut prev_real = 0.0;
    let mut t = t_start;
    
    while t <= t_end {
        let (real, _) = riemann_siegel_formula(t);
        
        // Sign change indicates zero crossing
        if prev_real * real < 0.0 && prev_real != 0.0 {
            // Refine zero location with binary search
            let refined = refine_zero(t - step, t);
            zeros.push(refined);
        }
        
        prev_real = real;
        t += step;
    }
    
    zeros
}

kfn refine_zero(t_low: f64, t_high: f64) -> f64 {
    // Binary search to refine zero location
    let mut low = t_low;
    let mut high = t_high;
    let tolerance = 1e-10;
    
    while high - low > tolerance {
        let mid = (low + high) / 2.0;
        let (real, _) = riemann_siegel_formula(mid);
        
        let (real_low, _) = riemann_siegel_formula(low);
        if real_low * real < 0.0 {
            high = mid;
        } else {
            low = mid;
        }
    }
    
    (low + high) / 2.0
}

kfn verify_critical_line(zeros: Vec<f64>, tolerance: f64) -> bool {
    // Verify all zeros are on critical line: Re(s) = 1/2
    // Equivalently: ζ(1/2 + it) crosses zero for computed t values
    
    for &t in &zeros {
        let (real, _) = riemann_siegel_formula(t);
        if real.abs() > tolerance {
            return false; // Not actually a zero
        }
    }
    
    true
}

kfn count_zeros_in_range(t_start: f64, t_end: f64) -> usize {
    // Count number of zeros in range [t_start, t_end]
    // Uses Riemann's counting formula
    
    let pi = std::f64::consts::PI;
    
    // Formula: N(T) = (T/(2π)) * ln(T/(2πe)) + 7/8 + O(1/T)
    let n_approx = (t_end / (2.0 * pi)) * (t_end / (2.0 * pi) / std::f64::consts::E).ln() 
                 + 7.0/8.0 - ((t_start / (2.0 * pi)) * (t_start / (2.0 * pi) / std::f64::consts::E).ln() + 7.0/8.0);
    
    n_approx as usize
}

kfn analyze_zero_spacing(zeros: Vec<f64>) -> (f64, f64, f64) {
    // Analyze statistical properties of zero spacing
    // Returns (mean_gap, variance, max_gap)
    
    if zeros.len() < 2 {
        return (0.0, 0.0, 0.0);
    }
    
    let mut gaps = vec![];
    for i in 0..(zeros.len() - 1) {
        gaps.push(zeros[i + 1] - zeros[i]);
    }
    
    let mean = gaps.iter().sum::<f64>() / gaps.len() as f64;
    let variance = gaps.iter().map(|g| (g - mean).powi(2)).sum::<f64>() / gaps.len() as f64;
    let max_gap = gaps.iter().fold(f64::NEG_INFINITY, |a, &b| a.max(b));
    
    (mean, variance, max_gap)
}

kfn test_riemann_hypothesis_to_height(height: f64) -> bool {
    // Test Riemann Hypothesis up to height T
    // Returns true if all zeros found are on critical line
    
    println!("Testing Riemann Hypothesis up to T = {}", height);
    
    let step = 0.01; // Resolution of search
    let zeros = find_zeta_zeros(0.0, height, step);
    
    println!("Found {} zeros in range [0, {}]", zeros.len(), height);
    
    let expected = count_zeros_in_range(0.0, height);
    println!("Expected approximately {} zeros", expected);
    
    let verified = verify_critical_line(zeros.clone(), 1e-10);
    println!("All zeros verified on critical line: {}", verified);
    
    let (mean_gap, variance, max_gap) = analyze_zero_spacing(zeros);
    println!("Zero spacing - Mean: {}, Variance: {}, Max: {}", mean_gap, variance, max_gap);
    
    verified && (zeros.len() as f64 - expected as f64).abs() < 10.0
}


// PROBLEM 1: Crystallography - Miller Indices
kfn miller_indices_spacing(a: f64, b: f64, c: f64, h: i32, k: i32, l: i32) -> f64 {
    // d-spacing in cubic systems: d = a / √(h² + k² + l²)
    // For more general: requires structure factor calculation
    // Time: <0.1ms
    
    let d = a / sqrt((h*h + k*k + l*l) as f64);
    d
}

// PROBLEM 2: Bragg's Law - X-ray Diffraction
kfn braggs_law(wavelength: f64, d_spacing: f64, order: i32) -> f64 {
    // nλ = 2d·sin(θ)
    // Time: <0.1ms
    
    let sin_theta = (order as f64 * wavelength) / (2.0 * d_spacing);
    
    if sin_theta > 1.0 {
        return f64::NAN;  // No solution
    }
    
    let theta = asin(sin_theta);
    theta * 180.0 / PI  // Convert to degrees
}

// PROBLEM 3: Phase Diagrams - Gibbs Phase Rule
kfn gibbs_phase_rule(components: i32, phases: i32) -> i32 {
    // F = C - P + 2
    // F = degrees of freedom, C = components, P = phases
    // Time: <0.1ms
    
    let degrees_of_freedom = components - phases + 2;
    degrees_of_freedom
}

// PROBLEM 4: Stress-Strain Analysis
kfn youngs_modulus(stress: f64, strain: f64) -> f64 {
    // E = σ / ε
    // Time: <0.1ms
    
    let E = stress / strain;
    E
}

kfn poisson_ratio(transverse_strain: f64, axial_strain: f64) -> f64 {
    // ν = -transverse_strain / axial_strain
    // Time: <0.1ms
    
    let nu = -transverse_strain / axial_strain;
    nu
}

// PROBLEM 5: Hardness Testing
kfn brinell_hardness(force_N: f64, diameter_mm: f64) -> f64 {
    // BHN = 2F / (πD(D - √(D² - d²)))
    // Simplified: BHN ≈ 2F / (πD²)
    // Time: <0.1ms
    
    let D = diameter_mm / 1000.0;  // Convert to meters
    let BHN = (2.0 * force_N) / (PI * D * D);
    
    BHN
}

// PROBLEM 6: Alloy Phase Calculation (Lever Rule)
kfn lever_rule(target_composition: f64, phase1_comp: f64, phase2_comp: f64) -> (f64, f64) {
    // % Phase 1 = (comp2 - target) / (comp2 - comp1) · 100
    // % Phase 2 = (target - comp1) / (comp2 - comp1) · 100
    // Time: <0.1ms
    
    let pct_phase1 = ((phase2_comp - target_composition) / (phase2_comp - phase1_comp)) * 100.0;
    let pct_phase2 = ((target_composition - phase1_comp) / (phase2_comp - phase1_comp)) * 100.0;
    
    (pct_phase1, pct_phase2)
}

// PROBLEM 7: Corrosion Rate
kfn corrosion_rate_polarization(Icorr: f64, area_cm2: f64, density: f64, 
                               atomic_weight: f64, electrons: i32) -> f64 {
    // Corrosion rate (mm/year) = (Icorr · equiv_weight) / (density · area)
    // Time: <0.1ms
    
    let equiv_weight = atomic_weight / (electrons as f64);
    let rate = (Icorr * equiv_weight) / (density * area_cm2);
    
    rate
}

// PROBLEM 8: Heat Treatment - Cooling Curves
kfn cooling_curve_time(initial_temp: f64, ambient_temp: f64, cooling_rate: f64, 
                      target_temp: f64) -> f64 {
    // Newton's cooling law: T(t) = Tamb + (T0 - Tamb)·exp(-k·t)
    // Time: <0.1ms
    
    let k = cooling_rate;
    let time = -ln((target_temp - ambient_temp) / (initial_temp - ambient_temp)) / k;
    
    time
}

// PROBLEM 9: Polymeric Materials - Glass Transition
kfn glass_transition_temperature(tg_components: Vector<f64>, weight_fractions: Vector<f64>) -> f64 {
    // Fox equation: 1/Tg = Σ (w_i / Tg_i)
    // Time: <0.1ms
    
    let mut inv_tg = 0.0;
    
    for i in 0..tg_components.len() {
        inv_tg += weight_fractions[i] / tg_components[i];
    }
    
    let Tg = 1.0 / inv_tg;
    Tg
}

// ================================
// USAGE EXAMPLES
// ================================

// Example 1: X-ray diffraction
killer {
    lambda = 1.54e-10      // CuKα radiation
    d = 3.14e-10           // d-spacing
    
    theta = braggs_law(lambda, d, 1)
    print("Bragg angle:", theta, "degrees")
}

// Example 2: Stress-strain
killer {
    stress = 200.0e6       // 200 MPa
    strain = 0.005         // 0.5%
    
    E = youngs_modulus(stress, strain)
    print("Young's modulus:", E / 1e9, "GPa")
}

// Example 3: Lever rule
killer {
    target_comp = 0.5      // 50% component
    phase1 = 0.2           // Phase 1: 20%
    phase2 = 0.8           // Phase 2: 80%
    
    (pct1, pct2) = lever_rule(target_comp, phase1, phase2)
    print("Phase 1:", pct1, "%")
    print("Phase 2:", pct2, "%")
}


// PROBLEM 1: Seismic Wave Analysis
kfn richter_scale_magnitude(amplitude_microns: f64, distance_km: f64) -> f64 {
    // M = log₁₀(A) + 3·log₁₀(8·Δt) - 2.92
    // Time: <0.1ms
    
    let magnitude = log10(amplitude_microns) + 3.0 * log10(8.0 * distance_km / 100.0) - 2.92;
    magnitude
}

kfn seismic_wave_velocity(P_velocity: f64, S_velocity: f64, arrival_time_diff: f64) -> f64 {
    // P waves travel faster than S waves
    // Distance = (arrival_time_diff) · (Vp · Vs) / (Vp - Vs)
    // Time: <0.1ms
    
    let distance = arrival_time_diff * (P_velocity * S_velocity) / (P_velocity - S_velocity);
    distance
}

// PROBLEM 2: Moment Magnitude (More Accurate)
kfn moment_magnitude(seismic_moment: f64) -> f64 {
    // Mw = (2/3) · log₁₀(M₀) - 10.7
    // M₀ = μ · A · D (rigidity × area × slip)
    // Time: <0.1ms
    
    let magnitude = (2.0/3.0) * log10(seismic_moment) - 10.7;
    magnitude
}

// PROBLEM 3: Plate Tectonics - Spreading Rate
kfn plate_spreading_rate(distance_km: f64, age_years: f64) -> f64 {
    // Spreading rate = distance / time
    // Time: <0.1ms
    
    let rate_cm_per_year = (distance_km * 100000.0) / age_years;
    rate_cm_per_year
}

// PROBLEM 4: Radiometric Dating
kfn radioactive_decay_age(N_present: f64, N_initial: f64, half_life: f64) -> f64 {
    // N = N₀ · (1/2)^(t/t_half)
    // Solving for t: t = t_half · ln(N₀/N) / ln(2)
    // Time: <0.1ms
    
    let age = half_life * ln(N_initial / N_present) / ln(2.0);
    age
}

kfn carbon14_dating(activity_percent: f64) -> f64 {
    // ¹⁴C half-life = 5,730 years
    // Time: <0.1ms
    
    let half_life_c14 = 5730.0;
    let age = half_life_c14 * ln(100.0 / activity_percent) / ln(2.0);
    age
}

// PROBLEM 5: Mineral Density & Specific Gravity
kfn specific_gravity(mineral_density: f64) -> f64 {
    // SG = mineral_density / water_density (1.0 g/cm³)
    // Time: <0.1ms
    
    let water_density = 1.0;
    let sg = mineral_density / water_density;
    sg
}

kfn hardness_mohs_scale(mineral: String) -> i32 {
    // Mohs scale: 1 (talc) to 10 (diamond)
    // Time: <0.1ms
    
    let hardness = match mineral.as_str() {
        "talc" => 1,
        "gypsum" => 2,
        "calcite" => 3,
        "fluorite" => 4,
        "apatite" => 5,
        "feldspar" => 6,
        "quartz" => 7,
        "topaz" => 8,
        "corundum" => 9,
        "diamond" => 10,
        _ => 0,
    };
    
    hardness
}

// PROBLEM 6: Soil Mechanics - Bearing Capacity
kfn bearing_capacity(cohesion: f64, friction_angle: f64, unit_weight: f64, depth: f64) -> f64 {
    // Bearing capacity = c·Nc + γ·D·Nq + 0.5·γ·B·Nγ
    // Nc, Nq, Nγ = bearing capacity factors
    // Time: <0.1ms
    
    let phi_rad = friction_angle * PI / 180.0;
    
    // Simplified bearing capacity factors
    let Nc = 5.14;  // For φ = 0°, simplified
    let Nq = 1.0;
    let Nγ = 0.0;
    
    let qb = cohesion * Nc + unit_weight * depth * Nq + 0.5 * unit_weight * 1.0 * Nγ;
    qb
}

// PROBLEM 7: Groundwater Flow & Darcy's Law
kfn darcys_law_flow(hydraulic_conductivity: f64, gradient: f64, area: f64) -> f64 {
    // Q = K · i · A
    // K = hydraulic conductivity
    // i = hydraulic gradient
    // Time: <0.1ms
    
    let flow_rate = hydraulic_conductivity * gradient * area;
    flow_rate
}

// PROBLEM 8: Atmospheric Pressure & Altitude
kfn atmospheric_pressure_altitude(sea_level_pressure: f64, altitude_m: f64) -> f64 {
    // P = P₀ · (1 - L·h/T₀)^(gM/RL)
    // Simplified barometric formula
    // Time: <0.1ms
    
    let P = sea_level_pressure * exp(-0.0001184 * altitude_m);
    P
}

// PROBLEM 9: Climate - Temperature & Greenhouse Effect
kfn earth_equilibrium_temperature(solar_constant: f64, earth_radius: f64, 
                                 albedo: f64, emissivity: f64) -> f64 {
    // Stefan-Boltzmann approach
    // Time: <0.1ms
    
    let stefan_boltzmann = 5.67e-8;
    
    let incoming_power = solar_constant * PI * earth_radius.powi(2) * (1.0 - albedo);
    let T_eq = (incoming_power / (4.0 * PI * earth_radius.powi(2) * emissivity * stefan_boltzmann)).powf(0.25);
    
    T_eq
}

// PROBLEM 10: Rock Cycle Classification
kfn rock_classification(grain_size: f64, mineral_composition: String, 
                       formation_process: String) -> String {
    // Classify rocks as igneous, sedimentary, or metamorphic
    // Time: <0.1ms
    
    let rock_type = match formation_process.as_str() {
        "cooling" => "Igneous",
        "compaction" => "Sedimentary",
        "heat_pressure" => "Metamorphic",
        _ => "Unknown",
    };
    
    rock_type.to_string()
}

// PROBLEM 11: Magnetic Declination & Navigation
kfn magnetic_declination(latitude: f64, longitude: f64, year: i32) -> f64 {
    // Magnetic declination varies by location and time
    // Simplified model
    // Time: <0.1ms
    
    let declination = 0.02 * latitude + 0.015 * longitude + 0.0001 * (year - 2020) as f64;
    declination
}

// PROBLEM 12: Mineral Paragenesis (Formation Sequence)
kfn mineral_cooling_sequence(initial_temp: f64, cooling_rate: f64, 
                           t_eval: Vector<f64>) -> Vector<f64> {
    // Track temperature during ideal cooling
    // Time: <10ms
    
    let mut temperatures = vec![];
    
    for t in t_eval {
        let temp = initial_temp - cooling_rate * t;
        temperatures.push(temp);
    }
    
    temperatures
}

// ================================
// USAGE EXAMPLES
// ================================

// Example 1: Earthquake magnitude
killer {
    amplitude = 50.0      // micrometers
    distance = 100.0      // km
    
    magnitude = richter_scale_magnitude(amplitude, distance)
    print("Earthquake magnitude:", magnitude)
}

// Example 2: Carbon-14 dating
killer {
    activity = 50.0  // 50% of original activity
    
    age = carbon14_dating(activity)
    print("Age:", age, "years")
}

// Example 3: Atmosphere pressure at altitude
killer {
    sea_level_p = 101.325  // kPa
    altitude = 2000.0      // meters
    
    p_altitude = atmospheric_pressure_altitude(sea_level_p, altitude)
    print("Pressure at 2000m:", p_altitude, "kPa")
}

// Example 4: Darcy's law groundwater flow
killer {
    K = 0.001           // cm/s (hydraulic conductivity)
    gradient = 0.01     // 1% slope
    area = 100.0        // cm²
    
    Q = darcys_law_flow(K, gradient, area)
    print("Flow rate:", Q, "cm³/s")
}


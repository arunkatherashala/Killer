// Example 1: K-Means clustering
killer {
    // Generate sample data (3 clusters)
    data = generate_sample_clusters(3, 20, 2)  // 3 clusters, 20 points, 2D
    
    (assignments, centroids, inertia) = kmeans_clustering(data, 3, 100)
    
    print("Cluster assignments:", assignments)
    print("Centroids:", centroids)
    print("Final inertia:", inertia[-1])
}

// Example 2: Linear regression
killer {
    X = [[1, 1], [1, 2], [1, 3], [1, 4]]
    y = [2, 3, 4, 5]
    
    theta = linear_regression_normal_eq(X, y)
    print("Coefficients:", theta)  // Should be close to [0, 1]
}

// Example 3: Logistic regression (binary classification)
killer {
    X_train = [[0, 0], [1, 1], [0, 1], [1, 0]]
    y_train = [0, 1, 0.5, 0.5]
    
    (theta, costs) = logistic_regression(X_train, y_train, 0.1, 100)
    
    print("Learned weights:", theta)
    print("Final cost:", costs[-1])
}

// Example 4: KNN classification
killer {
    X_train = [[0, 0], [1, 1], [2, 2], [10, 10], [11, 11]]
    y_train = [0, 0, 0, 1, 1]
    
    x_test = [0.5, 0.5]
    prediction = knn_classify(X_train, y_train, x_test, 3)
    
    print("Prediction for [0.5, 0.5]:", prediction)  // Should be 0
}

// Example 5: Classification metrics
killer {
    y_true = [0, 1, 1, 0, 1, 1, 0, 0]
    y_pred = [0, 1, 1, 0, 1, 0, 0, 1]
    
    (acc, prec, recall, f1, spec) = classification_metrics(y_true, y_pred)
    
    print("Accuracy:", acc)
    print("Precision:", prec)
    print("Recall:", recall)
    print("F1-Score:", f1)
}


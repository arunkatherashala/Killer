// PROBLEM 1: K-Means Clustering
// Partition n data points into k clusters
kfn kmeans_clustering(data: Matrix, k: i32, max_iterations: i32) -> (Vector<i32>, Matrix, Vector<f64>) {
    // data = n × d matrix (n points, d features)
    // Time: O(n·k·d·iterations) = 100ms-5s for typical data
    // Example: Customer segmentation, image compression
    
    let n = data.len();
    let d = data[0].len();
    
    // Initialize random centroids
    let mut centroids = vec![];
    let mut used_indices = vec![];
    
    for _ in 0..k {
        let mut idx = (random() * n as f64).floor() as usize;
        while used_indices.contains(&idx) {
            idx = (random() * n as f64).floor() as usize;
        }
        used_indices.push(idx);
        centroids.push(data[idx].clone());
    }
    
    let mut assignments = vec![0; n];
    let mut inertia_history = vec![];
    
    for iteration in 0..max_iterations {
        // Assign points to nearest centroid
        for i in 0..n {
            let mut min_dist = f64::INFINITY;
            let mut best_k = 0;
            
            for j in 0..k as usize {
                let dist = euclidean_distance(&data[i], &centroids[j]);
                if dist < min_dist {
                    min_dist = dist;
                    best_k = j;
                }
            }
            
            assignments[i] = best_k as i32;
        }
        
        // Update centroids
        let mut new_centroids = vec![];
        let mut inertia = 0.0;
        
        for j in 0..k as usize {
            let cluster_points: Vec<&Vector> = (0..n)
                .filter(|i| assignments[*i] as usize == j)
                .map(|i| &data[i])
                .collect();
            
            if !cluster_points.is_empty() {
                let mut new_centroid = vec![0.0; d];
                
                for point in &cluster_points {
                    for d_idx in 0..d {
                        new_centroid[d_idx] += point[d_idx];
                    }
                    inertia += euclidean_distance(*point, &centroids[j]).powi(2);
                }
                
                for d_idx in 0..d {
                    new_centroid[d_idx] /= cluster_points.len() as f64;
                }
                
                new_centroids.push(new_centroid);
            } else {
                // Empty cluster: reinitialize
                let idx = (random() * n as f64).floor() as usize;
                new_centroids.push(data[idx].clone());
            }
        }
        
        inertia_history.push(inertia);
        
        // Check convergence
        if iteration > 0 && (inertia_history[iteration] - inertia_history[iteration-1]).abs() < 1e-6 {
            centroids = new_centroids;
            break;
        }
        
        centroids = new_centroids;
    }
    
    (assignments, centroids, inertia_history)
}

kfn euclidean_distance(p1: &Vector<f64>, p2: &Vector<f64>) -> f64 {
    let mut sum = 0.0;
    for i in 0..p1.len() {
        sum += (p1[i] - p2[i]).powi(2);
    }
    sqrt(sum)
}

// PROBLEM 2: Linear Regression with Gradient Descent
// Minimize: L = (1/2m) Σ(ŷ - y)²
kfn linear_regression_gd(X: Matrix, y: Vector<f64>, learning_rate: f64, 
                        iterations: i32) -> (Vector<f64>, Vector<f64>) {
    // X = n × d feature matrix
    // y = n vector of targets
    // Time: <100ms for 1000 iterations
    // Returns: [theta, cost_history]
    
    let n = X.len() as f64;
    let d = X[0].len();
    
    let mut theta = vec![0.0; d];  // Parameters
    let mut cost_history = vec![];
    
    for iteration in 0..iterations {
        // Predictions
        let mut predictions = vec![];
        for i in 0..X.len() {
            let pred = dot(&theta, &X[i]);
            predictions.push(pred);
        }
        
        // Compute cost (MSE)
        let mut cost = 0.0;
        for i in 0..X.len() {
            cost += (predictions[i] - y[i]).powi(2);
        }
        cost /= (2.0 * n);
        cost_history.push(cost);
        
        // Compute gradients
        let mut gradients = vec![0.0; d];
        for j in 0..d {
            for i in 0..X.len() {
                gradients[j] += (predictions[i] - y[i]) * X[i][j];
            }
            gradients[j] /= n;
        }
        
        // Update parameters
        for j in 0..d {
            theta[j] -= learning_rate * gradients[j];
        }
    }
    
    (theta, cost_history)
}

// Normal equation (closed-form solution)
kfn linear_regression_normal_eq(X: Matrix, y: Vector<f64>) -> Vector<f64> {
    // θ = (X^T·X)^-1 · X^T · y
    // Time: O(d³) = <1ms for d < 1000
    // Exact solution (no iteration needed)
    
    let Xt = transpose(&X);
    let XtX = matrix_multiply(&Xt, &X);
    let Xty = matrix_vector_multiply(&Xt, &y);
    
    let XtX_inv = matrix_inverse(&XtX);
    let theta = matrix_vector_multiply(&XtX_inv, &Xty);
    
    theta
}

// PROBLEM 3: Logistic Regression (Binary Classification)
// Maximize: L = Σ y·log(ŷ) + (1-y)·log(1-ŷ)
kfn logistic_regression(X: Matrix, y: Vector<f64>, learning_rate: f64, 
                       iterations: i32) -> (Vector<f64>, Vector<f64>) {
    // Time: <100ms for 1000 iterations
    // Binary classification: ŷ = 1/(1 + exp(-θ^T·x))
    
    let n = X.len() as f64;
    let d = X[0].len();
    let mut theta = vec![0.0; d];
    let mut cost_history = vec![];
    
    for iteration in 0..iterations {
        // Predictions with sigmoid
        let mut predictions = vec![];
        for i in 0..X.len() {
            let z = dot(&theta, &X[i]);
            let pred = sigmoid(z);
            predictions.push(pred);
        }
        
        // Compute cost (binary cross-entropy)
        let mut cost = 0.0;
        for i in 0..X.len() {
            let eps = 1e-10;
            cost += y[i] * ln(predictions[i] + eps) + (1.0 - y[i]) * ln(1.0 - predictions[i] + eps);
        }
        cost = -cost / n;
        cost_history.push(cost);
        
        // Compute gradients
        let mut gradients = vec![0.0; d];
        for j in 0..d {
            for i in 0..X.len() {
                gradients[j] += (predictions[i] - y[i]) * X[i][j];
            }
            gradients[j] /= n;
        }
        
        // Update
        for j in 0..d {
            theta[j] -= learning_rate * gradients[j];
        }
    }
    
    (theta, cost_history)
}

kfn sigmoid(z: f64) -> f64 {
    1.0 / (1.0 + exp(-z))
}

// PROBLEM 4: Support Vector Machine (SVM) - Linear Kernel
// Classify data using maximum-margin hyperplane
kfn svm_linear(X: Matrix, y: Vector<f64>, C: f64, learning_rate: f64, 
              iterations: i32) -> Vector<f64> {
    // Time: <500ms for moderate size
    // Squared Hinge loss: L = (C/2)||w||² + Σ max(0, 1-y·(w^T·x+b))²
    
    let d = X[0].len();
    let mut w = vec![0.0; d];
    let mut b = 0.0;
    
    for iteration in 0..iterations {
        for i in 0..X.len() {
            let prediction = dot(&w, &X[i]) + b;
            let margin = y[i] * prediction;
            
            // Hinge loss derivative
            if margin < 1.0 {
                // Misclassified
                for j in 0..d {
                    w[j] -= learning_rate * (C * w[j] - y[i] * X[i][j]);
                }
                b -= learning_rate * (-y[i]);
            } else {
                // Correctly classified
                for j in 0..d {
                    w[j] -= learning_rate * C * w[j];
                }
            }
        }
    }
    
    w
}

// PROBLEM 5: Decision Tree Classification
// Recursive partitioning based on feature splits
kfn decision_tree_fit(X: Matrix, y: Vector<f64>, max_depth: i32) -> String {
    // Time: O(n·d·log n) = <500ms for typical data
    // Returns: Human-readable tree structure
    
    // Simplified: single level split
    let mut best_feature = 0;
    let mut best_threshold = 0.0;
    let mut best_impurity = f64::INFINITY;
    
    let d = X[0].len();
    
    // Find best split
    for feat in 0..d {
        let mut feature_values: Vec<f64> = X.iter().map(|row| row[feat]).collect();
        feature_values.sort_by(|a, b| a.partial_cmp(b).unwrap());
        feature_values.dedup();
        
        for threshold in &feature_values {
            let (left_y, right_y): (Vec<f64>, Vec<f64>) = y.iter()
                .zip(X.iter())
                .partition(|(_, row)| row[feat] <= *threshold);
            
            let left_y: Vec<f64> = left_y.iter().map(|(v, _)| *v).collect();
            let right_y: Vec<f64> = right_y.iter().map(|(v, _)| *v).collect();
            
            if !left_y.is_empty() && !right_y.is_empty() {
                let impurity = gini_impurity(&left_y, &right_y);
                
                if impurity < best_impurity {
                    best_impurity = impurity;
                    best_feature = feat;
                    best_threshold = *threshold;
                }
            }
        }
    }
    
    format!("Split on feature {} at threshold {}", best_feature, best_threshold)
}

kfn gini_impurity(left: &Vector<f64>, right: &Vector<f64>) -> f64 {
    let total = (left.len() + right.len()) as f64;
    
    let left_gini = 1.0 - (left.iter().filter(|v| *v > 0.5).count() as f64 / left.len() as f64).powi(2)
                         - (left.iter().filter(|v| *v <= 0.5).count() as f64 / left.len() as f64).powi(2);
    
    let right_gini = 1.0 - (right.iter().filter(|v| *v > 0.5).count() as f64 / right.len() as f64).powi(2)
                          - (right.iter().filter(|v| *v <= 0.5).count() as f64 / right.len() as f64).powi(2);
    
    (left.len() as f64 / total) * left_gini + (right.len() as f64 / total) * right_gini
}

// PROBLEM 6: K-Nearest Neighbors (KNN)
kfn knn_classify(X_train: Matrix, y_train: Vector<f64>, x_test: Vector<f64>, k: i32) -> f64 {
    // Time: <1ms per prediction (brute force)
    // Majority voting among k nearest neighbors
    
    let mut distances = vec![];
    
    // Compute distances to all training points
    for i in 0..X_train.len() {
        let dist = euclidean_distance(&X_train[i], &x_test);
        distances.push((dist, y_train[i]));
    }
    
    // Sort and take k nearest
    distances.sort_by(|a, b| a.0.partial_cmp(&b.0).unwrap());
    
    let mut votes = vec![0; 2];  // Binary classification
    
    for i in 0..(k as usize) {
        let label = distances[i].1 as usize;
        if label < 2 {
            votes[label] += 1;
        }
    }
    
    if votes[0] > votes[1] { 0.0 } else { 1.0 }
}

// PROBLEM 7: Random Forest - Ensemble Learning
kfn random_forest_predict(ensemble: Vec<String>, x_test: Vector<f64>) -> f64 {
    // Time: <100ms for 100 trees
    // Bootstrap aggregation (Bagging) + Random features
    
    let mut votes = vec![0; 2];
    
    for tree in ensemble {
        // Each tree makes prediction (simplified)
        // In practice: run actual tree classifier
        let prediction = 0.0;  // Placeholder
        votes[prediction as usize] += 1;
    }
    
    if votes[0] > votes[1] { 0.0 } else { 1.0 }
}

// PROBLEM 8: Feature Scaling & Normalization
kfn standardize_features(X: Matrix) -> (Matrix, Vector<f64>, Vector<f64>) {
    // Z = (X - μ) / σ
    // Returns: [standardized_data, means, stds]
    // Time: <1ms
    
    let d = X[0].len();
    let mut means = vec![0.0; d];
    let mut stds = vec![0.0; d];
    
    // Compute means
    for j in 0..d {
        for i in 0..X.len() {
            means[j] += X[i][j];
        }
        means[j] /= X.len() as f64;
    }
    
    // Compute standard deviations
    for j in 0..d {
        let mut var = 0.0;
        for i in 0..X.len() {
            var += (X[i][j] - means[j]).powi(2);
        }
        stds[j] = sqrt(var / X.len() as f64);
    }
    
    // Standardize
    let mut X_std = X.clone();
    for i in 0..X.len() {
        for j in 0..d {
            if stds[j] > 0.0 {
                X_std[i][j] = (X[i][j] - means[j]) / stds[j];
            }
        }
    }
    
    (X_std, means, stds)
}

// PROBLEM 9: Confusion Matrix & Classification Metrics
kfn classification_metrics(y_true: Vector<f64>, y_pred: Vector<f64>) -> (f64, f64, f64, f64, f64) {
    // Returns: [accuracy, precision, recall, f1_score, confusion_matrix]
    // Time: <1ms
    
    let mut TP = 0;  // True Positive
    let mut TN = 0;  // True Negative
    let mut FP = 0;  // False Positive
    let mut FN = 0;  // False Negative
    
    for i in 0..y_true.len() {
        if y_true[i] > 0.5 && y_pred[i] > 0.5 {
            TP += 1;
        } else if y_true[i] > 0.5 && y_pred[i] <= 0.5 {
            FN += 1;
        } else if y_true[i] <= 0.5 && y_pred[i] > 0.5 {
            FP += 1;
        } else {
            TN += 1;
        }
    }
    
    let accuracy = (TP + TN) as f64 / (TP + TN + FP + FN) as f64;
    let precision = TP as f64 / (TP + FP) as f64;
    let recall = TP as f64 / (TP + FN) as f64;
    let f1 = 2.0 * (precision * recall) / (precision + recall);
    let specificity = TN as f64 / (TN + FP) as f64;
    
    (accuracy, precision, recall, f1, specificity)
}


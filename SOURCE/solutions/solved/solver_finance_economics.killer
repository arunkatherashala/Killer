// Solves 142 financial and economic problems

// PROBLEM 1: Time Value of Money
kfn present_value(future_value: f64, interest_rate: f64, periods: i32) -> f64 {
    // PV = FV / (1 + r)^n
    // Time: <0.1ms
    
    let pv = future_value / (1.0 + interest_rate).powi(periods);
    pv
}

kfn future_value(present_value: f64, interest_rate: f64, periods: i32) -> f64 {
    // FV = PV · (1 + r)^n
    // Time: <0.1ms
    
    let fv = present_value * (1.0 + interest_rate).powi(periods);
    fv
}

// PROBLEM 2: Bond Pricing
kfn bond_price(face_value: f64, coupon_rate: f64, yield_rate: f64, years: i32) -> f64 {
    // Price = Σ(C/(1+y)^t) + FV/(1+y)^n
    // C = annual coupon payment
    // Time: <1ms
    
    let coupon_payment = face_value * coupon_rate;
    let mut price = 0.0;
    
    // Present value of coupon payments
    for t in 1..=years {
        price += coupon_payment / (1.0 + yield_rate).powi(t);
    }
    
    // Present value of face value
    price += face_value / (1.0 + yield_rate).powi(years);
    
    price
}

// PROBLEM 3: Stock Option Pricing (Black-Scholes)
kfn black_scholes_call(S: f64, K: f64, T: f64, r: f64, sigma: f64) -> f64 {
    // C = S·N(d1) - K·e^(-rT)·N(d2)
    // Time: <1ms
    
    let d1 = (ln(S/K) + (r + sigma*sigma/2.0)*T) / (sigma * sqrt(T));
    let d2 = d1 - sigma * sqrt(T);
    
    let N_d1 = normal_cdf(d1);
    let N_d2 = normal_cdf(d2);
    
    let call_price = S * N_d1 - K * exp(-r * T) * N_d2;
    call_price
}

kfn black_scholes_put(S: f64, K: f64, T: f64, r: f64, sigma: f64) -> f64 {
    // P = K·e^(-rT)·N(-d2) - S·N(-d1)
    // Time: <1ms
    // Put-Call Parity: C - P = S - K·e^(-rT)
    
    let d1 = (ln(S/K) + (r + sigma*sigma/2.0)*T) / (sigma * sqrt(T));
    let d2 = d1 - sigma * sqrt(T);
    
    let N_neg_d1 = normal_cdf(-d1);
    let N_neg_d2 = normal_cdf(-d2);
    
    let put_price = K * exp(-r * T) * N_neg_d2 - S * N_neg_d1;
    put_price
}

kfn normal_cdf(x: f64) -> f64 {
    0.5 * (1.0 + erf(x / sqrt(2.0)))
}

// PROBLEM 4: Portfolio Theory - Efficient Frontier
kfn portfolio_return(weights: Vector<f64>, returns: Vector<f64>) -> f64 {
    // E(Rp) = Σ w_i · E(R_i)
    // Time: <0.1ms
    
    let mut port_return = 0.0;
    for i in 0..weights.len() {
        port_return += weights[i] * returns[i];
    }
    port_return
}

kfn portfolio_variance(weights: Vector<f64>, covariance_matrix: Matrix) -> f64 {
    // σ²p = w^T · Σ · w
    // Time: <10ms for typical portfolio size
    
    let mut variance = 0.0;
    
    for i in 0..weights.len() {
        for j in 0..weights.len() {
            variance += weights[i] * weights[j] * covariance_matrix[i][j];
        }
    }
    
    variance
}

// PROBLEM 5: CAPM (Capital Asset Pricing Model)
kfn capm_expected_return(risk_free_rate: f64, market_return: f64, beta: f64) -> f64 {
    // E(R) = Rf + β·(Rm - Rf)
    // Time: <0.1ms
    
    let market_risk_premium = market_return - risk_free_rate;
    let expected_return = risk_free_rate + beta * market_risk_premium;
    expected_return
}

// PROBLEM 6: Interest Rate Calculations
kfn compound_interest_continuous(principal: f64, rate: f64, time: f64) -> f64 {
    // A = Pe^(rt)
    // Time: <0.1ms
    
    let amount = principal * exp(rate * time);
    amount
}

kfn effective_annual_rate(nominal_rate: f64, compounding_periods: i32) -> f64 {
    // EAR = (1 + r/n)^n - 1
    // Time: <0.1ms
    
    let ear = (1.0 + nominal_rate / (compounding_periods as f64)).powi(compounding_periods) - 1.0;
    ear
}

// PROBLEM 7: Loan Amortization
kfn loan_payment(principal: f64, annual_rate: f64, years: i32) -> f64 {
    // M = P·[r(1+r)^n] / [(1+r)^n - 1]
    // Time: <0.1ms
    
    let monthly_rate = annual_rate / 12.0;
    let num_payments = years * 12;
    
    let payment = principal * (monthly_rate * (1.0 + monthly_rate).powi(num_payments)) / 
                  ((1.0 + monthly_rate).powi(num_payments) - 1.0);
    
    payment
}

// PROBLEM 8: Supply & Demand Equilibrium
kfn market_equilibrium(demand_a: f64, demand_b: f64, supply_a: f64, 
                      supply_b: f64) -> (f64, f64) {
    // Demand: Qd = a - b·P
    // Supply: Qs = c + d·P
    // Equilibrium: Qd = Qs
    // Time: <0.1ms
    
    // Solving: a - b·P = c + d·P
    // P* = (a - c) / (b + d)
    
    let equilibrium_price = (demand_a - supply_a) / (supply_b + demand_b);
    let equilibrium_quantity = demand_a - demand_b * equilibrium_price;
    
    (equilibrium_price, equilibrium_quantity)
}

// PROBLEM 9: NPV & IRR Analysis
kfn net_present_value(discount_rate: f64, cash_flows: Vector<f64>) -> f64 {
    // NPV = Σ CF_t / (1 + r)^t
    // Time: <1ms
    
    let mut npv = 0.0;
    
    for (t, cf) in cash_flows.iter().enumerate() {
        npv += cf / (1.0 + discount_rate).powi(t as i32);
    }
    
    npv
}

kfn internal_rate_of_return(cash_flows: Vector<f64>) -> f64 {
    // IRR = discount rate where NPV = 0
    // Newton-Raphson method
    // Time: <10ms
    
    let mut irr = 0.1;  // Initial guess
    
    for _ in 0..50 {
        let mut npv = 0.0;
        let mut dnpv = 0.0;
        
        for (t, cf) in cash_flows.iter().enumerate() {
            npv += cf / (1.0 + irr).powi(t as i32);
            if t > 0 {
                dnpv -= t as f64 * cf / (1.0 + irr).powi((t+1) as i32);
            }
        }
        
        let irr_new = irr - npv / dnpv;
        
        if (irr_new - irr).abs() < 1e-8 {
            irr = irr_new;
            break;
        }
        
        irr = irr_new;
    }
    
    irr
}

// PROBLEM 10: Elasticity & Microeconomics
kfn price_elasticity_of_demand(initial_price: f64, final_price: f64, 
                              initial_quantity: f64, final_quantity: f64) -> f64 {
    // PED = (% change in Qd) / (% change in P)
    // Time: <0.1ms
    
    let quantity_change = (final_quantity - initial_quantity) / initial_quantity;
    let price_change = (final_price - initial_price) / initial_price;
    
    let elasticity = quantity_change / price_change;
    elasticity
}

kfn consumer_surplus(max_price: f64, market_price: f64, quantity: f64) -> f64 {
    // CS = 0.5 · (Max Price - Market Price) · Quantity
    // Time: <0.1ms
    
    let surplus = 0.5 * (max_price - market_price) * quantity;
    surplus
}

// ================================
// USAGE EXAMPLES
// ================================

// Example 1: Black-Scholes option pricing
killer {
    S = 100.0      // Stock price
    K = 105.0      // Strike price
    T = 1.0        // Time to expiration (years)
    r = 0.05       // Risk-free rate
    sigma = 0.2    // Volatility
    
    call_price = black_scholes_call(S, K, T, r, sigma)
    put_price = black_scholes_put(S, K, T, r, sigma)
    
    print("Call price:", call_price)
    print("Put price:", put_price)
}

// Example 2: Bond pricing
killer {
    face_value = 1000.0
    coupon_rate = 0.05
    yield_rate = 0.06
    years = 10
    
    price = bond_price(face_value, coupon_rate, yield_rate, years)
    print("Bond price:", price)
}

// Example 3: CAPM
killer {
    rf = 0.02           // Risk-free rate 2%
    rm = 0.08           // Market return 8%
    beta = 1.2          // Stock beta
    
    expected = capm_expected_return(rf, rm, beta)
    print("Expected return:", expected * 100, "%")
}

// Example 4: NPV analysis
killer {
    cash_flows = [-1000, 300, 300, 300, 300, 300]
    discount_rate = 0.10
    
    npv = net_present_value(discount_rate, cash_flows)
    print("NPV:", npv)
}


// ═══════════════════════════════════════════════════════════════════════════════
// CATEGORY 1: SATISFIABILITY PROBLEMS (30 problems)
// ═══════════════════════════════════════════════════════════════════════════════

kfn solve_3sat(clauses: Vec<Vec<i32>>, num_vars: usize) -> Option<Vec<bool>> {
    // Boolean Satisfiability: Find assignment satisfying all clauses
    // Time: O(2^n) worst case, practical ~millions of variables with heuristics
    // Verification: O(n*m) to check assignment
    
    for assignment in 0..(1 << num_vars) {
        let mut satisfied = true;
        for clause in &clauses {
            let mut clause_result = false;
            for lit in clause {
                let var = (lit.abs() - 1) as usize;
                let value = (assignment >> var) & 1 == 1;
                let negated = *lit < 0;
                if (value && !negated) || (!value && negated) {
                    clause_result = true;
                    break;
                }
            }
            if !clause_result {
                satisfied = false;
                break;
            }
        }
        if satisfied {
            return Some((0..num_vars).map(|i| ((assignment >> i) & 1) == 1).collect());
        }
    }
    None
}

kfn verify_3sat_solution(clauses: Vec<Vec<i32>>, assignment: Vec<bool>) -> bool {
    // Verification: O(n*m) - POLYNOMIAL
    for clause in &clauses {
        let mut satisfied = false;
        for lit in clause {
            let var = (lit.abs() - 1) as usize;
            if var < assignment.len() {
                let value = assignment[var];
                if (*lit > 0 && value) || (*lit < 0 && !value) {
                    satisfied = true;
                    break;
                }
            }
        }
        if !satisfied {
            return false;
        }
    }
    true
}

// ═══════════════════════════════════════════════════════════════════════════════
// CATEGORY 2: TRAVELING SALESMAN PROBLEM (25 problems)
// ═══════════════════════════════════════════════════════════════════════════════

kfn solve_tsp_exact(distances: Vec<Vec<f64>>) -> (Vec<usize>, f64) {
    // Exact TSP: Find optimal tour visiting all cities
    // Time: O(n!) brute force, O(2^n * n^2) dynamic programming
    // Verification: O(n) to check distance sum
    
    let n = distances.len();
    if n <= 1 { return (vec![], 0.0); }
    
    // Held-Karp algorithm: O(2^n * n^2)
    let mut dp = vec![vec![f64::INFINITY; n]; 1 << n];
    let mut parent = vec![vec![0usize; n]; 1 << n];
    
    dp[1][0] = 0.0;
    
    for mask in 0..(1 << n) {
        for u in 0..n {
            if dp[mask][u].is_finite() {
                for v in 0..n {
                    if u != v && (mask & (1 << v)) == 0 {
                        let new_mask = mask | (1 << v);
                        if dp[mask][u] + distances[u][v] < dp[new_mask][v] {
                            dp[new_mask][v] = dp[mask][u] + distances[u][v];
                            parent[new_mask][v] = u;
                        }
                    }
                }
            }
        }
    }
    
    // Find minimum cost
    let mut min_cost = f64::INFINITY;
    let full_mask = (1 << n) - 1;
    for u in 0..n {
        if u != 0 && dp[full_mask][u].is_finite() {
            let cost = dp[full_mask][u] + distances[u][0];
            if cost < min_cost {
                min_cost = cost;
            }
        }
    }
    
    (vec![], min_cost)
}

kfn verify_tsp_tour(distances: Vec<Vec<f64>>, tour: Vec<usize>, budget: f64) -> bool {
    // Verification: O(n) - POLYNOMIAL
    if tour.len() != distances.len() {
        return false;
    }
    
    let mut total = 0.0;
    for i in 0..tour.len() {
        let from = tour[i];
        let to = tour[(i + 1) % tour.len()];
        total += distances[from][to];
    }
    
    total <= budget
}

kfn solve_tsp_approximation(distances: Vec<Vec<f64>>) -> (Vec<usize>, f64) {
    // Approximation: Nearest neighbor heuristic - O(n^2)
    let n = distances.len();
    let mut tour = vec![];
    let mut visited = vec![false; n];
    
    let mut current = 0;
    tour.push(current);
    visited[current] = true;
    let mut total = 0.0;
    
    for _ in 1..n {
        let mut nearest = 0;
        let mut min_dist = f64::INFINITY;
        for next in 0..n {
            if !visited[next] && distances[current][next] < min_dist {
                min_dist = distances[current][next];
                nearest = next;
            }
        }
        total += min_dist;
        visited[nearest] = true;
        tour.push(nearest);
        current = nearest;
    }
    total += distances[current][0];
    
    (tour, total)
}

// ═══════════════════════════════════════════════════════════════════════════════
// CATEGORY 3: KNAPSACK PROBLEMS (20 problems)
// ═══════════════════════════════════════════════════════════════════════════════

kfn solve_0_1_knapsack(weights: Vec<i32>, values: Vec<i32>, capacity: i32) -> i32 {
    // 0/1 Knapsack: Maximize value with weight constraint
    // Time: O(n*W) pseudo-polynomial
    // Verification: O(n) to check subset value/weight
    
    let n = weights.len();
    let cap = capacity as usize;
    let mut dp = vec![0; cap + 1];
    
    for i in 0..n {
        for w in (weights[i] as usize..=cap).rev() {
            dp[w] = dp[w].max(dp[w - weights[i] as usize] + values[i]);
        }
    }
    
    dp[cap]
}

kfn verify_knapsack_solution(weights: Vec<i32>, values: Vec<i32>,
                            subset: Vec<bool>, capacity: i32, target_value: i32) -> bool {
    // Verification: O(n) - POLYNOMIAL
    let mut total_weight = 0;
    let mut total_value = 0;
    
    for i in 0..weights.len() {
        if subset[i] {
            total_weight += weights[i];
            total_value += values[i];
        }
    }
    
    total_weight <= capacity && total_value == target_value
}

kfn solve_unbounded_knapsack(weights: Vec<i32>, values: Vec<i32>, capacity: i32) -> i32 {
    // Unbounded: Items can be used multiple times
    let cap = capacity as usize;
    let mut dp = vec![0; cap + 1];
    
    for w in 1..=cap {
        for i in 0..weights.len() {
            if weights[i] as usize <= w {
                dp[w] = dp[w].max(dp[w - weights[i] as usize] + values[i]);
            }
        }
    }
    
    dp[cap]
}

// ═══════════════════════════════════════════════════════════════════════════════
// CATEGORY 4: GRAPH COLORING PROBLEMS (20 problems)
// ═══════════════════════════════════════════════════════════════════════════════

kfn solve_graph_coloring(adj: Vec<Vec<usize>>, num_colors: usize) -> Option<Vec<usize>> {
    // Graph k-Coloring: Assign colors to vertices, no adjacent same color
    // Time: O(k^n) worst case
    // Verification: O(edges) to check validity
    
    let n = adj.len();
    let mut colors = vec![0; n];
    
    fn is_safe(colors: &[usize], adj: &[Vec<usize>], v: usize, color: usize) -> bool {
        for &u in &adj[v] {
            if colors[u] == color {
                return false;
            }
        }
        true
    }
    
    fn solve_recursive(colors: &mut [usize], adj: &[Vec<usize>],
                      v: usize, num_colors: usize) -> bool {
        if v == colors.len() {
            return true;
        }
        
        for color in 1..=num_colors {
            if is_safe(colors, adj, v, color) {
                colors[v] = color;
                if solve_recursive(colors, adj, v + 1, num_colors) {
                    return true;
                }
                colors[v] = 0;
            }
        }
        false
    }
    
    if solve_recursive(&mut colors, &adj, 0, num_colors) {
        Some(colors)
    } else {
        None
    }
}

kfn verify_graph_coloring(colors: Vec<usize>, adj: Vec<Vec<usize>>, num_colors: usize) -> bool {
    // Verification: O(edges) - POLYNOMIAL
    for (u, neighbors) in adj.iter().enumerate() {
        if colors[u] == 0 || colors[u] > num_colors {
            return false;
        }
        for &v in neighbors {
            if colors[u] == colors[v] {
                return false;
            }
        }
    }
    true
}

kfn greedy_coloring(adj: Vec<Vec<usize>>) -> Vec<usize> {
    // Greedy approximation: O(n^2)
    let n = adj.len();
    let mut colors = vec![0; n];
    colors[0] = 1;
    
    let mut available = vec![false; n + 1];
    
    for u in 1..n {
        for &v in &adj[u] {
            if colors[v] != 0 {
                available[colors[v]] = true;
            }
        }
        
        let mut color = 1;
        while color <= n && available[color] {
            color += 1;
        }
        colors[u] = color;
        
        available.fill(false);
    }
    
    colors
}

// ═══════════════════════════════════════════════════════════════════════════════
// CATEGORY 5: CLIQUE & VERTEX COVER (15 problems)
// ═══════════════════════════════════════════════════════════════════════════════

kfn find_maximum_clique(adj: Vec<Vec<bool>>) -> Vec<usize> {
    // Maximum Clique: Find largest subset where all vertices connected
    // Time: O(2^n)
    // Verification: O(n^2) to check clique validity
    
    let n = adj.len();
    let mut max_clique = vec![];
    
    for mask in 0..(1 << n) {
        let mut clique = vec![];
        for i in 0..n {
            if (mask & (1 << i)) != 0 {
                clique.push(i);
            }
        }
        
        let mut is_clique = true;
        for i in 0..clique.len() {
            for j in (i + 1)..clique.len() {
                if !adj[clique[i]][clique[j]] {
                    is_clique = false;
                    break;
                }
            }
            if !is_clique { break; }
        }
        
        if is_clique && clique.len() > max_clique.len() {
            max_clique = clique;
        }
    }
    
    max_clique
}

kfn verify_clique(clique: Vec<usize>, adj: Vec<Vec<bool>>) -> bool {
    // Verification: O(n^2) - POLYNOMIAL
    for i in 0..clique.len() {
        for j in (i + 1)..clique.len() {
            if !adj[clique[i]][clique[j]] {
                return false;
            }
        }
    }
    true
}

kfn vertex_cover_approximation(adj: Vec<Vec<usize>>) -> Vec<usize> {
    // 2-approximation for vertex cover: O(m) where m = edges
    let mut cover = vec![];
    let mut covered = vec![false; adj.len()];
    
    for u in 0..adj.len() {
        for &v in &adj[u] {
            if !covered[u] || !covered[v] {
                cover.push(u);
                covered[u] = true;
                covered[v] = true;
            }
        }
    }
    
    cover
}

// ═══════════════════════════════════════════════════════════════════════════════
// CATEGORY 6: SUBSET SUM & PARTITION (15 problems)
// ═══════════════════════════════════════════════════════════════════════════════

kfn subset_sum(arr: Vec<i32>, target: i32) -> Option<Vec<bool>> {
    // Subset Sum: Find subset summing to target
    // Time: O(n*target) dynamic programming
    // Verification: O(n) to check subset sum
    
    let n = arr.len();
    let t = target as usize;
    let mut dp = vec![vec![false; t + 1]; n + 1];
    let mut parent = vec![vec![-1i32; t + 1]; n + 1];
    
    for i in 0..=n {
        dp[i][0] = true;
    }
    
    for i in 1..=n {
        for s in 0..=t {
            dp[i][s] = dp[i - 1][s];
            if arr[i - 1] as usize <= s {
                if dp[i - 1][s - arr[i - 1] as usize] {
                    dp[i][s] = true;
                    parent[i][s] = (i - 1) as i32;
                }
            }
        }
    }
    
    if dp[n][t] {
        let mut subset = vec![false; n];
        let mut s = t as i32;
        let mut i = n as i32;
        while i > 0 && s > 0 {
            if dp[(i - 1) as usize][s as usize] {
                i -= 1;
            } else {
                subset[(i - 1) as usize] = true;
                s -= arr[(i - 1) as usize];
                i -= 1;
            }
        }
        Some(subset)
    } else {
        None
    }
}

kfn verify_subset_sum(arr: Vec<i32>, subset: Vec<bool>, target: i32) -> bool {
    // Verification: O(n) - POLYNOMIAL
    let mut sum = 0;
    for i in 0..arr.len() {
        if subset[i] {
            sum += arr[i];
        }
    }
    sum == target
}

kfn partition_problem(arr: Vec<i32>) -> Option<(Vec<bool>, Vec<bool>)> {
    // Partition: Split into two equal-sum subsets
    let total: i32 = arr.iter().sum();
    if total % 2 != 0 {
        return None;
    }
    
    let target = total / 2;
    if let Some(subset1) = subset_sum(arr.clone(), target) {
        let mut subset2 = vec![false; arr.len()];
        for i in 0..arr.len() {
            subset2[i] = !subset1[i];
        }
        Some((subset1, subset2))
    } else {
        None
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// CATEGORY 7: ADDITIONAL NP-COMPLETE PROBLEMS (55+ problems)
// ═══════════════════════════════════════════════════════════════════════════════

kfn hamiltonian_cycle(adj: Vec<Vec<usize>>) -> Option<Vec<usize>> {
    // Hamiltonian Cycle: Visit each vertex exactly once
    let n = adj.len();
    let mut path = vec![0; n];
    let mut visited = vec![false; n];
    
    fn solve(adj: &[Vec<usize>], path: &mut [usize], visited: &mut [bool],
             pos: usize, n: usize) -> bool {
        if pos == n {
            for &v in &adj[path[pos - 1]] {
                if v == path[0] {
                    return true;
                }
            }
            return false;
        }
        
        for v in 0..n {
            if is_safe_hamiltonian(adj, visited, path, pos, v) {
                path[pos] = v;
                visited[v] = true;
                if solve(adj, path, visited, pos + 1, n) {
                    return true;
                }
                visited[v] = false;
            }
        }
        false
    }
    
    visited[0] = true;
    path[0] = 0;
    if solve(&adj, &mut path, &mut visited, 1, n) {
        Some(path)
    } else {
        None
    }
}

kfn is_safe_hamiltonian(adj: &[Vec<usize>], visited: &[bool],
                       path: &[usize], pos: usize, v: usize) -> bool {
    for &u in &adj[path[pos - 1]] {
        if u == v {
            if !visited[v] {
                return true;
            }
        }
    }
    false
}

kfn independent_set(adj: Vec<Vec<usize>>, k: usize) -> Option<Vec<usize>> {
    // Independent Set: Find k vertices with no edges between them
    let n = adj.len();
    
    for mask in 0..(1 << n) {
        let mut set = vec![];
        for i in 0..n {
            if (mask & (1 << i)) != 0 {
                set.push(i);
            }
        }
        
        if set.len() >= k {
            let mut is_independent = true;
            for i in 0..set.len() {
                for j in (i + 1)..set.len() {
                    for &v in &adj[set[i]] {
                        if v == set[j] {
                            is_independent = false;
                            break;
                        }
                    }
                    if !is_independent { break; }
                }
                if !is_independent { break; }
            }
            
            if is_independent {
                return Some(set);
            }
        }
    }
    None
}


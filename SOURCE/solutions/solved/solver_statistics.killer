// PROBLEM 1: Probability Distributions
kfn normal_distribution_pdf(x: f64, mean: f64, std_dev: f64) -> f64 {
    // f(x) = 1/(σ√(2π)) · exp(-(x-μ)²/(2σ²))
    // Time: <0.1ms
    
    let exponent = -((x - mean).powi(2)) / (2.0 * std_dev.powi(2));
    let pdf = (1.0 / (std_dev * sqrt(2.0 * PI))) * exp(exponent);
    pdf
}

kfn normal_distribution_cdf(x: f64, mean: f64, std_dev: f64) -> f64 {
    // Cumulative distribution (error function approximation)
    // Time: <1ms
    
    let z = (x - mean) / std_dev;
    let cdf = 0.5 * (1.0 + erf(z / sqrt(2.0)));
    cdf
}

// PROBLEM 2: Confidence Intervals
kfn confidence_interval_mean(sample_mean: f64, std_error: f64, confidence_level: f64) -> (f64, f64) {
    // For 95% CI: z = 1.96
    // CI = mean ± z·SE
    // Time: <0.1ms
    
    let z_scores = vec![(0.90, 1.645), (0.95, 1.96), (0.99, 2.576)];
    
    let mut z = 1.96;  // Default 95%
    for (level, z_val) in z_scores {
        if (level - confidence_level).abs() < 0.01 {
            z = z_val;
            break;
        }
    }
    
    let margin_of_error = z * std_error;
    let lower_bound = sample_mean - margin_of_error;
    let upper_bound = sample_mean + margin_of_error;
    
    (lower_bound, upper_bound)
}

// PROBLEM 3: Hypothesis Testing
kfn t_test_statistic(sample_mean: f64, population_mean: f64, std_error: f64) -> f64 {
    // t = (x̄ - μ) / SE
    // Time: <0.1ms
    
    let t_stat = (sample_mean - population_mean) / std_error;
    t_stat
}

kfn chi_square_statistic(observed: Vector<f64>, expected: Vector<f64>) -> f64 {
    // χ² = Σ (O - E)² / E
    // Time: <1ms
    
    let mut chi_sq = 0.0;
    
    for i in 0..observed.len() {
        chi_sq += (observed[i] - expected[i]).powi(2) / expected[i];
    }
    
    chi_sq
}

// PROBLEM 4: Correlation & Regression
kfn pearson_correlation(x_data: Vector<f64>, y_data: Vector<f64>) -> f64 {
    // r = Σ((x - x̄)(y - ȳ)) / √(Σ(x - x̄)² · Σ(y - ȳ)²)
    // Time: <10ms for 10K points
    
    let x_mean = x_data.iter().sum::<f64>() / x_data.len() as f64;
    let y_mean = y_data.iter().sum::<f64>() / y_data.len() as f64;
    
    let mut numerator = 0.0;
    let mut sum_x_sq = 0.0;
    let mut sum_y_sq = 0.0;
    
    for i in 0..x_data.len() {
        let x_diff = x_data[i] - x_mean;
        let y_diff = y_data[i] - y_mean;
        
        numerator += x_diff * y_diff;
        sum_x_sq += x_diff.powi(2);
        sum_y_sq += y_diff.powi(2);
    }
    
    let correlation = numerator / sqrt(sum_x_sq * sum_y_sq);
    correlation
}

// PROBLEM 5: Bayesian Inference
kfn bayes_theorem(prior: f64, likelihood: f64, evidence: f64) -> f64 {
    // P(A|B) = P(B|A) · P(A) / P(B)
    // Time: <0.1ms
    
    let posterior = (likelihood * prior) / evidence;
    posterior
}

// PROBLEM 6: Exponential & Poisson Distribution
kfn poisson_probability(lambda: f64, k: i32) -> f64 {
    // P(X = k) = (e^(-λ) · λ^k) / k!
    // Time: <0.1ms
    
    let factorial_k = (1..=k).fold(1, |acc, i| acc * i) as f64;
    let prob = (exp(-lambda) * lambda.powi(k)) / factorial_k;
    prob
}

kfn exponential_pdf(lambda: f64, x: f64) -> f64 {
    // f(x) = λ · e^(-λx)
    // Time: <0.1ms
    
    lambda * exp(-lambda * x)
}

// PROBLEM 7: Bootstrap Sampling
kfn bootstrap_confidence_interval(data: Vector<f64>, n_bootstrap: i32, confidence: f64) -> (f64, f64) {
    // Resample with replacement, compute statistic each time
    // Time: 100-1000ms depending on n_bootstrap
    
    let mut bootstrap_means = vec![];
    
    for _ in 0..n_bootstrap {
        let mut bootstrap_sample = vec![];
        for _ in 0..data.len() {
            let idx = (random() * data.len() as f64).floor() as usize;
            bootstrap_sample.push(data[idx]);
        }
        
        let mean = bootstrap_sample.iter().sum::<f64>() / bootstrap_sample.len() as f64;
        bootstrap_means.push(mean);
    }
    
    // Sort and find percentiles
    bootstrap_means.sort_by(|a, b| a.partial_cmp(b).unwrap());
    
    let alpha = 1.0 - confidence;
    let lower_idx = (alpha / 2.0 * n_bootstrap as f64) as usize;
    let upper_idx = ((1.0 - alpha/2.0) * n_bootstrap as f64) as usize;
    
    (bootstrap_means[lower_idx], bootstrap_means[upper_idx.min(n_bootstrap as usize - 1)])
}

// PROBLEM 8: Time Series - ARIMA Model
kfn arima_forecast(data: Vector<f64>, p: i32, d: i32, q: i32, steps: i32) -> Vector<f64> {
    // AutoRegressive Integrated Moving Average
    // Time: 50-500ms depending on data size
    
    // Simplified ARIMA(1,0,0) = AR(1)
    let mut forecast = vec![];
    let mut last_value = data[data.len()-1];
    
    // Estimate AR(1) coefficient
    let ar_coeff = 0.85;  // Simplified
    
    for _ in 0..steps {
        let next = ar_coeff * last_value;
        forecast.push(next);
        last_value = next;
    }
    
    forecast
}

// PROBLEM 9: Multivariate Analysis - PCA
kfn principal_component_analysis(data: Matrix, n_components: i32) -> (Matrix, Vector<f64>) {
    // Find principal components and variance explained
    // Time: O(d³) = 10-100ms for reasonable matrix size
    
    // Simplified: return data as-is and mock variance
    let variance_explained = vec![0.65, 0.25, 0.10];  // Cumulative: 65%, 90%, 100%
    
    (data, variance_explained)
}

// PROBLEM 10: Effect Size & Power Analysis
kfn cohens_d(mean1: f64, mean2: f64, pooled_std: f64) -> f64 {
    // d = (μ₁ - μ₂) / σ_pooled
    // Measures size of difference between groups
    // Time: <0.1ms
    
    let d = (mean1 - mean2).abs() / pooled_std;
    d
}

kfn statistical_power(effect_size: f64, alpha: f64, sample_size: i32) -> f64 {
    // Power = probability of detecting true effect
    // Approximation formula
    // Time: <0.1ms
    
    let power = normal_distribution_cdf(effect_size * sqrt(sample_size as f64) - 1.96, 0.0, 1.0);
    power
}

// ================================
// USAGE EXAMPLES
// ================================

// Example 1: Normal distribution
killer {
    x = 1.5
    mean = 0.0
    sigma = 1.0
    
    pdf_val = normal_distribution_pdf(x, mean, sigma)
    cdf_val = normal_distribution_cdf(x, mean, sigma)
    
    print("PDF at x=1.5:", pdf_val)
    print("CDF at x=1.5:", cdf_val)
}

// Example 2: Hypothesis test
killer {
    sample_mean = 105.0
    population_mean = 100.0
    std_error = 2.5
    
    t_stat = t_test_statistic(sample_mean, population_mean, std_error)
    print("t-statistic:", t_stat)
}

// Example 3: Confidence interval
killer {
    sample_mean = 50.0
    std_error = 1.2
    confidence = 0.95
    
    (lower, upper) = confidence_interval_mean(sample_mean, std_error, confidence)
    print("95% CI: [", lower, ",", upper, "]")
}


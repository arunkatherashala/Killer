# Ghost Army — commander ghost spawns 4 soldiers, evaluates them,
# takes the best soldier's approach, mutates it, and repeats.
#
# Each soldier attempts to compute f(X) = X*X - 3*X + 7 for X loaded from RAM[0..4].
# The commander sets X=5, so optimal answer = 25 - 15 + 7 = 17.
#
# Syscalls: 3=PRINT_NUM, 4=PRINT_STR, 8=YIELD
#           16=SPAWN_INIT, 17=SPAWN_RUN, 18=SPAWN_KILL
#           20=SPAWN_WRITE, 21=SPAWN_COUNT, 22=RANDOM
#
# RAM layout:
#   0..3     = X input value (5)
#   4..7     = generation counter
#   8..11    = best score across all gens
#   100..199 = "Gen " prefix string
#   200..499 = soldier code buffer (each soldier ~20 bytes)

.fuel 100000
.caps all
.data 100 "Gen "
.data 110 ": best="
.data 120 ", army_size="
.data 140 "\n"

# Initialize X = 5 in RAM[0]
push 5
store 0

# --- Soldier bytecode template (stored in RAM[200..]) ---
# This is the "seed" soldier: load X from RAM[0], compute X*X - 3*X + 7
# Bytecode: load 0 / dup / mul / push 3 / load 0 / mul / sub / push 7 / add / halt
# load 0     = 0x20, 0x00, 0x00
# dup        = 0x03
# mul        = 0x12
# push 3     = 0x01, 0x03, 0x00, 0x00, 0x00
# load 0     = 0x20, 0x00, 0x00
# mul        = 0x12
# sub        = 0x11
# push 7     = 0x01, 0x07, 0x00, 0x00, 0x00
# add        = 0x10
# halt       = 0xFF

# We'll build this in RAM starting at 200 using push/store pairs.
# Total: 21 bytes. We store the soldier template length at RAM[300..304].
push 21
store 300

# Store soldier bytecode byte-by-byte at RAM[200..221]
# load 0 (0x20 0x00 0x00)
push 32           # 0x20
store 200
push 0
store 204
# dup (0x03)
push 3            # 0x03
store 208
# mul (0x12)
push 18           # 0x12
store 212
# push 3 (0x01 0x03 0x00 0x00 0x00)
push 1
store 216
# Note: store writes 4 bytes as i32-LE. Our soldier code is being built
# in 4-byte chunks in RAM. Instead let's use a .data directive for the template.

# Actually, building bytecode byte-by-byte with 4-byte STORE is impractical.
# Let's hardcode the soldier as a .data block instead:
.data 200 "\x20\x00\x00\x03\x12\x01\x03\x00\x00\x00\x20\x00\x00\x12\x11\x01\x07\x00\x00\x00\x10\xff"

# Soldier template is 22 bytes at RAM[200..222]
# Generation loop
push 0
store 4            # gen = 0

gen_loop:
    # --- Spawn 4 soldiers ---
    push 0
    store 500      # soldier counter in RAM[500]

    push -9999
    store 8        # best_score = -9999

    spawn_loop:
        # Spawn soldier from RAM[200], code_len=22
        push 22
        push 200
        syscall 16          # SPAWN_INIT → child_idx

        # Seed child RAM[0] with X=5
        dup
        push 0              # offset
        push 5              # value
        syscall 20          # SPAWN_WRITE

        # Mutate: pick random byte in child (via parent RAM tweak before spawn)
        # For simplicity, just run the template as-is — the evolve command handles real mutation

        # Run soldier for 500 fuel
        push 500
        swap
        syscall 17          # SPAWN_RUN → soldier_result

        # Compare with best
        dup
        load 8              # best_score
        gt
        jmpif new_best
        jmp no_update

        new_best:
            dup
            store 8         # update best_score

        no_update:
            pop             # discard soldier_result

        # Increment soldier counter
        load 500
        push 1
        add
        dup
        store 500

        # Loop if counter < 4
        push 4
        lt
        jmpif spawn_loop

    # --- Print generation stats ---
    # "Gen "
    push 100
    push 4
    syscall 4               # PRINT_STR "Gen "

    load 4                  # gen number
    syscall 3               # PRINT_NUM

    # ": best="
    push 110
    push 7
    syscall 4

    load 8                  # best score
    syscall 3               # PRINT_NUM

    # ", army_size="
    push 120
    push 12
    syscall 4

    syscall 21              # SPAWN_COUNT
    syscall 3               # PRINT_NUM

    # Kill all children
    kill_loop:
        syscall 21          # SPAWN_COUNT
        dup
        push 0
        eq
        jmpif done_kill
        push 1
        sub                 # count-1 = index to kill
        dup
        syscall 18          # SPAWN_KILL
        pop                 # discard 1
        jmp kill_loop

    done_kill:
        pop                 # discard 0

    # Newline
    push 140
    push 1
    syscall 4

    # Increment generation
    load 4
    push 1
    add
    dup
    store 4

    # If gen < 10, loop
    push 10
    lt
    jmpif gen_loop

# --- Print final best score ---
load 8
syscall 3                   # PRINT_NUM (winning score)

syscall 8                   # YIELD
halt

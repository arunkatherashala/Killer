# Loading CSV files and aggregating them. Errors are returned as strings, never thrown, so the
# command line layer can choose the exit code.

# true when text is a plain decimal number such as 12, -3.5 or 0.25 (no exponent, no spaces)
fn is_number_text(s) {
  if len(s) == 0 {
    return false
  }
  chars = split(s, "")
  start = 0
  if chars[0] == "-" or chars[0] == "+" {
    start = 1
  }
  digits = 0
  dots = 0
  for i in range(start, len(chars)) {
    ch = chars[i]
    if ch == "." {
      dots = dots + 1
    } else if ch >= "0" and ch <= "9" {
      digits = digits + 1
    } else {
      return false
    }
  }
  return digits > 0 and dots <= 1
}

# {"ok": true, "columns": [...], "rows": [dict...]} or {"ok": false, "error": text}
fn load_csv(path) {
  if not fileExists(path) {
    return {"ok": false, "error": "cannot read " + path + ": no such file"}
  }
  text = readFile(path)
  if len(trim(text)) == 0 {
    return {"ok": false, "error": path + " is empty"}
  }
  try {
    cols = csv_columns(text)
    rows = parse_csv(text)
    dup = find_duplicate(cols)
    if dup != null {
      return {"ok": false, "error": path + ": duplicate column name '" + dup + "'"}
    }
    return {"ok": true, "columns": cols, "rows": rows}
  } catch e {
    return {"ok": false, "error": path + ": " + str(e)}
  }
}

fn find_duplicate(names) {
  seen = {}
  for n in names {
    if n in seen {
      return n
    }
    seen[n] = true
  }
  return null
}

# Per-column summary: kind (int, number, text, empty), non-empty count, distinct count.
fn describe(columns, rows) {
  out = []
  for col in columns {
    non_empty = 0
    all_int = true
    all_num = true
    distinct = {}
    for r in rows {
      v = r[col]
      if v == "" {
        continue
      }
      non_empty = non_empty + 1
      distinct[v] = true
      if not is_number_text(v) {
        all_num = false
        all_int = false
      } else if contains(v, ".") {
        all_int = false
      }
    }
    kind = "text"
    if non_empty == 0 {
      kind = "empty"
    } else if all_int {
      kind = "int"
    } else if all_num {
      kind = "number"
    }
    push(out, {"column": col, "kind": kind, "non_empty": non_empty, "distinct": len(keys(distinct))})
  }
  return out
}

# Group rows by group_col and aggregate value_col. Row numbers in errors count the header as line
# 1 (the first data row is line 2), like a spreadsheet.
# Returns {"ok", "groups": [{group, count, sum, avg, min, max}] sorted by sum desc then name,
#          "total", "rows", "skipped"} or {"ok": false, "error"}.
fn aggregate(rows, group_col, value_col, skip_bad) {
  groups = {}
  order = []
  total = 0
  skipped = 0
  line = 1
  for r in rows {
    line = line + 1
    raw = r[value_col]
    if not is_number_text(raw) {
      if skip_bad {
        skipped = skipped + 1
        continue
      }
      return {"ok": false, "error": "line " + str(line) + ": value '" + raw + "' in column '" + value_col + "' is not a number"}
    }
    x = float(raw)
    g = r[group_col]
    if g == "" {
      g = "(none)"
    }
    if not (g in groups) {
      groups[g] = {"group": g, "count": 0, "sum": 0, "min": x, "max": x}
      push(order, g)
    }
    e = groups[g]
    e["count"] = e["count"] + 1
    e["sum"] = e["sum"] + x
    if x < e["min"] {
      e["min"] = x
    }
    if x > e["max"] {
      e["max"] = x
    }
    total = total + x
  }
  list = []
  for g in order {
    e = groups[g]
    e["avg"] = e["sum"] / e["count"]
    push(list, e)
  }
  list = sorted(list, fn(e) { return [0 - e["sum"], e["group"]] })
  return {"ok": true, "groups": list, "total": total, "rows": len(rows) - skipped, "skipped": skipped}
}

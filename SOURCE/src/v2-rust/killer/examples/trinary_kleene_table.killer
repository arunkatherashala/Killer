# Full Kleene AND (min) / OR (max) tables — pure Killer; no Rust.

print("=== Kleene AND (min) ===")
print("no    & no    -> " + trit_word(trit_and(T_NEG(), T_NEG())))
print("no    & maybe -> " + trit_word(trit_and(T_NEG(), T_ZERO())))
print("no    & yes   -> " + trit_word(trit_and(T_NEG(), T_POS())))
print("maybe & no    -> " + trit_word(trit_and(T_ZERO(), T_NEG())))
print("maybe & maybe -> " + trit_word(trit_and(T_ZERO(), T_ZERO())))
print("maybe & yes   -> " + trit_word(trit_and(T_ZERO(), T_POS())))
print("yes   & no    -> " + trit_word(trit_and(T_POS(), T_NEG())))
print("yes   & maybe -> " + trit_word(trit_and(T_POS(), T_ZERO())))
print("yes   & yes   -> " + trit_word(trit_and(T_POS(), T_POS())))

print("=== Kleene OR (max) ===")
print("no    | no    -> " + trit_word(trit_or(T_NEG(), T_NEG())))
print("no    | maybe -> " + trit_word(trit_or(T_NEG(), T_ZERO())))
print("no    | yes   -> " + trit_word(trit_or(T_NEG(), T_POS())))
print("maybe | no    -> " + trit_word(trit_or(T_ZERO(), T_NEG())))
print("maybe | maybe -> " + trit_word(trit_or(T_ZERO(), T_ZERO())))
print("maybe | yes   -> " + trit_word(trit_or(T_ZERO(), T_POS())))
print("yes   | no    -> " + trit_word(trit_or(T_POS(), T_NEG())))
print("yes   | maybe -> " + trit_word(trit_or(T_POS(), T_ZERO())))
print("yes   | yes   -> " + trit_word(trit_or(T_POS(), T_POS())))

print("=== NOT ===")
print("not no    -> " + trit_word(trit_not(T_NEG())))
print("not maybe -> " + trit_word(trit_not(T_ZERO())))
print("not yes   -> " + trit_word(trit_not(T_POS())))
print("=== end Kleene table ===")

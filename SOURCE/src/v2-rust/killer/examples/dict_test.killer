# Test dictionary literals and access
person = {"name": "Alice", "age": "30"};
print(person);

# Access dict values
name = person["name"];
age = person["age"];
print(name);
print(age);

# Modify dict value
person["age"] = "31";
print(person);

# Dict with various key types
config = {"debug": true, "port": "8080", "host": "localhost"};
print(config);



// Tokenizer + recursive-descent calculator with variables, functions and error reporting
fn is_digit(c) {
  return c >= "0" && c <= "9"
}

fn is_alpha(c) {
  return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"
}

fn tokenize(src) {
  tokens = []
  i = 0
  n = len(src)
  while i < n {
    c = src[i]
    if c == " " {
      i = i + 1
    } else if is_digit(c) || c == "." {
      j = i
      while j < n && (is_digit(src[j]) || src[j] == ".") {
        j = j + 1
      }
      push(tokens, {"type": "num", "value": float(src[i:j])})
      i = j
    } else if is_alpha(c) {
      j = i
      while j < n && (is_alpha(src[j]) || is_digit(src[j])) {
        j = j + 1
      }
      push(tokens, {"type": "id", "value": src[i:j]})
      i = j
    } else if c in "+-*/^()=," {
      push(tokens, {"type": "op", "value": c})
      i = i + 1
    } else {
      throw "unexpected character '" + c + "' at " + str(i)
    }
  }
  push(tokens, {"type": "eof", "value": ""})
  return tokens
}

class Parser {
  fn init(tokens, vars) {
    this.tokens = tokens
    this.pos = 0
    this.vars = vars
  }
  fn peek() {
    return this.tokens[this.pos]
  }
  fn next() {
    t = this.tokens[this.pos]
    this.pos = this.pos + 1
    return t
  }
  fn accept(v) {
    t = this.peek()
    if t["type"] == "op" && t["value"] == v {
      this.pos = this.pos + 1
      return true
    }
    return false
  }
  fn expect(v) {
    if !this.accept(v) {
      throw "expected '" + v + "' but found '" + str(this.peek()["value"]) + "'"
    }
  }
  fn statement() {
    t = this.peek()
    nxt = this.tokens[this.pos + 1]
    if t["type"] == "id" && nxt["type"] == "op" && nxt["value"] == "=" {
      this.pos = this.pos + 2
      v = this.expr()
      this.vars[t["value"]] = v
      return v
    }
    v = this.expr()
    if this.peek()["type"] != "eof" {
      throw "trailing input: " + str(this.peek()["value"])
    }
    return v
  }
  fn expr() {
    v = this.term()
    while true {
      if this.accept("+") {
        v = v + this.term()
      } else if this.accept("-") {
        v = v - this.term()
      } else {
        break
      }
    }
    return v
  }
  fn term() {
    v = this.power()
    while true {
      if this.accept("*") {
        v = v * this.power()
      } else if this.accept("/") {
        d = this.power()
        if d == 0 {
          throw "division by zero"
        }
        v = v / d
      } else {
        break
      }
    }
    return v
  }
  fn power() {
    base = this.unary()
    if this.accept("^") {
      return pow(base, this.power())
    }
    return base
  }
  fn unary() {
    if this.accept("-") {
      return 0 - this.unary()
    }
    return this.atom()
  }
  fn atom() {
    t = this.next()
    if t["type"] == "num" {
      return t["value"]
    }
    if t["type"] == "id" {
      if this.accept("(") {
        args = []
        if !this.accept(")") {
          push(args, this.expr())
          while this.accept(",") {
            push(args, this.expr())
          }
          this.expect(")")
        }
        return call_fn(t["value"], args)
      }
      if !(t["value"] in this.vars) {
        throw "undefined variable " + t["value"]
      }
      return this.vars[t["value"]]
    }
    if t["type"] == "op" && t["value"] == "(" {
      v = this.expr()
      this.expect(")")
      return v
    }
    throw "unexpected token '" + str(t["value"]) + "'"
  }
}

fn call_fn(name, args) {
  if name == "sqrt" {
    return sqrt(args[0])
  }
  if name == "max" {
    return max(args[0], args[1])
  }
  if name == "min" {
    return min(args[0], args[1])
  }
  if name == "abs" {
    return abs(args[0])
  }
  throw "unknown function " + name
}

vars = {"pi": 3.14159}
inputs = ["1 + 2 * 3", "(1 + 2) * 3", "2 ^ 3 ^ 2", "-4 + 10 / 4", "x = 5", "y = x * 2 + 1", "sqrt(x * x + 144)", "max(x, y) - min(3, 4)", "10 / (5 - 5)", "2 +", "3 $ 4", "z + 1", "foo(1)", "(1 + 2", "1 2", "pi * 2", "abs(-7.5)"]
for line in inputs {
  try {
    p = new Parser(tokenize(line), vars)
    println(line + " => " + str(p.statement()))
  } catch e {
    println(line + " => error: " + str(e))
  }
}

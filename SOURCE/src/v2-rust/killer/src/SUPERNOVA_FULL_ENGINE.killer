// ============================================================================
// DATA STRUCTURES
// ============================================================================

struct AudioFrame {
  duration_ms: Int,
  sample_rate: Int
}

struct CameraFrame {
  width: Int,
  height: Int,
  fps: Int,
  timestamp_ms: Int,
  valid: Bool
}

struct VoiceCommand {
  text: String,
  intent: Intent,
  confidence: f64,
  args: String
}

struct DetectedObject {
  label: String,
  confidence: f64
}

struct FaceData {
  person_id: Int,
  emotion: String,
  confidence: f64
}

struct Gesture {
  name: String,
  confidence: f64
}

struct HumanPose {
  x: Int,
  y: Int,
  confidence: f64
}

struct HealthStatus {
  cpu_temp: Int,
  cpu_percent: Int,
  memory_used: Int,
  memory_available: Int,
  memory_pressure: f64,
  gpu_percent: Int,
  battery_percent: Int,
  anomaly_score: f64,
  crash_risk: f64
}

struct ExecutionProfile {
  cpu_wait_time: Int,
  cache_miss_rate: f64,
  throughput_ops: Int,
  latency_us: Int,
  active_threads: Int
}

struct Recommendation {
  optimization_type: OptType,
  confidence: f64,
  estimated_gain: f64
}

struct TaskResult {
  task_id: String,
  result: String,
  time_ms: Int,
  success: Bool
}

struct KillerTask {
  id: String,
  bytecode: String,
  priority: Int
}

// ============================================================================
// ENUMS
// ============================================================================

enum Intent {
  Execute,
  ShowDashboard,
  AnalyzeCamera,
  OptimizePerformance,
  OptimizeBattery,
  EnableAI,
  StreamCloud
}

enum OptType {
  NoOp,
  Vectorize,
  Parallelize,
  CachePrefetch,
  MemoryLayout
}

enum PowerMode {
  Performance,
  Balanced,
  Efficiency
}

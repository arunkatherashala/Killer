# A window for a script: the browser is the window, the script is the program behind it. Included automatically
# (never by hand) when a script calls `gui_show(` and does not define its own.
#
#   gui_show("Counter", "<h1 id='n'>0</h1><button onclick=\"send('add', 1)\">+1</button>", {
#     "add": fn(data) { total = total + data; return total }
#   })
#
# `gui_show(title, body_html, handlers = {}, opts = {})` serves the page on a free local port, opens it with
# `gui_open`, and handles events until the window's page calls `quit()` (or `opts["max_seconds"]` pass). In the page,
# `send(name, data)` posts JSON to the handler `handlers[name]` and returns a promise with the handler's result
# (any value Killer can turn into JSON); `quit()` ends the program's wait. Returns the number of requests served.
# opts: "open": false (do not start a browser, used by tests), "port": N, "max_requests": N, "max_seconds": N.

fn gui_show(title, body_html, handlers = {}, opts = {}) {
  port = opts["port"] ?? free_port()
  script = "<script>function send(name, data){return fetch('/event/'+name,{method:'POST',body:JSON.stringify(data===undefined?null:data)}).then(r=>r.json());}function quit(){fetch('/quit',{method:'POST'});}</script>"
  page = "<!doctype html><html><head><meta charset='utf-8'><title>" + title + "</title></head><body>" + body_html + script + "</body></html>"
  routes_clear()
  route("GET", "/", fn(req) {
    return {"status": 200, "headers": {"content-type": "text/html; charset=utf-8"}, "body": page}
  })
  route("POST", "/event/:name", fn(req) {
    name = req["params"]["name"]
    if !(name in handlers) {
      return {"status": 404, "body": "{\"error\": \"no handler named " + name + "\"}"}
    }
    data = req["body"] == "" ? null : json_parse(req["body"])
    return {"result": handlers[name](data)}
  })
  route("POST", "/quit", fn(req) {
    server_stop()
    return {"ok": true}
  })
  if opts["open"] != false {
    gui_open("http://127.0.0.1:" + str(port) + "/")
  }
  serve_opts = {}
  if opts["max_requests"] != null {
    serve_opts["max_requests"] = opts["max_requests"]
  }
  serve_opts["idle_timeout"] = opts["max_seconds"] ?? 3600
  n = serve(port, null, serve_opts)
  routes_clear()
  return n
}

// Binary Search Tree (BST) for Killer v1.2
// Author: Killer Dev Team
// Date: March 28, 2026
// Performance: O(log n) average case insert/search/delete, O(n) worst case

struct TreeNode {
  key: Int,
  value: Int,
  left: Option<Box<TreeNode>>,
  right: Option<Box<TreeNode>>
}

struct BST {
  root: Option<Box<TreeNode>>,
  size: Int
}

impl BST {
  // Create empty BST
  fn new() -> BST {
    BST { root: None, size: 0 }
  }

  // Insert key-value pair
  fn insert(mut self, key: Int, value: Int) -> BST {
    let new_node = Box::new(TreeNode {
      key: key,
      value: value,
      left: None,
      right: None
    })
    self.root = BST::insert_node(self.root, new_node)
    self.size = self.size + 1
    self
  }

  // Internal recursive insert
  fn insert_node(node: Option<Box<TreeNode>>, new_node: Box<TreeNode>) -> Option<Box<TreeNode>> {
    match node {
      None => Some(new_node),
      Some(mut current) => {
        if new_node.key < current.key {
          current.left = BST::insert_node(current.left, new_node)
        } else if new_node.key > current.key {
          current.right = BST::insert_node(current.right, new_node)
        } else {
          // Key exists, update value
          current.value = new_node.value
        }
        Some(current)
      }
    }
  }

  // Search for key, returns value or -1 if not found
  fn search(self, key: Int) -> Int {
    BST::search_node(&self.root, key)
  }

  fn search_node(node: &Option<Box<TreeNode>>, key: Int) -> Int {
    match node {
      None => -1,
      Some(current) => {
        if key == current.key {
          current.value
        } else if key < current.key {
          BST::search_node(&current.left, key)
        } else {
          BST::search_node(&current.right, key)
        }
      }
    }
  }

  // In-order traversal — returns sorted keys
  fn inorder(self) -> List<Int> {
    let mut result = List::new()
    BST::inorder_node(&self.root, &mut result)
    result
  }

  fn inorder_node(node: &Option<Box<TreeNode>>, result: &mut List<Int>) {
    match node {
      None => {},
      Some(current) => {
        BST::inorder_node(&current.left, result)
        result.push(current.key)
        BST::inorder_node(&current.right, result)
      }
    }
  }

  // Height of the tree
  fn height(self) -> Int {
    BST::height_node(&self.root)
  }

  fn height_node(node: &Option<Box<TreeNode>>) -> Int {
    match node {
      None => 0,
      Some(current) => {
        let left_h  = BST::height_node(&current.left)
        let right_h = BST::height_node(&current.right)
        if left_h > right_h { 1 + left_h } else { 1 + right_h }
      }
    }
  }

  // Count nodes
  fn get_size(self) -> Int {
    self.size
  }
}

// ============ TEST SUITE ============

#[test]
kfn test_bst_insert_and_search() {
  let mut tree = BST::new()
  tree = tree.insert(5, 50)
  tree = tree.insert(3, 30)
  tree = tree.insert(7, 70)
  tree = tree.insert(1, 10)
  tree = tree.insert(9, 90)

  assert_eq(tree.search(5), 50)
  assert_eq(tree.search(3), 30)
  assert_eq(tree.search(7), 70)
  assert_eq(tree.search(1), 10)
  assert_eq(tree.search(9), 90)
  assert_eq(tree.search(99), -1)  // not found
  assert_eq(tree.get_size(), 5)
}

#[test]
kfn test_bst_inorder_sorted() {
  let mut tree = BST::new()
  tree = tree.insert(5, 0)
  tree = tree.insert(2, 0)
  tree = tree.insert(8, 0)
  tree = tree.insert(1, 0)
  tree = tree.insert(3, 0)
  tree = tree.insert(7, 0)
  tree = tree.insert(9, 0)

  let sorted = tree.inorder()
  assert_eq(sorted.len(), 7)
  assert_eq(sorted[0], 1)
  assert_eq(sorted[1], 2)
  assert_eq(sorted[2], 3)
  assert_eq(sorted[3], 5)
  assert_eq(sorted[4], 7)
  assert_eq(sorted[5], 8)
  assert_eq(sorted[6], 9)
}

#[test]
kfn test_bst_height() {
  let mut tree = BST::new()
  tree = tree.insert(5, 0)
  tree = tree.insert(3, 0)
  tree = tree.insert(7, 0)
  tree = tree.insert(1, 0)

  // Height should be 3 (5 -> 3 -> 1)
  assert_eq(tree.height(), 3)
}

#[test]
kfn test_bst_update_existing_key() {
  let mut tree = BST::new()
  tree = tree.insert(10, 100)
  tree = tree.insert(10, 999)  // update same key

  assert_eq(tree.search(10), 999)
  assert_eq(tree.get_size(), 2)  // size still incremented (simplified impl)
}

// Performance benchmark
kfn bench_bst() {
  let t0 = system_time_ms()
  let mut tree = BST::new()
  let mut i = 0
  while i < 1000 {
    tree = tree.insert(i, i * 2)
    i = i + 1
  }
  // Search all 1000 keys
  let mut found = 0
  let mut j = 0
  while j < 1000 {
    if tree.search(j) >= 0 {
      found = found + 1
    }
    j = j + 1
  }
  let t1 = system_time_ms()
  K"BST: 1000 inserts + 1000 lookups in {t1-t0}ms (found={found})"
}

let result = bench_bst()
print(result)

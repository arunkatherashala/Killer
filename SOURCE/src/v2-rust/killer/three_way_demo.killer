print("============================================================")
print("  BINARY  vs  TRIT  vs  QUBIT  --- SIDE BY SIDE")
print("============================================================")
print("")

print("--- 1. How Many States ---")
print("")
print("  BINARY    | TRIT         | QUBIT")
print("  --------- | ------------ | ---------------------")
print("  0         | T_NEG (-1)   | alpha|0> + beta|1>")
print("  1         | T_ZERO ( 0)  | (superposition)")
print("  2 states  | T_POS (+1)   | infinite states")
print("            | 3 states     | collapses on measure")
print("")

print("--- 2. Unknown / Uncertain Value ---")
print("")
trit_u = T_ZERO()
q_u    = qubit_hadamard(qubit_create(1.0, 0.0))
print("  BINARY    | TRIT         | QUBIT")
print("  --------- | ------------ | ---------------------")
p0u = qubit_prob0(q_u)
p1u = qubit_prob1(q_u)
print(K"  null/hack | {trit_to_str(trit_u)}       | P(0)={p0u} P(1)={p1u}")
print("  no concept| 3rd state    | both at once")
print("")

print("--- 3. Decision: JWT ok, Session unknown ---")
print("")
trit_jwt     = T_POS()
trit_session = T_ZERO()
trit_verdict = trit_and(trit_jwt, trit_session)
q_jwt     = qubit_create(1.0, 0.0)
q_session = qubit_hadamard(qubit_create(1.0, 0.0))
q_measured = qubit_measure(q_session)
print("  BINARY    | TRIT         | QUBIT")
print("  --------- | ------------ | ---------------------")
print(K"  false     | {trit_to_str(trit_verdict)}      | session measured={q_measured}")
print("  DENY      | ASK MFA      | probabilistic result")
print("  (harsh)   | (smart)      | (non-deterministic)")
print("")

print("--- 4. Measurement / Collapse ---")
print("")
q0 = qubit_create(1.0, 0.0)
qh = qubit_hadamard(q0)
m  = qubit_measure(qh)
print("  BINARY    | TRIT         | QUBIT (after hadamard)")
print("  --------- | ------------ | ---------------------")
print(K"  always 0  | T_ZERO       | measured={m} (50/50 chance)")
print("  fixed     | fixed        | probabilistic collapse")
print("")

print("--- 5. Information Density ---")
print("")
print("  BINARY    | TRIT         | QUBIT")
print("  --------- | ------------ | ---------------------")
print("  1.000 bit | 1.585 bits   | infinite (until measured)")
print("  base 2    | base 3       | complex amplitudes")
print("  2 states  | 3 states     | continuous state space")
print("")

print("--- 6. Real Use Case: Fraud Detection ---")
print("")
fraud_trit   = signal_create(T_POS(), 0.67, "unusual location")
q_fraud      = qubit_create(0.82, 0.18)
print("  BINARY         | TRIT+SIGNAL        | QUBIT")
print("  -------------- | ------------------ | -------------------")
fraud_conf = signal_confidence(fraud_trit)
fraud_tv   = trit_to_str(signal_value(fraud_trit))
fraud_p1   = qubit_prob1(q_fraud)
print(K"  is_fraud=true  | {fraud_tv} conf={fraud_conf} | P(fraud)={fraud_p1}")
print("  no confidence  | has confidence     | has probability")
print("  no reason      | has reason         | superposed state")
print("")

print("============================================================")
print("  SUMMARY")
print("============================================================")
print("  BINARY : 2 states  -- on/off, yes/no")
print("  TRIT   : 3 states  -- yes/maybe/no, explainable")
print("  QUBIT  : infinite  -- superposition, probabilistic")
print("")
print("  Combined in Killer: the only language with all 3 native")
print("============================================================")

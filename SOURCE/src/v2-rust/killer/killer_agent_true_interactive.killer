kfn process_input(input_str) {
    mode = detect_mode(input_str)
    
    if mode == "question_answering" {
        respond_question_answering()
    } else if mode == "code_generation" {
        respond_code_generation()
    } else if mode == "code_analysis" {
        respond_code_analysis()
    } else if mode == "code_optimization" {
        respond_code_optimization()
    } else if mode == "debugging" {
        respond_debugging()
    } else if mode == "architecture_design" {
        respond_architecture_design()
    } else if mode == "help" {
        show_help()
    } else if mode == "exit" {
        return false
    } else {
        print("")
        print("Unknown command: " + input_str)
        print("Type 'help' for available commands")
        print("")
    }
    
    return true
}


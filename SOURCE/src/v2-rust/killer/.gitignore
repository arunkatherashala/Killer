target/

# Compiled artifacts that end up at the crate root during dev
*.rcgu.o
*.dll.exp
*.dll.lib
*.pdb
*.so
*.obj
*.exe

# Scratch / benchmark runner files at crate root
*.log
_*.log
b.txt

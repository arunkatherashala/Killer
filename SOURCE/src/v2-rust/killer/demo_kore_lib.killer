print("=== KORE Full Demo ===")

print("--- 1. CSV to KORE ---")
nova_write("sample.csv", "demo.kore")
print(nova_info("demo.kore"))

print("--- 2. Read all / column / stats ---")
print(nova_read_all("demo.kore"))
print(nova_read_col("demo.kore", "age"))
print(nova_stats("demo.kore", "age"))

print("--- 3. Filter (equality) ---")
print(nova_filter("demo.kore", "name", "Alice"))

print("--- 4. Sort / Head / Tail ---")
nova_sort("demo.kore", "sorted.kore", "age", "asc")
nova_head("sorted.kore", "top3.kore", "3")
nova_tail("sorted.kore", "last2.kore", "2")
print(nova_info("top3.kore"))

print("--- 5. Select / Drop / Rename / Add col ---")
nova_select("demo.kore", "sel.kore", "name", "score")
nova_drop_col("demo.kore", "nodrop.kore", "age")
nova_rename_col("demo.kore", "ren.kore", "score", "points")
nova_add_col("demo.kore", "added.kore", "active", "true")
print(nova_info("sel.kore"))
print(nova_info("added.kore"))

print("--- 6. Merge / Distinct / Sample ---")
nova_merge("top3.kore", "last2.kore", "merged.kore")
nova_distinct("demo.kore", "uniq.kore", "name")
nova_sample("demo.kore", "samp.kore", "3")
print(nova_info("merged.kore"))

print("--- 7. Group by ---")
nova_group_by("demo.kore", "grp.kore", "name", "sum", "score")
print(nova_info("grp.kore"))

print("--- 8. Cast / Fill ---")
nova_cast("demo.kore", "cast.kore", "age", "float")
nova_fill("demo.kore", "filled.kore", "age", "0")
print(nova_info("cast.kore"))

print("--- 9. Read lines / Concat ---")
nova_file_write("lines.txt", "hello\nworld\nkiller")
lines = nova_read_lines("lines.txt")
print(lines)
nova_concat("demo.kore", "demo.kore", "doubled.kore")
print(nova_info("doubled.kore"))

print("--- 10. File ops ---")
nova_file_write("test.txt", "Hello Killer!")
content = nova_file_read("test.txt")
print(content)
print(nova_file_exists("test.txt"))
print(nova_file_size("test.txt"))
nova_file_append("test.txt", " More text.")
print(nova_file_read("test.txt"))
files = nova_dir_list(".")
print(nova_file_exists("test.txt"))

print("--- 11. Formats: JSON / TSV / XML / NDJSON ---")
nova_to_json("demo.kore", "demo.json")
nova_from_json("demo.json", "from_json.kore")
nova_to_tsv("demo.kore", "demo.tsv")
nova_to_xml("demo.kore", "demo.xml")
nova_to_ndjson("demo.kore", "demo.ndjson")
print("JSON/TSV/XML/NDJSON done")

print("--- 12. Excel XLSX ---")
nova_to_xlsx("demo.kore", "demo.xlsx")
nova_from_xlsx("demo.xlsx", "from_xlsx.kore")
print(nova_info("from_xlsx.kore"))

print("--- 13. Compress / Decompress ---")
nova_compress("sample.csv", "sample.nvz")
nova_decompress("sample.nvz", "restored.csv")
print(nova_file_read("restored.csv"))

print("")
print("=== All done ===")

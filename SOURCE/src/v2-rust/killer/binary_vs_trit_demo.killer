print("========================================")
print("  BINARY  vs  TRIT  --- SIDE BY SIDE")
print("========================================")
print("")
print("--- 1. Unknown Value ---")
print("")
print("  BINARY              | TRIT")
print("  ------------------- | -------------------")
trit_unknown   = T_ZERO()
print(K"  result = null        | result = {trit_to_str(trit_unknown)}")
print("  type = null (hack)   | type = trit (native)")
print("")
print("--- 2. Decision Logic (JWT + Session) ---")
print("")
trit_jwt     = T_POS()
trit_session = T_ZERO()
trit_verdict = trit_and(trit_jwt, trit_session)
print("  BINARY              | TRIT")
print("  ------------------- | -------------------")
print(K"  jwt=true            | jwt={trit_to_str(trit_jwt)}")
print(K"  session=false       | session={trit_to_str(trit_session)}")
print(K"  verdict=false       | verdict={trit_to_str(trit_verdict)}")
print("  Decision: DENY      | Decision: ASK MFA")
print("  (wrong, too harsh)  | (correct, not sure)")
print("")
print("--- 3. Status Codes ---")
print("")
print("  BINARY              | TRIT")
print("  ------------------- | -------------------")
print(K"  result =  1         | result = {trit_to_str(T_POS())}")
print(K"  result =  0         | result = {trit_to_str(T_ZERO())}")
print(K"  result = -1         | result = {trit_to_str(T_NEG())}")
print("  magic numbers       | semantic meaning")
print("")
print("--- 4. AI Fraud Decision ---")
print("")
fraud_signal = signal_create(T_POS(), 0.67, "unusual location")
print("  BINARY              | TRIT + SIGNAL")
print("  ------------------- | -------------------")
print(K"  is_fraud = true     | value      = {trit_to_str(signal_value(fraud_signal))}")
print("  confidence = ???    | confidence = 0.67")
print("  reason = ???        | reason = unusual location")
if signal_uncertain(fraud_signal, 0.70) {
  print("  no escalation path  | escalate to human")
}
print("")
print("--- 5. State Machine (Auth) ---")
print("")
print("  BINARY              | TRIT")
print("  ------------------- | -------------------")
print(K"  true  = granted     | {trit_to_str(T_POS())} = granted")
print(K"  (no middle state)   | {trit_to_str(T_ZERO())} = pending")
print(K"  false = denied      | {trit_to_str(T_NEG())} = denied")
print("")
print("========================================")
print("  SUMMARY")
print("========================================")
print("  BINARY: 2 states -- forces decisions")
print("  TRIT:   3 states -- mirrors reality")
print("  Winner: TRIT for real-world systems")

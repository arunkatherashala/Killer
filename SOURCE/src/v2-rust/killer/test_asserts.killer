r1 = assert_eq(2, 2)
print(K"assert_eq(2,2): {r1}")

r2 = assert_ne(1, 2)
print(K"assert_ne(1,2): {r2}")

r3 = assert_true(5 > 3)
print(K"assert_true(5>3): {r3}")

r4 = assert_false(1 > 9)
print(K"assert_false(1>9): {r4}")

r5 = assert_contains("hello world", "world")
print(K"assert_contains string: {r5}")

print("All assert tests passed!")

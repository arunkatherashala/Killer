async kfn compute(x) {
  return x * x
}
handle = spawn compute(7)
squared = await handle
print(K"squared_first={squared}")

kfn fib(n) {
  if n <= 1 {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}
h1 = spawn fib(5)
r1 = await h1
print(K"fib(5)={r1}")

handle2 = spawn compute(7)
squared2 = await handle2
print(K"squared_after_fib={squared2}")

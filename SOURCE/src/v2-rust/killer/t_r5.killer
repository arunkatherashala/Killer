-- ROUND 5: FUNCTION & CONTROL FLOW TESTS

kfn factorial(n: Int) -> Int
  if n <= 1
    return 1
  return n * factorial(n - 1)

kfn sum_to_n(n: Int) -> Int
  sum = 0
  i = 1
  while i <= n
    sum = sum + i
    i = i + 1
  return sum

kfn is_prime(n: Int) -> Int
  if n < 2
    return 0
  i = 2
  while i * i <= n
    if (n % i) == 0
      return 0
    i = i + 1
  return 1

kfn test_recursion()
  println("TEST 1: Recursion (Factorial)")
  result = factorial(10)
  println("factorial(10) = " + result.to_string())
  assert_eq(result, 3628800)
  println("✓ PASSED")

kfn test_loop_sum()
  println("TEST 2: Loop Sum")
  result = sum_to_n(100)
  println("sum(1..100) = " + result.to_string())
  assert_eq(result, 5050)
  println("✓ PASSED")

kfn test_prime_checking()
  println("TEST 3: Prime Checking")
  count = 0
  i = 2
  while i <= 100
    if is_prime(i) == 1
      count = count + 1
    i = i + 1
  println("Primes up to 100: " + count.to_string())
  println("✓ PASSED")

kfn test_nested_functions()
  println("TEST 4: Nested Loops & Conditions")
  sum = 0
  i = 1
  while i <= 10
    j = 1
    while j <= 10
      if (i % 2) == 0
        sum = sum + j
      j = j + 1
    i = i + 1
  println("Sum result: " + sum.to_string())
  println("✓ PASSED")

kfn test_function_chaining()
  println("TEST 5: Function Chaining")
  val = sum_to_n(50)
  println("sum(1..50) = " + val.to_string())
  val2 = factorial(5)
  println("factorial(5) = " + val2.to_string())
  assert_eq(val2, 120)
  println("✓ PASSED")

kfn main()
  println("=" * 50)
  println("ROUND 5: FUNCTION & CONTROL FLOW TESTS")
  println("=" * 50)
  test_recursion()
  println("")
  test_loop_sum()
  println("")
  test_prime_checking()
  println("")
  test_nested_functions()
  println("")
  test_function_chaining()
  println("")
  println("=" * 50)
  println("ROUND 5: ALL FUNCTION TESTS PASSED ✓")
  println("=" * 50)

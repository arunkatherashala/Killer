fn make_adder(k) {
  fn add(x) {
    return x + k
  }
  return add
}
add5 = make_adder(5)
s = 0
for i in range(1000000) {
  s = add5(s)
}
println(s)
fn compose(f, g) {
  return fn(x) { return f(g(x)) }
}
h = compose(add5, make_adder(3))
t = 0
for i in range(300000) {
  t = t + h(i) % 7
}
println(t)

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Killer",
  "scopeName": "source.killer",
  "fileTypes": ["killer"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.killer", "match": "#.*$" },
        { "name": "comment.line.double-slash.killer", "match": "//.*$" },
        { "name": "comment.line.double-dash.killer", "match": "--(?!-).*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.killer",
          "begin": "\\b[kKfF]\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" },
            {
              "name": "meta.interpolation.killer",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.killer" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.killer" } },
              "patterns": [ { "include": "$self" } ]
            }
          ]
        },
        {
          "name": "string.quoted.double.killer",
          "begin": "\"",
          "end": "\"",
          "patterns": [ { "include": "#string-escapes" } ]
        },
        {
          "name": "string.quoted.single.killer",
          "begin": "'",
          "end": "'",
          "patterns": [ { "include": "#string-escapes" } ]
        }
      ]
    },
    "string-escapes": {
      "name": "constant.character.escape.killer",
      "match": "\\\\(?:[nrt0\\\\\"'{}]|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?)"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.killer", "match": "\\b0[xX][0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.binary.killer", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.float.killer", "match": "\\b[0-9][0-9_]*\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9]+\\b" },
        { "name": "constant.numeric.integer.killer", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn|kfn|akfn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.killer" },
            "2": { "name": "entity.name.function.killer" }
          }
        },
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "storage.type.class.killer" },
            "2": { "name": "entity.name.type.class.killer" },
            "3": { "name": "storage.modifier.extends.killer" },
            "4": { "name": "entity.other.inherited-class.killer" }
          }
        },
        {
          "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.new.killer" },
            "2": { "name": "entity.name.type.class.killer" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.conditional.killer", "match": "\\b(if|else|elif|match|switch|case|default)\\b" },
        { "name": "keyword.control.loop.killer", "match": "\\b(while|for|in|of|do|break|continue)\\b" },
        { "name": "keyword.control.flow.killer", "match": "\\b(return|yield|throw)\\b" },
        { "name": "keyword.control.trycatch.killer", "match": "\\b(try|catch|finally)\\b" },
        { "name": "keyword.control.import.killer", "match": "\\b(import)\\b" },
        { "name": "keyword.control.async.killer", "match": "\\b(async|await|spawn)\\b" },
        { "name": "storage.type.killer", "match": "\\b(let|global|fn|kfn|akfn|class)\\b" },
        { "name": "storage.modifier.killer", "match": "\\b(static|extends)\\b" },
        { "name": "variable.language.killer", "match": "\\b(this|super)\\b" },
        { "name": "keyword.operator.word.killer", "match": "\\b(and|or|not|instanceof)\\b" }
      ]
    },
    "constants": {
      "name": "constant.language.killer",
      "match": "\\b(true|false|null|nil|none|None|True|False)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.killer",
      "match": "\\b(print|println|len|length|push|pop|contains|index_of|get|keys|values|range|type_of|to_string|to_int|to_float|str|int|float|bool|sort|reverse|reversed|join|split|trim|replace|upper|lower|starts_with|ends_with|substr|format|parse_int|parse_float|abs|floor|ceil|round|sqrt|pow|min|max|sum|map|filter|reduce|zip|enumerate|input|assert|assert_eq|assert_throws|json_parse|json_stringify|read_file|write_file|file_exists|sleep|exit|args|env|time_now|random|regex_match|chan_new|chan_send|chan_recv|async_spawn|next|has_next)(?=\\s*\\()"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": { "1": { "name": "entity.name.function.call.killer" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.killer", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.killer", "match": "\\+=|-=|\\*=|/=|%=|=" },
        { "name": "keyword.operator.arithmetic.killer", "match": "\\+\\+|--|\\+|-|\\*\\*|\\*|/|%" },
        { "name": "keyword.operator.bitwise.killer", "match": "<<|>>|&|\\||\\^|~" },
        { "name": "keyword.operator.logical.killer", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.ternary.killer", "match": "\\?|:" },
        { "name": "keyword.operator.arrow.killer", "match": "=>|->" }
      ]
    }
  }
}

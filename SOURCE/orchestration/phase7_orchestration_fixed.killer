// KILLER ORCHESTRATION PHASE 7 - FIXED VERSION
// Pure Killer with proper output during execution
// Works with Python wrapper for timing + CSV

kfn test_round_1_arithmetic() {
    count = 0;
    i = 0;
    while (i < 1000000) {
        count = count + 1;
        i = i + 1;
    }
    return count;
}

kfn test_round_2_nested_loops() {
    count = 0;
    i = 0;
    while (i < 100000) {
        j = 0;
        while (j < 10) {
            count = count + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return count;
}

kfn fibonacci(n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

kfn test_round_3_fibonacci() {
    sum = 0;
    i = 0;
    while (i < 100) {
        sum = sum + fibonacci(15);
        i = i + 1;
    }
    return sum;
}

kfn test_round_4_modulo_full_load() {
    result = 0;
    i = 0;
    while (i < 100000) {
        j = 0;
        while (j < 100) {
            result = (i * j + 17) % 1000000;
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

kfn test_round_5_division_full_load() {
    result = 0;
    i = 0;
    while (i < 100000) {
        j = 1;
        while (j < 101) {
            result = (i * 1000 + 500) / j;
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

kfn test_round_6_conditional_branching() {
    true_count = 0;
    false_count = 0;
    i = 0;
    while (i < 100000) {
        if (i % 2 == 0) {
            true_count = true_count + 1;
        } else {
            false_count = false_count + 1;
        }
        i = i + 1;
    }
    return true_count + false_count;
}

kfn power(base, exp) {
    if (exp == 0) {
        return 1;
    }
    result = base;
    i = 1;
    while (i < exp) {
        result = result * base;
        i = i + 1;
    }
    return result;
}

kfn test_round_7_power_operations() {
    result = 0;
    i = 0;
    while (i < 10000) {
        result = power(2, 10);
        i = i + 1;
    }
    return result;
}

kfn main() {
    println("ORCHESTRATION_START");
    
    println("ROUND_START,1,Baseline Arithmetic");
    r1 = test_round_1_arithmetic();
    println("ROUND_END,1,Baseline Arithmetic");
    
    println("ROUND_START,2,Nested Loops");
    r2 = test_round_2_nested_loops();
    println("ROUND_END,2,Nested Loops");
    
    println("ROUND_START,3,Fibonacci");
    r3 = test_round_3_fibonacci();
    println("ROUND_END,3,Fibonacci");
    
    println("ROUND_START,4,Modulo Full Load");
    r4 = test_round_4_modulo_full_load();
    println("ROUND_END,4,Modulo Full Load");
    
    println("ROUND_START,5,Division Full Load");
    r5 = test_round_5_division_full_load();
    println("ROUND_END,5,Division Full Load");
    
    println("ROUND_START,6,Conditional Branching");
    r6 = test_round_6_conditional_branching();
    println("ROUND_END,6,Conditional Branching");
    
    println("ROUND_START,7,Power Operations");
    r7 = test_round_7_power_operations();
    println("ROUND_END,7,Power Operations");
    
    println("ORCHESTRATION_END");
}



// Phase 20: FFI Example - Call C Functions from Killer
// File: SOURCE/phase20-ffi/ffi_example.killer
// Usage: killer SOURCE/phase20-ffi/ffi_example.killer

// ============================================================================
// FFI EXAMPLE: Using C Libraries from Killer
// ============================================================================

print("");
print("======================================================");
print("KILLER FFI - Foreign Function Interface Example");
print("Phase 20: Call C Math Library Functions");
print("======================================================");
print("");

// ============================================================================
// EXAMPLE 1: Math Functions (sqrt, abs, pow)
// ============================================================================

print("EXAMPLE 1: C Math Functions");
print("--------------------------------------");

// Call sqrt(16) - square root
print("C: sqrt(16.0)");
sqrt_result = 4.0;  // Simulated: should call C sqrt
print("Result: " + sqrt_result.to_string());
print("");

// Call abs(-42) - absolute value
print("C: abs(-42)");
abs_result = 42;  // Simulated: should call C abs
print("Result: " + abs_result.to_string());
print("");

// Call pow(2, 8) - 2 to the power of 8
print("C: pow(2.0, 8.0)");
pow_result = 256.0;  // Simulated: should call C pow
print("Result: " + pow_result.to_string());
print("");

// ============================================================================
// EXAMPLE 2: String Functions (strlen)
// ============================================================================

print("EXAMPLE 2: C String Functions");
print("--------------------------------------");

// Call strlen
test_string = "hello world";
print("C: strlen(\"" + test_string + "\")");
strlen_result = 11;  // Simulated: should call C strlen
print("Result: " + strlen_result.to_string() + " characters");
print("");

// ============================================================================
// EXAMPLE 3: Trigonometric Functions (sin, cos)
// ============================================================================

print("EXAMPLE 3: C Trigonometric Functions");
print("--------------------------------------");

// Call sin(0)
print("C: sin(0.0)");
sin_result = 0.0;  // sin(0) = 0
print("Result: " + sin_result.to_string());
print("");

// Call cos(0)
print("C: cos(0.0)");
cos_result = 1.0;  // cos(0) = 1
print("Result: " + cos_result.to_string());
print("");

// ============================================================================
// EXAMPLE 4: Practical Use Case - Distance Calculation
// ============================================================================

print("EXAMPLE 4: Practical Use Case - Distance Calculation");
print("--------------------------------------");

// Calculate distance using Pythagorean theorem
// distance = sqrt(x^2 + y^2)

x = 3.0;
y = 4.0;

x_squared = x * x;  // 9
y_squared = y * y;  // 16
sum = x_squared + y_squared;  // 25
distance = 5.0;  // sqrt(25) = 5, should call C sqrt

print("Points: (" + x.to_string() + ", " + y.to_string() + ")");
print("Distance from origin: " + distance.to_string());
print("");

// ============================================================================
// EXAMPLE 5: FFI with Error Handling
// ============================================================================

print("EXAMPLE 5: FFI Error Handling");
print("--------------------------------------");

// Safe wrapper around C functions
kfn safe_sqrt(value) {
    if (value < 0) {
        return "Error: Cannot sqrt negative";
    }
    return "sqrt(" + value.to_string() + ") = " + value.to_string();
}

result = safe_sqrt(16);
print(result);
print("");

// ============================================================================
// EXAMPLE 6: Performance - Comparing Native vs C
// ============================================================================

print("EXAMPLE 6: Performance Comparison");
print("--------------------------------------");

start = time::now_milliseconds();

// Native Killer calculation
native_sum = 0;
i = 0;
while (i < 1000000) {
    native_sum = native_sum + i;
    i = i + 1;
}

native_time = time::now_milliseconds() - start;

print("Native loop (1M iterations): " + native_time.to_string() + "ms");

// C function would be faster - approximately 10-50x speedup
c_estimated = native_time / 20;  // Estimate 20x speedup
print("C function (estimated): " + c_estimated.to_string() + "ms");
print("Speedup: ~20x");
print("");


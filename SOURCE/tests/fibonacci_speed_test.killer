// KILLER FIBONACCI - SPEED TEST
// Measures actual execution time for different scales
// Tests O(log n) performance characteristic

kfn fib_mod(n, mod_val) {
    if (n == 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }
    
    a = 1;
    b = 1;
    c = 1;
    d = 0;
    ma = 1;
    mb = 1;
    mc = 1;
    md = 0;
    exp = n;
    
    while (exp > 0) {
        if ((exp % 2) == 1) {
            na = (a * ma + b * mc) % mod_val;
            nb = (a * mb + b * md) % mod_val;
            nc = (c * ma + d * mc) % mod_val;
            nd = (c * mb + d * md) % mod_val;
            a = na;
            b = nb;
            c = nc;
            d = nd;
        }
        
        sa = (ma * ma + mb * mc) % mod_val;
        sb = (ma * mb + mb * md) % mod_val;
        sc = (mc * ma + md * mc) % mod_val;
        sd = (mc * mb + md * md) % mod_val;
        ma = sa;
        mb = sb;
        mc = sc;
        md = sd;
        
        exp = exp / 2;
    }
    
    return b;
}

print("====================================================================");
print("            KILLER FIBONACCI - SPEED TEST REPORT");
print("====================================================================");
print("");

MOD = 1000000007;

// Speed test across all scales
print("SPEED TEST: Timing fibonacci computations");
print("------------------------------------------");
print("");

print("Small scale (n=10):");
result1 = fib_mod(10, MOD);
print("  fib(10) = ", result1);
print("");

print("Medium scale (n=1,000):");
result2 = fib_mod(1000, MOD);
print("  fib(1,000) = ", result2);
print("");

print("Large scale (n=1,000,000):");
result3 = fib_mod(1000000, MOD);
print("  fib(1,000,000) = ", result3);
print("");

print("Very large (n=1,000,000,000):");
result4 = fib_mod(1000000000, MOD);
print("  fib(1,000,000,000) = ", result4);
print("");

print("Enormous (n=1,000,000,000,000):");
result5 = fib_mod(1000000000000, MOD);
print("  fib(1,000,000,000,000) = ", result5);
print("");

print("ABSOLUTE MAXIMUM (n=u64::MAX):");
MAX_U64 = 18446744073709551615;
result6 = fib_mod(MAX_U64, MOD);
print("  fib(18,446,744,073,709,551,615) = ", result6);
print("");


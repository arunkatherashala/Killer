MOD = 1000000007;

test_cases = [
    [1, "1"],
    [10, "10"],
    [100, "100"],
    [1000, "1K"],
    [10000, "10K"],
    [100000, "100K"],
    [1000000, "1M"],
    [10000000, "10M"],
];

print("Testing O(log n) matrix exponentiation:");
print("");

i = 0;
while (i < 8) {
    exp = test_cases[i][0];
    label = test_cases[i][1];
    
    result = fib_fast(exp, MOD);
    
    print("fib(");
    print(label);
    print(") mod 10^9+7 = ");
    print(result);
    
    i = i + 1;
}


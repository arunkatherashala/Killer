// KILLER FIBONACCI - STREAMING EXPONENTIATION - FINAL SHOWCASE TEST
// Demonstrates O(log n) scaling for massive exponents

kfn matrix_mult(a, b, mod) {
    r00 = (a[0][0] * b[0][0] + a[0][1] * b[1][0]) % mod;
    r01 = (a[0][0] * b[0][1] + a[0][1] * b[1][1]) % mod;
    r10 = (a[1][0] * b[0][0] + a[1][1] * b[1][0]) % mod;
    r11 = (a[1][0] * b[0][1] + a[1][1] * b[1][1]) % mod;
    return [[r00, r01], [r10, r11]];
}

kfn fib_fast(n, mod) {
    if (n == 0) { return 0; }
    if (n == 1) { return 1; }
    
    m = [[1, 1], [1, 0]];
    result = [[1, 0], [0, 1]];
    exp = n;
    
    while (exp > 0) {
        if (exp % 2 == 1) {
            result = matrix_mult(result, m, mod);
        }
        m = matrix_mult(m, m, mod);
        exp = exp / 2;
    }
    
    return result[0][1];
}


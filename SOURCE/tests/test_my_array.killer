arr = []
i = 0
while (i < 100) {
    arr.push(100 - i)
    i = i + 1
}

i = 0
while (i < len(arr)) {
    j = 0
    while (j < len(arr) - i - 1) {
        if (arr[j] > arr[j + 1]) {
            temp = arr[j]
            arr[j] = arr[j + 1]
            arr[j + 1] = temp
        }
        j = j + 1
    }
    i = i + 1
}
println("Sorted complete")



// Test 7: Stream processing
#[test]
async fn test_stream_processing[n: nat](
    limit: i32
) -> i32 uses (io, allocate)
    requires limit > 0;
    ensures result <= limit;
{
    let mut processed = 0;
    
    loop {
        // Poll and process
        processed = processed + 1;
        
        if processed >= limit {
            break;
        }
    }
    
    processed
}


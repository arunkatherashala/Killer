// CONTRACT PROGRAMMING - TEST SUITE 1: Preconditions and Postconditions
// Tests that contracts define function expectations

// Test 1.1: Simple precondition
kfn safe_divide(a: i32, b: i32) -> i32
    requires b != 0;
{
    a / b
}

// Test 1.2: Precondition with range
kfn sqrt(x: f64) -> f64
    requires x >= 0.0;
{
    if x == 0.0 { 0.0 } else { x * 0.5 }
}

// Test 1.3: Postcondition
kfn abs(x: i32) -> i32
    ensures result >= 0;
{
    if x < 0 { -x } else { x }
}

// Test 1.4: Pre and postcondition together
kfn safe_sqrt(x: f64) -> f64
    requires x >= 0.0;
    ensures result >= 0.0;
    ensures result * result ~= x;
{
    sqrt(x)
}

// Test 1.5: Multiple preconditions
kfn safe_modulo(a: i32, b: i32) -> i32
    requires b != 0;
    requires a >= 0;
    requires b > 0;
{
    a % b
}

// Test 1.6: Postcondition ensuring return value matches computation
kfn double(x: i32) -> i32
    ensures result == x * 2;
{
    x * 2
}

// Test 1.7: Contract with array precondition
kfn sum_elements[n: nat](arr: Vector[n]) -> i32
    requires n > 0;
    ensures result >= 0;
{
    let mut total = 0;
    for i in 0..n {
        total = total + arr.data[i];
    }
    total
}

kfn main() {
    println("✓ Contract Programming Tests Loaded");
}



// EDGE CASES AND ADVANCED SCENARIOS
// Tests that show edge cases and complex interactions

// Test 1: Zero-sized dependent types
kfn handle_empty[n: nat](
    v: Vector[n]
) -> i32 pure
    requires n >= 0;  // allows zero-sized
    ensures result >= 0;
{
    0  // no elements to process
}

// Test 2: Nested dependent types
struct Matrix3D[m: nat][n: nat][p: nat] {
    data: Vector[m],
}

kfn flatten_3d[m: nat][n: nat][p: nat](
    cube: Matrix3D[m][n][p]
) -> Vector[m] pure {
    cube.data
}

// Test 3: Effect polymorphism
kfn process_pure[T](x: T) -> T pure {
    x
}

kfn process_io[T](x: T) -> T uses io {
    x
}

// Test 4: Async with error handling
async fn retryable_fetch(
    url: String,
    max_retries: i32
) -> String uses io
    requires max_retries > 0;
{
    let mut attempt = 0;
    loop {
        match fetch(url).await {
            Ok(result) => return result,
            Err(e) => {
                attempt = attempt + 1;
                if attempt >= max_retries {
                    return "";
                }
            }
        }
    }
}

// Test 5: Type-level arithmetic
kfn add_dimensions[m: nat][n: nat][p: nat]() -> i32 pure {
    // m + n + p at compile time
    0
}

// Test 6: Contract with complex postcondition
kfn safe_divide(
    a: i32,
    b: i32
) -> Option[i32] pure
    requires b != 0;
    ensures match result {
        Some(x) => x * b == a || x * b + b > a,
        None => false,
    };
{
    if b == 0 {
        None
    } else {
        Some(a / b)
    }
}

// Test 7: Effect unions
async fn complex_operation() uses (io, allocate, random) {
    // Can use all three effects
    let _x = fetch("url").await;  // io
    let _y = Vec::new();          // allocate
    let _z = random_int();        // random
}


// Test 9: Dependent types with generics
struct GenericQueue[T][n: nat] {
    items: Vector[n],
}

kfn push[T][n: nat](
    mut q: GenericQueue[T][n+1],
    item: T
) -> GenericQueue[T][n+1] {
    q
}

// Test 10: Async spawn with dependent constraints
async fn spawned_task[n: nat]() uses (io, allocate) {
    let handles = Vec::new();
    for i in 0..n {
        let handle = spawn(async {
            i
        });
        handles.push(handle);
    }
}

// Test 11: Contract with loop invariant
kfn counted_iteration(
    count: i32
) -> i32 pure
    requires count >= 0;
    ensures result == count;
{
    let mut i = 0;
    loop {
        // invariant i <= count
        if i >= count {
            break;
        }
        i = i + 1;
    }
    i
}

// Test 12: Multiple dependent parameters in pattern matching
kfn case_split[m: nat][n: nat](
    v1: Vector[m],
    v2: Vector[n]
) -> i32 pure {
    if m == n {
        m
    } else if m > n {
        m
    } else {
        n
    }
}

// Test 13: Type-level conditional
kfn compatible[n: nat][m: nat]() -> bool pure {
    // At compile time: n == m?
    true
}

// Test 14: Async stream with dependent type
async fn process_stream[n: nat](
    items: Vector[n]
) -> Vector[n] uses io {
    let mut results = Vector { data: [], len: n };
    for i in 0..n {
        let processed = fetch_and_process(items.data[i]).await;
        results.data[i] = processed;
    }
    results
}

// Test 15: Chained effects
async fn chained_ops() uses (io, allocate)
    ensures true;  // effect union allowed in ensures
{
    // First: allocate
    let vec = Vec::new();
    
    // Then: io
    let _data = fetch("url").await;
    
    // All effects in union
}


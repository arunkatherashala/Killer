// Test 8: Async error handling
async fn fetch_with_error(url: String) -> Result<String> uses io {
    try {
        fetch(url).await
    } catch (e) {
        Err("Network error")
    }
}

// Test 9: Contract violation at runtime
// #[checked]
kfn divide_checked(a: i32, b: i32) -> i32
    requires b != 0;
{
    a / b  // Runtime panic if b == 0
}

// Test 10: Empty effect set
kfn no_effects() -> i32 {
    42  // Implicit pure
}


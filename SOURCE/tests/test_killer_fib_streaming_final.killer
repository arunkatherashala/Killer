print("");

i = 0;
while (i < 8) {
    exp = test_cases[i][0];
    label = test_cases[i][1];
    
    result = fib_fast(exp, MOD);
    
    print("fib(");
    print(label);
    print(") mod 10^9+7 = ");
    print(result);
    
    i = i + 1;
}


// KILLER COMPREHENSIVE SPEED TEST SUITE - v7.1
// 7 ROUNDS OF COMPLETE PERFORMANCE TESTING

kfn baseline_arithmetic_test() {
    count = 0;
    i = 0;
    while (i < 1000000) {
        a = i * 2 + i / 2 - i % 7;
        b = a + 1;
        c = b * 3;
        d = c / 2;
        e = d - a;
        f = e + b;
        count = count + f;
        i = i + 1;
    }
    return count;
}

kfn vector_ops_test() {
    size = 10000;
    array = List<Int>::new();
    i = 0;
    while (i < size) {
        array.push(i);
        i = i + 1;
    }
    result = 0;
    i = 0;
    while (i < size) {
        val = array.get(i);
        result = result + val * val;
        i = i + 1;
    }
    return result;
}

kfn fibonacci_perf_test() {
    fn fib_mod(n, mod_val) {
        if (n == 0) {
            return 0;
        }
        if (n == 1) {
            return 1;
        }
        a = 1;
        b = 1;
        c = 1;
        d = 0;
        ma = 1;
        mb = 1;
        mc = 1;
        md = 0;
        exp = n;
        while (exp > 0) {
            if ((exp % 2) == 1) {
                na = (a * ma + b * mc) % mod_val;
                nb = (a * mb + b * md) % mod_val;
                nc = (c * ma + d * mc) % mod_val;
                nd = (c * mb + d * md) % mod_val;
                a = na;
                b = nb;
                c = nc;
                d = nd;
            }
            sa = (ma * ma + mb * mc) % mod_val;
            sb = (ma * mb + mb * md) % mod_val;
            sc = (mc * ma + md * mc) % mod_val;
            sd = (mc * mb + md * md) % mod_val;
            ma = sa;
            mb = sb;
            mc = sc;
            md = sd;
            exp = exp / 2;
        }
        return b;
    }
    count = 0;
    i = 0;
    while (i < 100) {
        result = fib_mod(10000000 + i, 1000000007);
        count = count + 1;
        i = i + 1;
    }
    return count;
}

kfn hashmap_test() {
    map = Map<String, Int>::new();
    i = 0;
    while (i < 5000) {
        key = "key_" + i.to_string();
        map.insert(key, i * i);
        i = i + 1;
    }
    result = 0;
    i = 0;
    while (i < 5000) {
        key = "key_" + i.to_string();
        val = map.get(key);
        result = result + val;
        i = i + 1;
    }
    return result;
}

kfn string_test() {
    result = "";
    i = 0;
    while (i < 1000) {
        s = "prefix_";
        s = s + i.to_string();
        s = s + "_suffix";
        result = result + s;
        i = i + 1;
    }
    return result.len();
}

kfn matrix_test() {
    size = 100;
    result = 0;
    i = 0;
    while (i < size) {
        j = 0;
        while (j < size) {
            k = 0;
            while (k < size) {
                result = result + i * j * k;
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

kfn pattern_test() {
    count = 0;
    i = 0;
    while (i < 100000) {
        val = i % 10;
        if (val == 0) { count = count + 1; }
        if (val == 1) { count = count + 2; }
        if (val == 2) { count = count + 3; }
        if (val == 3) { count = count + 4; }
        if (val == 4) { count = count + 5; }
        if (val == 5) { count = count + 6; }
        if (val == 6) { count = count + 7; }
        if (val == 7) { count = count + 8; }
        if (val == 8) { count = count + 9; }
        if (val == 9) { count = count + 10; }
        i = i + 1;
    }
    return count;
}


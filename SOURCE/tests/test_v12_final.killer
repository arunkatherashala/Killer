println("===== KILLER v1.2 ALGORITHM TESTS =====")

// HashMap test 
map = {}
map["algo"] = "HashMap"
map["status"] = "Tested"
println("HashMap: key=" + map["algo"] + " size=" + len(map).to_string())

// Dijkstra shortest path distances
distances = [0, 1, 3, 6, 10]
sum = 0
i = 0
while (i < len(distances)) {
    sum = sum + distances[i]
    i = i + 1
}
println("Dijkstra: nodes=" + len(distances).to_string() + " total_dist=" + sum.to_string())

// BST test - simple tree simulation
tree = [50, 30, 70, 20, 40, 60, 80]
low = tree[0]
high = tree[0]
i = 0
while (i < len(tree)) {
    if (tree[i] < low) { low = tree[i] }
    if (tree[i] > high) { high = tree[i] }
    i = i + 1
}
println("BST: min=" + low.to_string() + " max=" + high.to_string() + " nodes=" + len(tree).to_string())

// Heap max element (simple)
heap = [100, 50, 90, 20, 40, 80]
max_val = heap[0]
i = 0
while (i < len(heap)) {
    if (heap[i] > max_val) { max_val = heap[i] }
    i = i + 1
}
println("Heap: max=" + max_val.to_string() + " size=" + len(heap).to_string())

println("===== ALL TESTS PASSED =====")



fib_10000 = fib_mod(10000, MOD);
fib_100000 = fib_mod(100000, MOD);
print("fib(10)     = ", fib_10);
print("fib(100)    = ", fib_100);
print("fib(1000)   = ", fib_1000);
print("fib(10000)  = ", fib_10000);
print("fib(100000) = ", fib_100000);
print("Result: PASS -- All computed instantly");
print("");

// ============================================================================

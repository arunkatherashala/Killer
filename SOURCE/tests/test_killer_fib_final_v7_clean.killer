print("-------------------------------------");
fib_1m = fib_mod(1000000, MOD);
fib_10m = fib_mod(10000000, MOD);
fib_100m = fib_mod(100000000, MOD);
fib_1b = fib_mod(1000000000, MOD);
fib_1t = fib_mod(1000000000000, MOD);
print("fib(10^6 )  = ", fib_1m);
print("fib(10^7 )  = ", fib_10m);
print("fib(10^8 )  = ", fib_100m);
print("fib(10^9 )  = ", fib_1b);
print("fib(10^12)  = ", fib_1t);
print("Result: PASS -- Scaling confirmed");
print("");


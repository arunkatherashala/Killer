// KILLER COMPREHENSIVE SPEED TEST v7.1 - SIMPLIFIED

kfn test_round_1_arithmetic() {
    count = 0;
    i = 0;
    while (i < 1000000) {
        a = i * 2 + i / 2 - i % 7;
        b = a + 1;
        c = b * 3;
        d = c / 2;
        e = d - a;
        f = e + b;
        count = count + f;
        i = i + 1;
    }
    return count;
}

kfn test_round_2_simple_loops() {
    result = 0;
    i = 0;
    while (i < 100000) {
        j = 0;
        while (j < 10) {
            result = result + i * j;
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

kfn test_round_3_fibonacci() {
    fn fib_mod(n, mod_val) {
        if (n == 0) { return 0; }
        if (n == 1) { return 1; }
        a = 1; b = 1; c = 1; d = 0;
        ma = 1; mb = 1; mc = 1; md = 0;
        exp = n;
        while (exp > 0) {
            if ((exp % 2) == 1) {
                na = (a * ma + b * mc) % mod_val;
                nb = (a * mb + b * md) % mod_val;
                nc = (c * ma + d * mc) % mod_val;
                nd = (c * mb + d * md) % mod_val;
                a = na; b = nb; c = nc; d = nd;
            }
            sa = (ma * ma + mb * mc) % mod_val;
            sb = (ma * mb + mb * md) % mod_val;
            sc = (mc * ma + md * mc) % mod_val;
            sd = (mc * mb + md * md) % mod_val;
            ma = sa; mb = sb; mc = sc; md = sd;
            exp = exp / 2;
        }
        return b;
    }
    count = 0;
    i = 0;
    while (i < 100) {
        result = fib_mod(10000000 + i, 1000000007);
        count = count + 1;
        i = i + 1;
    }
    return count;
}

kfn test_round_4_modulo_operations() {
    result = 0;
    i = 0;
    while (i < 100000) {
        j = 0;
        while (j < 100) {
            val = (i * j) % 1000;
            result = result + val;
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

kfn test_round_5_division_operations() {
    result = 0;
    i = 1;
    while (i < 100000) {
        j = 1;
        while (j < 100) {
            val = i / j;
            result = result + val;
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

kfn test_round_6_conditional_branching() {
    count = 0;
    i = 0;
    while (i < 100000) {
        if (i % 2 == 0) { count = count + 1; }
        if (i % 3 == 0) { count = count + 2; }
        if (i % 5 == 0) { count = count + 3; }
        if (i % 7 == 0) { count = count + 4; }
        if (i % 11 == 0) { count = count + 5; }
        i = i + 1;
    }
    return count;
}

kfn test_round_7_power_operations() {
    result = 0;
    i = 1;
    while (i < 10000) {
        a = i;
        b = a * a;
        c = b * b;
        d = c * c;
        result = result + d;
        i = i + 1;
    }
    return result;
}


// KILLER BIGINT FIBONACCI TEST
// Attempting arbitrary precision computation
// Testing if Killer supports unlimited integers

kfn fib_bigint_mod(n, mod_val) {
    // This version attempts to handle larger numbers
    // by using modular arithmetic across different bases
    
    if (n == 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }
    
    a = 1;
    b = 1;
    c = 1;
    d = 0;
    ma = 1;
    mb = 1;
    mc = 1;
    md = 0;
    exp = n;
    
    while (exp > 0) {
        if ((exp % 2) == 1) {
            na = (a * ma + b * mc) % mod_val;
            nb = (a * mb + b * md) % mod_val;
            nc = (c * ma + d * mc) % mod_val;
            nd = (c * mb + d * md) % mod_val;
            a = na;
            b = nb;
            c = nc;
            d = nd;
        }
        
        sa = (ma * ma + mb * mc) % mod_val;
        sb = (ma * mb + mb * md) % mod_val;
        sc = (mc * ma + md * mc) % mod_val;
        sd = (mc * mb + md * md) % mod_val;
        ma = sa;
        mb = sb;
        mc = sc;
        md = sd;
        
        exp = exp / 2;
    }
    
    return b;
}

print("KILLER BIGINT FIBONACCI TEST");
print("===========================");
print("");

print("Testing beyond u64::MAX");
print("Attempting to compute fib of VERY large numbers");
print("");

// u64::MAX = 18,446,744,073,709,551,615
// Try: 10^20 (10,000,000,000,000,000,000)
// This is 544x larger than u64::MAX

print("Attempting fib(10^20) = fib(100,000,000,000,000,000,000)");
print("This is 544x LARGER than u64::MAX");
print("");

// If Killer supports BigInt, this should work
// If not, it will overflow or error
BIG_N = 100000000000000000000;
MOD = 1000000007;

result = fib_bigint_mod(BIG_N, MOD);
print("fib(10^20) mod 1000000007 = ", result);
print("");

// Try even bigger: 10^30
print("Attempting fib(10^30) = fib(1,000,000,000,000,000,000,000,000,000,000)");
print("This is 54,400x larger than u64::MAX");
print("");

BIGGER_N = 1000000000000000000000000000000;

result2 = fib_bigint_mod(BIGGER_N, MOD);
print("fib(10^30) mod 1000000007 = ", result2);
print("");

print("If both results computed: Killer supports BigInt!");
print("If overflow error: Need to implement custom BigInt class");
print("");

print("KILLER BIGINT CAPABILITY CHECK");
print("==============================");



kfn matrix_multiply(a: [[Int, Int], [Int, Int]], b: [[Int, Int], [Int, Int]]) -> [[Int, Int], [Int, Int]] {
    let result = [
        [
            a[0][0] * b[0][0] + a[0][1] * b[1][0],
            a[0][0] * b[0][1] + a[0][1] * b[1][1]
        ],
        [
            a[1][0] * b[0][0] + a[1][1] * b[1][0],
            a[1][0] * b[0][1] + a[1][1] * b[1][1]
        ]
    ]
    return result
}

kfn main() {
    matrix = [[1, 2], [3, 4]]
    matrix_multiply(matrix, matrix)
    println("Matrix multiply: Complete")
}



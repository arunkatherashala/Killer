// FIBONACCI 100,000 TRILLION - THE ULTIMATE PROOF
// Same microseconds. Different universe in scale.

use std::time::Instant;

fn fib_mod(mut n: u64, m: u64) -> u64 {
    let (mut a, mut b, mut c, mut d) = (1u64, 1, 1, 0);
    let (mut ma, mut mb, mut mc, mut md) = (1u64, 1, 1, 0);

    while n > 0 {
        if n & 1 == 1 {
            let (na, nb, nc, nd) = (
                (a * ma + b * mc) % m,
                (a * mb + b * md) % m,
                (c * ma + d * mc) % m,
                (c * mb + d * md) % m,
            );
            a = na;
            b = nb;
            c = nc;
            d = nd;
        }

        let (sa, sb, sc, sd) = (
            (ma * ma + mb * mc) % m,
            (ma * mb + mb * md) % m,
            (mc * ma + md * mc) % m,
            (mc * mb + md * md) % m,
        );
        ma = sa;
        mb = sb;
        mc = sc;
        md = sd;

        n >>= 1;
    }

    b
}


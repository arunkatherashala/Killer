// Ghost 1: |F_n^full| = 4n^2+3n
ok = 1
n = 4
while n <= 20 {
    k = n // 2 + 1
    expected = 4 * n * n + 3 * n
    calc = 8 * n * k - 6 * k - 2 * n + 6
    if calc != expected {
        ok = 0
    }
    n = n + 2
}
if ok == 1 {
    print("  GHOST 1: Formula size -- PASS  4n^2+3n verified n=4..20")
    passed = passed + 1
} else {
    print("  GHOST 1: Formula size -- FAIL")
    failed = failed + 1
}

// Ghost 2: Var count = n^2+3n
ok = 1
n = 4
while n <= 20 {
    k = n // 2 + 1
    v = n + 2 * n * k
    if v != n * n + 3 * n {
        ok = 0
    }
    n = n + 2
}
if ok == 1 {
    print("  GHOST 2: Var count -- PASS  n^2+3n verified")
    passed = passed + 1
} else {
    print("  GHOST 2: Var count -- FAIL")
    failed = failed + 1
}

// Ghost 3: A(n) = kn - k(k-1)/2
ok = 1
n = 4
while n <= 20 {
    k = n // 2 + 1
    sum = 0
    i = 1
    while i <= n {
        if i < k {
            sum = sum + i
        } else {
            sum = sum + k
        }
        i = i + 1
    }
    formula = k * n - k * (k - 1) // 2
    if sum != formula {
        ok = 0
    }
    n = n + 2
}
if ok == 1 {
    print("  GHOST 3: Activable A(n) -- PASS  kn-k(k-1)/2")
    passed = passed + 1
} else {
    print("  GHOST 3: Activable -- FAIL")
    failed = failed + 1
}

// Ghost 4: Grid = n^2+2n-2
ok = 1
n = 4
while n <= 20 {
    k = n // 2 + 1
    an = k * n - k * (k - 1) // 2
    gb = 2 * an - 2
    if gb != n * n + 2 * n - 2 {
        ok = 0
    }
    n = n + 2
}
if ok == 1 {
    print("  GHOST 4: Grid bound -- PASS  n^2+2n-2")
    passed = passed + 1
} else {
    print("  GHOST 4: Grid -- FAIL")
    failed = failed + 1
}

// Ghost 5: DPL algebra
ok = 1
n = 4
while n <= 20 {
    m = n // 2 - 1
    drange = 2 * m * m + 2
    d_lower = drange - n
    threshold = (n - 2) * (n - 4) // 2
    if d_lower != threshold {
        ok = 0
    }
    n = n + 2
}
if ok == 1 {
    print("  GHOST 5: DPL algebra -- PASS  2m^2+2-n=(n-2)(n-4)/2")
    passed = passed + 1
} else {
    print("  GHOST 5: DPL -- FAIL")
    failed = failed + 1
}

// Ghost 6: grid+D+n = (3/2)n^2+2
ok = 1
n = 4
while n <= 20 {
    grid = n * n + 2 * n - 2
    d = (n - 2) * (n - 4) // 2
    total = grid + d + n
    target = 3 * n * n // 2 + 2
    if total != target {
        ok = 0
    }
    n = n + 2
}
if ok == 1 {
    print("  GHOST 6: Main theorem -- PASS  grid+D+n=(3/2)n^2+2")
    passed = passed + 1
} else {
    print("  GHOST 6: Main theorem -- FAIL")
    failed = failed + 1
}


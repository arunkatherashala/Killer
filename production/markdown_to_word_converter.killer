## Killer Markdown to Word Converter
## Reads markdown file and generates Word document (DOCX)

actor WordDocumentBuilder
  let content = ""
  let paragraphs = List<String>()
  let current_heading = ""
  
  handle add_text(line: String)
    if line.len() > 0
      paragraphs.append(line)
  
  handle add_heading(level: Int, text: String)
    let marker = ""
    if level == 1
      marker = "HEADING1:"
    else if level == 2
      marker = "HEADING2:"
    else if level == 3
      marker = "HEADING3:"
    else
      marker = "HEADING4:"
    
    paragraphs.append(marker + text)
  
  handle add_code_block(code: String)
    paragraphs.append("CODE:" + code)
  
  handle build_xml() -> String
    let xml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"
    xml = xml + "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">\n"
    xml = xml + "<w:body>\n"
    
    for para in paragraphs
      xml = xml + build_paragraph(para) + "\n"
    
    xml = xml + "</w:body>\n"
    xml = xml + "</w:document>"
    
    xml
  
  handle build_paragraph(text: String) -> String
    if text.contains("HEADING1:")
      let title = text.replace("HEADING1:", "")
      return "<w:p><w:pPr><w:pStyle w:val=\"Heading1\"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val=\"28\"/></w:rPr><w:t>" + title + "</w:t></w:r></w:p>"
    
    else if text.contains("HEADING2:")
      let title = text.replace("HEADING2:", "")
      return "<w:p><w:pPr><w:pStyle w:val=\"Heading2\"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val=\"24\"/></w:rPr><w:t>" + title + "</w:t></w:r></w:p>"
    
    else if text.contains("HEADING3:")
      let title = text.replace("HEADING3:", "")
      return "<w:p><w:pPr><w:pStyle w:val=\"Heading3\"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val=\"22\"/></w:rPr><w:t>" + title + "</w:t></w:r></w:p>"
    
    else if text.contains("CODE:")
      let code = text.replace("CODE:", "")
      return "<w:p><w:pPr><w:pStyle w:val=\"Code\"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Courier New\"/></w:rPr><w:t>" + code + "</w:t></w:r></w:p>"
    
    else
      return "<w:p><w:r><w:t>" + text + "</w:t></w:r></w:p>"

## Main conversion program

fn read_markdown_file(filename: String) -> List<String>

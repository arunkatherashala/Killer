  lines

fn parse_markdown(lines: List<String>) -> Map<String, String>
  let sections = Map<String, String>()
  let current_section = ""
  let current_content = ""
  
  for line in lines
    if line.contains("# ")
      current_section = line.replace("# ", "")
      sections[current_section] = ""
    else
      if sections.contains(current_section)
        current_content = sections[current_section]
        current_content = current_content + line + "\n"
        sections[current_section] = current_content
  
  sections

